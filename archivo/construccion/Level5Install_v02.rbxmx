		for index = 0, 9 do piece(arch, anchor, "CandyPost", V(4, 3, 4), side * 40, 1.5 + index * 3, 0, index % 2 == 0 and C.Red or C.White, { noStuds = true }) end
		ball(arch, anchor, "PostTop", 5, side * 40, 32, 0, C.Gold, { material = M.Neon })
	end
	piece(arch, anchor, "Beam", V(84, 2, 2), 0, 28, 0, C.Green, { noStuds = true })
	boardWithText(arch, "FinishBoard", V(40, 11, 0.8), anchor * CFrame.new(0, 34, 0), C.Green, "¡META!", C.White, rgb(0x0a3a1a))
	bulbLine(arch, (anchor * CFrame.new(-38, 26.5, -1.2)).Position, (anchor * CFrame.new(38, 26.5, -1.2)).Position, 2.4, 0)
	local finishLine = box(gameplayFolder, "FinishLine", V(HALF * 2, 0.3, 2.4), 0, 0.2, FINISH_ZM, C.White, { material = M.Neon, noCollide = true, noQuery = true })
	CollectionService:AddTag(finishLine, "FinishLine")
	christmasTree(decorationFolder, at(0, 0, Z_END - 20), 5)
	giftPile(decorationFolder, at(0, 0, Z_END - 20), 20, 34)
