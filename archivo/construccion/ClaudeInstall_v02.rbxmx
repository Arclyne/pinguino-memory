local CollectionService = game:GetService("CollectionService")

local ACCESSORY_FOLDER_NAME = "SkinAccessories"
local SKIN_ATTRIBUTE = "SkinId"
local FLAME_TAG = "FlickeringFlame"
local CHASE_TAG = "ChaseBulb"
local PULSE_TAG = "PulseGlow"
local RECOLORABLE_PARTS = { "Flipper_L", "Flipper_R", "Foot_L", "Foot_R", "Beak", "Tail" }

local rgb = Color3.fromRGB
local BULB_COLORS = { rgb(255, 59, 92), rgb(255, 210, 63), rgb(63, 208, 255), rgb(125, 255, 122), rgb(255, 122, 224) }

type Rig = {
	character: Model,
	body: BasePart,
	leftFlipper: BasePart,
	rightFlipper: BasePart,
	folder: Folder,
}

type PartOptions = {
	material: Enum.Material?,
	transparency: number?,
	shape: Enum.PartType?,
	reflectance: number?,
}

local SkinAppearance = {}

SkinAppearance.Attribute = SKIN_ATTRIBUTE

local function makePart(name: string, size: Vector3, color: Color3, options: PartOptions?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = if options and options.material then options.material else Enum.Material.SmoothPlastic
	part.Transparency = if options and options.transparency then options.transparency else 0
	part.Reflectance = if options and options.reflectance then options.reflectance else 0
	if options and options.shape then
		part.Shape = options.shape
	end
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

local function attach(rig: Rig, anchor: BasePart, part: BasePart, offset: CFrame): BasePart
	part.CFrame = anchor.CFrame * offset
	local weld = Instance.new("Weld")
	weld.Part0 = anchor
	weld.Part1 = part
	weld.C0 = offset
	weld.Parent = part
	part.Parent = rig.folder
	return part
end

local function onBody(rig: Rig, name: string, size: Vector3, color: Color3, offset: CFrame, options: PartOptions?): BasePart
	return attach(rig, rig.body, makePart(name, size, color, options), offset)
end

local function neon(rig: Rig, anchor: BasePart, name: string, size: Vector3, color: Color3, offset: CFrame, shape: Enum.PartType?): BasePart
	return attach(rig, anchor, makePart(name, size, color, { material = Enum.Material.Neon, shape = shape }), offset)
end

local function light(part: BasePart, color: Color3, brightness: number, range: number)
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Brightness = brightness
	pointLight.Range = range
	pointLight.Shadows = false
	pointLight.Parent = part
end

local function emitter(part: BasePart, colors: ColorSequence, settings: { rate: number, size: number, lifetime: number, speed: number, rise: number, spread: number })
	local particles = Instance.new("ParticleEmitter")
	particles.Color = colors
	particles.LightEmission = 1
	particles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, settings.size), NumberSequenceKeypoint.new(1, 0) })
	particles.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.4) })
	particles.Lifetime = NumberRange.new(settings.lifetime * 0.7, settings.lifetime)
	particles.Rate = settings.rate
	particles.Speed = NumberRange.new(settings.speed * 0.5, settings.speed)
	particles.SpreadAngle = Vector2.new(settings.spread, settings.spread)
	particles.Acceleration = Vector3.new(0, settings.rise, 0)
	particles.EmissionDirection = Enum.NormalId.Top
	particles.Shape = Enum.ParticleEmitterShape.Box
	particles.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	particles.LockedToPart = false
	particles.Parent = part
end

local function emitterZone(rig: Rig, name: string, size: Vector3, offset: CFrame): BasePart
	local zone = makePart(name, size, Color3.new(1, 1, 1), { transparency = 1 })
	return attach(rig, rig.body, zone, offset)
end

local function auraDisc(rig: Rig, color: Color3, ringColor: Color3)
	local floor = CFrame.new(0, -1.66, 0) * CFrame.Angles(0, 0, math.pi / 2)
	onBody(rig, "AuraDisc", Vector3.new(0.06, 4.2, 4.2), color, floor, { material = Enum.Material.Neon, transparency = 0.6, shape = Enum.PartType.Cylinder })
	onBody(rig, "AuraRing", Vector3.new(0.08, 4.6, 4.6), ringColor, floor * CFrame.new(-0.01, 0, 0), { material = Enum.Material.Neon, transparency = 0.25, shape = Enum.PartType.Cylinder })
	onBody(rig, "AuraHole", Vector3.new(0.09, 4.2, 4.2), color, floor * CFrame.new(-0.02, 0, 0), { material = Enum.Material.Neon, transparency = 0.7, shape = Enum.PartType.Cylinder })
end

local function rememberBase(part: BasePart)
	if part:GetAttribute("SkinBaseColor") == nil then
		part:SetAttribute("SkinBaseColor", part.Color)
		part:SetAttribute("SkinBaseMaterial", part.Material.Name)
		part:SetAttribute("SkinBaseTransparency", part.Transparency)
	end
end

local function restoreBase(character: Model)
	for _, name in RECOLORABLE_PARTS do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			local baseColor = part:GetAttribute("SkinBaseColor")
			local baseMaterial = part:GetAttribute("SkinBaseMaterial")
			local baseTransparency = part:GetAttribute("SkinBaseTransparency")
			if typeof(baseColor) == "Color3" then
				part.Color = baseColor
			end
			if typeof(baseMaterial) == "string" then
				part.Material = (Enum.Material :: any)[baseMaterial]
			end
			if typeof(baseTransparency) == "number" then
				part.Transparency = baseTransparency
			end
		end
	end
end

local function recolor(character: Model, color: Color3, material: Enum.Material, transparency: number)
	for _, name in RECOLORABLE_PARTS do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			rememberBase(part)
			part.Color = color
			part.Material = material
			part.Transparency = transparency
		end
	end
end

local function buildFire(rig: Rig)
	local flames = {
		{ 0, 0.1, 0.95, 1.7, rgb(212, 26, 0) },
		{ 0.42, 0.32, 0.7, 1.25, rgb(240, 60, 0) },
		{ -0.42, 0.32, 0.7, 1.25, rgb(240, 60, 0) },
		{ 0, 0.62, 0.62, 1.1, rgb(224, 40, 0) },
		{ 0.22, -0.18, 0.5, 1.05, rgb(255, 122, 0) },
		{ -0.22, -0.18, 0.5, 0.95, rgb(255, 160, 0) },
		{ 0, 0, 0.36, 0.85, rgb(255, 210, 63) },
	}
	local crestBase: BasePart? = nil
	for index, flame in flames do
		local x, z, width, height, color = flame[1] :: number, flame[2] :: number, flame[3] :: number, flame[4] :: number, flame[5] :: Color3
		local part = neon(rig, rig.body, "Flame", Vector3.new(width, height, width), color, CFrame.new(x, 1.28 + height / 2, z) * CFrame.Angles(0, math.pi / 4, 0))
		CollectionService:AddTag(part, FLAME_TAG)
		if index == 1 then
			crestBase = part
		end
	end
	for _, side in { -1, 1 } do
		onBody(rig, "Brow", Vector3.new(0.5, 0.12, 0.08), rgb(26, 10, 6), CFrame.new(side * 0.36, 0.86, -1.12) * CFrame.Angles(0, 0, side * -0.38))
		for index, crack in { { -0.5, 0.35 }, { 0.05, -0.35 }, { -0.95, -0.1 } } do
			neon(rig, rig.body, "LavaCrack", Vector3.new(0.06, 0.55 - index * 0.08, 0.14), rgb(255, 74, 0), CFrame.new(side * 1.17, crack[1], crack[2]) * CFrame.Angles(0.45 * (index - 2), 0, 0))
		end
		local flipper = if side < 0 then rig.leftFlipper else rig.rightFlipper
		local tip = neon(rig, flipper, "FlipperFlame", Vector3.new(0.32, 0.55, 0.32), rgb(255, 90, 0), CFrame.new(0, -0.82, 0) * CFrame.Angles(0, math.pi / 4, 0))
		CollectionService:AddTag(tip, FLAME_TAG)
	end
	neon(rig, rig.body, "MagmaScarf", Vector3.new(2.5, 0.32, 2.24), rgb(255, 72, 0), CFrame.new(0, 0.06, 0))
	neon(rig, rig.body, "MagmaScarfTail", Vector3.new(0.42, 0.95, 0.12), rgb(255, 120, 0), CFrame.new(0.62, -0.42, -1.14))
	for index = 0, 9 do
		local angle = index / 10 * math.pi * 2
		local height = 0.5 + (index % 3) * 0.22
		local color = ({ rgb(212, 26, 0), rgb(255, 90, 0), rgb(255, 160, 0) })[index % 3 + 1]
		local ringFlame = neon(rig, rig.body, "RingFlame", Vector3.new(0.3, height, 0.3), color, CFrame.new(math.cos(angle) * 2, -1.68 + height / 2, math.sin(angle) * 2) * CFrame.Angles(0, math.pi / 4, 0))
		CollectionService:AddTag(ringFlame, FLAME_TAG)
	end
	auraDisc(rig, rgb(255, 90, 0), rgb(255, 179, 0))
	if crestBase then
		light(crestBase, rgb(255, 120, 30), 1.6, 12)
		emitter(crestBase, ColorSequence.new(rgb(255, 210, 63), rgb(255, 61, 0)), { rate = 30, size = 0.35, lifetime = 1.2, speed = 3, rise = 4, spread = 25 })
	end
	local embers = emitterZone(rig, "EmberZone", Vector3.new(3.6, 0.1, 3.6), CFrame.new(0, -1.6, 0))
	emitter(embers, ColorSequence.new(rgb(255, 138, 0), rgb(255, 61, 0)), { rate = 18, size = 0.22, lifetime = 1.8, speed = 2.5, rise = 3, spread = 10 })
end

local function buildIce(rig: Rig)
	local iceBlue = rgb(120, 205, 255)
	local shell = onBody(rig, "IceShell", Vector3.new(2.75, 3.15, 2.45), rgb(175, 232, 255), CFrame.new(0, 0, -0.02), { material = Enum.Material.Glass, transparency = 0.5, reflectance = 0.15 })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = shell
	recolor(rig.character, iceBlue, Enum.Material.Glass, 0.15)
	local crystals = {
		{ 0, 0, 0.32, 1.55, 0 },
		{ 0.42, 0.1, 0.24, 1.15, -0.35 },
		{ -0.42, 0.1, 0.24, 1.15, 0.35 },
		{ 0.22, 0.45, 0.22, 0.95, -0.2 },
		{ -0.22, 0.45, 0.22, 0.95, 0.2 },
		{ 0.62, -0.2, 0.2, 0.8, -0.6 },
		{ -0.62, -0.2, 0.2, 0.8, 0.6 },
	}
	for index, crystal in crystals do
		local x, z, width, height, tilt = crystal[1], crystal[2], crystal[3], crystal[4], crystal[5]
		local color = if index % 2 == 0 then rgb(230, 250, 255) else rgb(169, 233, 255)
		local part = neon(rig, rig.body, "Crystal", Vector3.new(width, height, width), color, CFrame.new(x - math.sin(tilt) * height / 2, 1.3 + math.cos(tilt) * height / 2, z) * CFrame.Angles(0, math.pi / 4, tilt))
		part.Transparency = 0.15
		CollectionService:AddTag(part, PULSE_TAG)
	end
	for index = 0, 3 do
		local height = 0.6 + (index % 2) * 0.35
		local spike = neon(rig, rig.body, "BackSpike", Vector3.new(0.22, height, 0.22), rgb(216, 246, 255), CFrame.new(-0.45 + index * 0.3, 0.4 + height / 2, 1.0) * CFrame.Angles(0.5, math.pi / 4, 0))
		spike.Transparency = 0.2
	end
	for index = 0, 2 do
		neon(rig, rig.body, "Icicle", Vector3.new(0.12, 0.32 + (index % 2) * 0.15, 0.12), rgb(238, 252, 255), CFrame.new(-0.18 + index * 0.18, 0.08, -1.24))
	end
	local hexFloor = CFrame.new(0, -1.66, 0) * CFrame.Angles(0, 0, math.pi / 2)
	onBody(rig, "FrostDisc", Vector3.new(0.06, 4.2, 4.2), rgb(191, 243, 255), hexFloor, { material = Enum.Material.Neon, transparency = 0.55, shape = Enum.PartType.Cylinder })
	onBody(rig, "FrostRing", Vector3.new(0.08, 4.6, 4.6), rgb(155, 123, 255), hexFloor * CFrame.new(-0.01, 0, 0), { material = Enum.Material.Neon, transparency = 0.3, shape = Enum.PartType.Cylinder })
	light(shell, rgb(111, 211, 255), 1.4, 12)
	local sparkles = emitterZone(rig, "SparkleZone", Vector3.new(3.4, 3.4, 3.4), CFrame.new(0, 0.4, 0))
	emitter(sparkles, ColorSequence.new(rgb(255, 255, 255), rgb(150, 220, 255)), { rate = 16, size = 0.3, lifetime = 1.6, speed = 0.6, rise = 1.2, spread = 180 })
end

local function buildSanta(rig: Rig)
	local red = rgb(216, 48, 42)
	local white = rgb(248, 250, 252)
	onBody(rig, "HatBrim", Vector3.new(2.45, 0.45, 2.3), white, CFrame.new(0, 1.42, 0.02), { material = Enum.Material.Fabric })
	local segments = { { 2.0, 0.8, 0, 1.95, 0 }, { 1.5, 0.7, 0.12, 2.55, -0.12 }, { 1.0, 0.6, 0.34, 3.02, -0.3 }, { 0.62, 0.5, 0.62, 3.36, -0.5 } }
	for _, segment in segments do
		local width, height, x, y, tilt = segment[1], segment[2], segment[3], segment[4], segment[5]
		onBody(rig, "HatCone", Vector3.new(width, height, width * 0.95), red, CFrame.new(x, y, 0.05) * CFrame.Angles(0, 0, tilt), { material = Enum.Material.Fabric })
	end
	onBody(rig, "Pompom", Vector3.new(0.6, 0.6, 0.6), white, CFrame.new(0.92, 3.5, 0.05), { shape = Enum.PartType.Ball, material = Enum.Material.Fabric })
	local star = neon(rig, rig.body, "PompomStar", Vector3.new(0.22, 0.22, 0.22), rgb(255, 210, 63), CFrame.new(0.92, 3.86, 0.05), Enum.PartType.Ball)
	CollectionService:AddTag(star, PULSE_TAG)
	onBody(rig, "Beard", Vector3.new(1.7, 0.7, 0.5), white, CFrame.new(0, -0.02, -1.12), { material = Enum.Material.Fabric })
	onBody(rig, "BeardMid", Vector3.new(1.2, 0.5, 0.45), white, CFrame.new(0, -0.5, -1.08), { material = Enum.Material.Fabric })
	onBody(rig, "BeardTip", Vector3.new(0.6, 0.35, 0.4), white, CFrame.new(0, -0.84, -1.02), { material = Enum.Material.Fabric })
	for _, side in { -1, 1 } do
		onBody(rig, "Mustache", Vector3.new(0.55, 0.2, 0.2), white, CFrame.new(side * 0.28, 0.2, -1.27) * CFrame.Angles(0, 0, side * 0.25), { material = Enum.Material.Fabric })
	end
	onBody(rig, "Belt", Vector3.new(2.5, 0.3, 2.24), rgb(30, 30, 30), CFrame.new(0, -0.62, 0))
	onBody(rig, "Buckle", Vector3.new(0.55, 0.42, 0.1), rgb(255, 210, 63), CFrame.new(0, -0.62, -1.13), { material = Enum.Material.Metal, reflectance = 0.2 })
	local gift = attach(rig, rig.leftFlipper, makePart("Gift", Vector3.new(0.75, 0.75, 0.75), rgb(46, 155, 74)), CFrame.new(-0.25, -0.8, -0.35))
	attach(rig, gift, makePart("GiftRibbon", Vector3.new(0.78, 0.78, 0.16), red), CFrame.identity)
	attach(rig, gift, makePart("GiftRibbon", Vector3.new(0.16, 0.78, 0.78), red), CFrame.identity)
	attach(rig, gift, makePart("GiftBow", Vector3.new(0.4, 0.22, 0.14), rgb(255, 210, 63), { material = Enum.Material.Neon }), CFrame.new(0, 0.48, 0) * CFrame.Angles(0, 0, 0.6))
	light(star, rgb(255, 214, 120), 1, 8)
	local snow = emitterZone(rig, "SnowZone", Vector3.new(4, 0.1, 4), CFrame.new(0, 4.2, 0))
	local snowEmitter = Instance.new("ParticleEmitter")
	snowEmitter.Color = ColorSequence.new(rgb(255, 255, 255), rgb(255, 226, 138))
	snowEmitter.LightEmission = 0.6
	snowEmitter.Size = NumberSequence.new(0.18)
	snowEmitter.Lifetime = NumberRange.new(2, 3)
	snowEmitter.Rate = 14
	snowEmitter.Speed = NumberRange.new(1, 2)
	snowEmitter.EmissionDirection = Enum.NormalId.Bottom
	snowEmitter.Shape = Enum.ParticleEmitterShape.Box
	snowEmitter.Parent = snow
	auraDisc(rig, rgb(255, 59, 59), rgb(47, 211, 90))
end

local function buildReindeer(rig: Rig)
	local brown = rgb(138, 85, 48)
	local antler = rgb(200, 154, 90)
	onBody(rig, "Headband", Vector3.new(2.2, 0.32, 2.0), brown, CFrame.new(0, 1.4, 0.05), { material = Enum.Material.Fabric })
	local bulbIndex = 0
	local function bulb(position: CFrame)
		bulbIndex += 1
		local part = neon(rig, rig.body, "AntlerBulb", Vector3.new(0.2, 0.2, 0.2), BULB_COLORS[bulbIndex % #BULB_COLORS + 1], position, Enum.PartType.Ball)
		part:SetAttribute("ChaseIndex", bulbIndex)
		CollectionService:AddTag(part, CHASE_TAG)
	end
	for _, side in { -1, 1 } do
		onBody(rig, "Antler", Vector3.new(0.18, 1.15, 0.18), antler, CFrame.new(side * 0.6, 2.0, 0.1) * CFrame.Angles(0, 0, -side * 0.35))
		onBody(rig, "AntlerBranch", Vector3.new(0.15, 0.6, 0.15), antler, CFrame.new(side * 0.95, 2.1, 0.1) * CFrame.Angles(0, 0, -side * 1.0))
		onBody(rig, "AntlerBranch", Vector3.new(0.15, 0.5, 0.15), antler, CFrame.new(side * 0.78, 2.55, 0.05) * CFrame.Angles(0, 0, -side * 0.85))
		onBody(rig, "AntlerBranch", Vector3.new(0.15, 0.45, 0.15), antler, CFrame.new(side * 0.38, 2.4, 0.1) * CFrame.Angles(0, 0, side * 0.6))
		bulb(CFrame.new(side * 0.95, 2.62, 0.1))
		bulb(CFrame.new(side * 1.2, 2.3, 0.1))
		bulb(CFrame.new(side * 0.88, 2.82, 0.05))
		bulb(CFrame.new(side * 0.25, 2.62, 0.1))
		onBody(rig, "Ear", Vector3.new(0.5, 0.24, 0.16), brown, CFrame.new(side * 1.02, 1.22, 0.1) * CFrame.Angles(0, 0, side * 0.5), { material = Enum.Material.Fabric })
		onBody(rig, "EarInner", Vector3.new(0.3, 0.14, 0.17), rgb(240, 185, 160), CFrame.new(side * 1.04, 1.21, 0.09) * CFrame.Angles(0, 0, side * 0.5))
	end
	local nose = neon(rig, rig.body, "RedNose", Vector3.new(0.34, 0.34, 0.34), rgb(255, 26, 26), CFrame.new(0, 0.33, -1.38), Enum.PartType.Ball)
	CollectionService:AddTag(nose, PULSE_TAG)
	light(nose, rgb(255, 40, 40), 2.2, 8)
	onBody(rig, "Collar", Vector3.new(2.5, 0.28, 2.24), rgb(198, 40, 40), CFrame.new(0, 0.05, 0))
	for index, x in { -0.45, 0, 0.45 } do
		onBody(rig, "Bell", Vector3.new(0.24, 0.24, 0.24), rgb(255, 210, 63), CFrame.new(x, -0.16 - (if index == 2 then 0.04 else 0), -1.15), { shape = Enum.PartType.Ball, material = Enum.Material.Metal, reflectance = 0.25 })
	end
	for index = 0, 11 do
		local angle = index / 12 * math.pi * 2
		bulb(CFrame.new(math.cos(angle) * 1.2, -1.15 + index / 12 * 0.95, math.sin(angle) * 1.06))
	end
	auraDisc(rig, rgb(255, 42, 42), rgb(255, 210, 63))
	local sparkles = emitterZone(rig, "SparkleZone", Vector3.new(3.2, 3.2, 3.2), CFrame.new(0, 0.6, 0))
	emitter(sparkles, ColorSequence.new(rgb(255, 59, 59), rgb(255, 210, 63)), { rate = 12, size = 0.25, lifetime = 1.6, speed = 0.6, rise = 1.4, spread = 180 })
end

local builders: { [string]: (Rig) -> () } = {
	fire = buildFire,
	ice = buildIce,
	santa = buildSanta,
	reindeer = buildReindeer,
}

function SkinAppearance.clear(character: Model)
	local folder = character:FindFirstChild(ACCESSORY_FOLDER_NAME)
	if folder then
		folder:Destroy()
	end
	restoreBase(character)
end

function SkinAppearance.apply(character: Model, skinId: string): boolean
	local body = character:FindFirstChild("Body")
	local leftFlipper = character:FindFirstChild("Flipper_L")
	local rightFlipper = character:FindFirstChild("Flipper_R")
	if not (body and body:IsA("BasePart") and leftFlipper and leftFlipper:IsA("BasePart") and rightFlipper and rightFlipper:IsA("BasePart")) then
		return false
	end
	SkinAppearance.clear(character)
	character:SetAttribute(SKIN_ATTRIBUTE, skinId)
	local build = builders[skinId]
	if not build then
		return true
	end
	local folder = Instance.new("Folder")
	folder.Name = ACCESSORY_FOLDER_NAME
	build({ character = character, body = body, leftFlipper = leftFlipper, rightFlipper = rightFlipper, folder = folder })
	folder.Parent = character
	return true
end

return SkinAppearance
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">SkinCatalog</string><ProtectedString name="Source"><![CDATA[--!strict
export type Skin = {
	id: string,
	name: string,
	rarity: string,
	price: number,
	order: number,
	accent: Color3,
	glow: Color3,
	description: string,
}

local DEFAULT_SKIN = "classic"

local skins: { Skin } = {
	{
		id = "classic",
		name = "Pingüino Clásico",
		rarity = "COMÚN",
		price = 0,
		order = 1,
		accent = Color3.fromRGB(91, 107, 128),
		glow = Color3.fromRGB(143, 163, 189),
		description = "El pingüino de siempre.",
	},
	{
		id = "fire",
		name = "Pingüino Inferno",
		rarity = "MÍTICO",
		price = 2500,
		order = 2,
		accent = Color3.fromRGB(255, 61, 0),
		glow = Color3.fromRGB(255, 179, 0),
		description = "Cresta de fuego, bufanda de magma, grietas de lava y un anillo de fuego a sus pies.",
	},
	{
		id = "ice",
		name = "Pingüino Glacial",
		rarity = "LEGENDARIO",
		price = 1800,
		order = 3,
		accent = Color3.fromRGB(0, 198, 255),
		glow = Color3.fromRGB(123, 92, 255),
		description = "Congelado en hielo puro, con corona de cristales y destellos de escarcha.",
	},
	{
		id = "santa",
		name = "Pingüino Santa",
		rarity = "ÉPICO",
		price = 999,
		order = 4,
		accent = Color3.fromRGB(229, 57, 53),
		glow = Color3.fromRGB(67, 160, 71),
		description = "Gorro de Santa, barba esponjosa, cinturón dorado y un regalo bajo la aleta.",
	},
	{
		id = "reindeer",
		name = "Pingüino Reno",
		rarity = "ÉPICO",
		price = 999,
		order = 5,
		accent = Color3.fromRGB(141, 90, 43),
		glow = Color3.fromRGB(255, 42, 42),
		description = "Diadema de reno con foquitos, nariz roja que brilla y cascabeles.",
	},
}

local skinsById: { [string]: Skin } = {}
for _, skin in skins do
	skinsById[skin.id] = skin
end

local SkinCatalog = {}

SkinCatalog.DefaultSkin = DEFAULT_SKIN

function SkinCatalog.list(): { Skin }
	return skins
end

function SkinCatalog.get(skinId: string): Skin?
	return skinsById[skinId]
end

function SkinCatalog.isValid(skinId: any): boolean
	return typeof(skinId) == "string" and skinsById[skinId] ~= nil
end

return SkinCatalog
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">WheelCatalog</string><ProtectedString name="Source"><![CDATA[--!strict
export type Prize = {
	label: string,
	icon: string,
	kind: string,
	amount: number,
	weight: number,
	color: Color3,
	title: string,
}

local rgb = Color3.fromRGB

local prizes: { Prize } = {
	{ label = "100", icon = "🐟", kind = "fish", amount = 100, weight = 18, color = rgb(47, 184, 255), title = "100 peces" },
	{ label = "COFRE", icon = "🎁", kind = "chest", amount = 0, weight = 8, color = rgb(255, 138, 31), title = "Cofre Épico" },
	{ label = "250", icon = "🐟", kind = "fish", amount = 250, weight = 15, color = rgb(255, 207, 31), title = "250 peces" },
	{ label = "x2", icon = "⚡", kind = "boost", amount = 15, weight = 8, color = rgb(54, 216, 96), title = "x2 peces por 15 min" },
	{ label = "500", icon = "🐟", kind = "fish", amount = 500, weight = 10, color = rgb(255, 79, 163), title = "500 peces" },
	{ label = "+1", icon = "🎡", kind = "spin", amount = 1, weight = 8, color = rgb(143, 92, 255), title = "Giro extra" },
	{ label = "150", icon = "🐟", kind = "fish", amount = 150, weight = 15, color = rgb(47, 184, 255), title = "150 peces" },
	{ label = "SKIN", icon = "🔥", kind = "skin", amount = 0, weight = 2, color = rgb(255, 59, 48), title = "Pingüino Inferno" },
	{ label = "750", icon = "🐟", kind = "fish", amount = 750, weight = 6, color = rgb(255, 207, 31), title = "750 peces" },
	{ label = "COFRE", icon = "🎁", kind = "chest", amount = 0, weight = 5, color = rgb(255, 138, 31), title = "Cofre Épico" },
	{ label = "1,000", icon = "🐟", kind = "fish", amount = 1000, weight = 4, color = rgb(255, 79, 163), title = "1,000 peces" },
	{ label = "10K", icon = "💎", kind = "fish", amount = 10000, weight = 1, color = rgb(26, 20, 64), title = "¡JACKPOT! 10,000 peces" },
}

local WheelCatalog = {}

WheelCatalog.SkinPrize = "fire"
WheelCatalog.ChestRange = { min = 300, max = 1500 }
WheelCatalog.SkinDuplicateFish = 2500

function WheelCatalog.list(): { Prize }
	return prizes
end

function WheelCatalog.count(): number
	return #prizes
end

function WheelCatalog.totalWeight(): number
	local total = 0
	for _, prize in prizes do
		total += prize.weight
	end
	return total
end

function WheelCatalog.chance(index: number): number
	return prizes[index].weight / WheelCatalog.totalWeight()
end

function WheelCatalog.pick(roll: number): number
	local remaining = roll * WheelCatalog.totalWeight()
	for index, prize in prizes do
		remaining -= prize.weight
		if remaining <= 0 then
			return index
		end
	end
	return #prizes
end

return WheelCatalog
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX16"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">FishService</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)
local LevelRegistry = require(Shared.LevelRegistry)
local RunState = require(Shared.RunState)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local ProfileService = require(script.Parent.ProfileService)
local RunStateService = require(script.Parent.RunStateService)

local PICKUP_TAG = "FishPickup"
local FOLDER_NAME = "FishPickups"
local PROBE_HEIGHT = 260
local PROBE_DEPTH = 4000
local FISH_COLOR = Color3.fromRGB(47, 184, 255)
local FIN_COLOR = Color3.fromRGB(22, 128, 214)

local fishConfig = EconomyConfig.Fish
local collectLimiter = RateLimiter.new(25)

type Pickup = {
	position: Vector3,
	levelId: number,
}

local pickups: { [number]: Pickup } = {}
local collectedByPlayer: { [Player]: { [number]: boolean } } = {}

local FishService = {}

local function isBlocked(instance: Instance): boolean
	if CollectionService:HasTag(instance, "Hazard") then
		return true
	end
	local current: Instance? = instance.Parent
	while current and current ~= workspace do
		if string.find(current.Name, "Obstacle") then
			return true
		end
		current = current.Parent
	end
	return false
end

local function groundAt(position: Vector3, params: RaycastParams): Vector3?
	local hit = workspace:Raycast(position + Vector3.new(0, PROBE_HEIGHT, 0), Vector3.new(0, -PROBE_DEPTH, 0), params)
	if not hit or hit.Normal.Y < 0.55 or isBlocked(hit.Instance) then
		return nil
	end
	return hit.Position
end

local function buildFish(folder: Folder, id: number, position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "FishPickup"
	local function piece(name: string, size: Vector3, color: Color3, offset: CFrame, className: string?): BasePart
		local part = Instance.new(className or "Part") :: BasePart
		part.Name = name
		part.Size = size
		part.Color = color
		part.Material = Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.CFrame = CFrame.new(position) * offset
		part.Parent = model
		return part
	end
	local body = piece("Body", Vector3.new(2.4, 1.2, 0.55), FISH_COLOR, CFrame.identity)
	piece("Tail", Vector3.new(0.55, 1.4, 1.1), FIN_COLOR, CFrame.new(-1.45, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), "WedgePart")
	piece("Eye", Vector3.new(0.26, 0.26, 0.6), Color3.fromRGB(20, 24, 42), CFrame.new(0.7, 0.22, 0))
	model.PrimaryPart = body
	model:SetAttribute("PickupId", id)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	CollectionService:AddTag(model, PICKUP_TAG)
	model.Parent = folder
	return model
end

local function scatterLevel(folder: Folder, levelId: number, nextId: number, params: RaycastParams): number
	local slingshot = LevelRegistry.firstTagged("Slingshot", levelId)
	local finishLine = LevelRegistry.firstTagged("FinishLine", levelId)
	if not (slingshot and slingshot:IsA("Model") and finishLine and finishLine:IsA("BasePart")) then
		return nextId
	end
	local start = slingshot:GetPivot().Position
	local startZ = start.Z - fishConfig.StartAhead
	local endZ = finishLine.Position.Z + fishConfig.EndBeforeFinish
	local random = Random.new(levelId * 7919)
	local lanes = fishConfig.Lanes
	local z = startZ
	while z > endZ do
		local laneIndex = random:NextInteger(1, #lanes)
		for attempt = 0, #lanes - 1 do
			local lane = lanes[(laneIndex + attempt - 1) % #lanes + 1]
			local placed = 0
			local positions = {}
			for index = 0, fishConfig.FishPerGroup - 1 do
				local ground = groundAt(Vector3.new(start.X + lane, start.Y, z - index * fishConfig.FishSpacing), params)
				if ground then
					table.insert(positions, ground + Vector3.new(0, fishConfig.HoverHeight, 0))
				end
			end
			if #positions >= fishConfig.FishPerGroup - 1 then
				for _, position in positions do
					buildFish(folder, nextId, position)
					pickups[nextId] = { position = position, levelId = levelId }
					nextId += 1
					placed += 1
				end
			end
			if placed > 0 then
				break
			end
		end
		z -= fishConfig.GroupSpacing
	end
	return nextId
end

local function scatterAll()
	local existing = workspace:FindFirstChild(FOLDER_NAME)
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = workspace
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	params.RespectCanCollide = true
	local levels: { [number]: boolean } = {}
	for _, finishLine in CollectionService:GetTagged("FinishLine") do
		levels[LevelRegistry.levelOf(finishLine)] = true
	end
	local nextId = 1
	for levelId in levels do
		nextId = scatterLevel(folder, levelId, nextId, params)
	end
end

local function onCollectRequested(player: Player, pickupId: any)
	if typeof(pickupId) ~= "number" or not collectLimiter:allow(player) then
		return
	end
	local pickup = pickups[pickupId]
	if not pickup or RunStateService.get(player) ~= RunState.Racing then
		return
	end
	local collected = collectedByPlayer[player]
	if not collected or collected[pickupId] then
		return
	end
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not (rootPart and rootPart:IsA("BasePart")) then
		return
	end
	if (rootPart.Position - pickup.position).Magnitude > fishConfig.ValidationRadius then
		return
	end
	collected[pickupId] = true
	local profile = ProfileService.get(player)
	local multiplier = if profile and profile.boostUntil > os.time() then EconomyConfig.Boost.Multiplier else 1
	ProfileService.addFish(player, fishConfig.ValuePerPickup * multiplier)
end

function FishService.init()
	scatterAll()
	EconomyRemotes.FishCollectRequested.OnServerEvent:Connect(onCollectRequested)
	RunStateService.Changed:Connect(function(player: Player, newState: string)
		if newState == RunState.Aiming or newState == RunState.Racing and collectedByPlayer[player] == nil then
			collectedByPlayer[player] = {}
		end
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(player: Player)
		collectedByPlayer[player] = nil
	end)
end

return FishService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)
local SkinCatalog = require(Shared.SkinCatalog)

local ProfileService = require(script.Parent.ProfileService)

local TIME_LEVEL_KEY = "1"
local MILLISECONDS = 1000

type Row = { name: string, value: number, skin: string, userId: number }
type Category = { key: string, ascending: boolean, read: (ProfileService.Profile) -> number?, storeName: () -> string }

local leaderboardConfig = EconomyConfig.Leaderboard

local categories: { Category } = {
	{
		key = "fish",
		ascending = false,
		read = function(profile)
			return if profile.weekFish > 0 then profile.weekFish else nil
		end,
		storeName = function()
			return "LB_fish_w" .. ProfileService.currentWeek()
		end,
	},
	{
		key = "runs",
		ascending = false,
		read = function(profile)
			return if profile.weekRuns > 0 then profile.weekRuns else nil
		end,
		storeName = function()
			return "LB_runs_w" .. ProfileService.currentWeek()
		end,
	},
	{
		key = "time",
		ascending = true,
		read = function(profile)
			local best = profile.bestTimes[TIME_LEVEL_KEY]
			return if best then math.floor(best * MILLISECONDS) else nil
		end,
		storeName = function()
			return "LB_time_level1"
		end,
	},
}

local namesByUserId: { [number]: string } = {}
local latest: { [string]: any } = { categories = {}, resetsAt = 0, serverTime = 0 }

local LeaderboardService = {}

local function nameOf(userId: number): string
	local cached = namesByUserId[userId]
	if cached then
		return cached
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local resolved = if ok and typeof(name) == "string" then name else ("Jugador %d"):format(userId)
	namesByUserId[userId] = resolved
	return resolved
end

local function onlineSkin(userId: number): string
	local player = Players:GetPlayerByUserId(userId)
	local profile = player and ProfileService.get(player)
	return if profile then profile.equippedSkin else SkinCatalog.DefaultSkin
end

local function writeOnline(category: Category, store: OrderedDataStore?)
	for _, player in Players:GetPlayers() do
		local profile = ProfileService.get(player)
		local value = profile and category.read(profile)
		if store and value then
			pcall(function()
				store:SetAsync(tostring(player.UserId), value)
			end)
		end
	end
end

local function rowsFromStore(category: Category, store: OrderedDataStore): { Row }?
	local ok, pages = pcall(function()
		return store:GetSortedAsync(category.ascending, leaderboardConfig.Size)
	end)
	if not ok then
		return nil
	end
	local rows: { Row } = {}
	for _, entry in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(entry.key) or 0
		table.insert(rows, { name = nameOf(userId), value = entry.value, skin = onlineSkin(userId), userId = userId })
	end
	return rows
end

local function rowsFromOnline(category: Category): { Row }
	local rows: { Row } = {}
	for _, player in Players:GetPlayers() do
		local profile = ProfileService.get(player)
		local value = profile and category.read(profile)
		if profile and value then
			table.insert(rows, { name = player.Name, value = value, skin = profile.equippedSkin, userId = player.UserId })
		end
	end
	table.sort(rows, function(a, b)
		return if category.ascending then a.value < b.value else a.value > b.value
	end)
	while #rows > leaderboardConfig.Size do
		table.remove(rows)
	end
	return rows
end

local function refresh()
	local snapshot = {}
	for _, category in categories do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(category.storeName())
		end)
		local orderedStore: OrderedDataStore? = if ok then store else nil
		writeOnline(category, orderedStore)
		local rows = if orderedStore then rowsFromStore(category, orderedStore) else nil
		snapshot[category.key] = rows or rowsFromOnline(category)
	end
	local week = ProfileService.currentWeek()
	latest = {
		categories = snapshot,
		resetsAt = (week + 1) * leaderboardConfig.WeekSeconds - leaderboardConfig.WeekOffsetSeconds,
		serverTime = os.time(),
	}
	EconomyRemotes.LeaderboardChanged:FireAllClients(latest)
end

function LeaderboardService.init()
	EconomyRemotes.LeaderboardRequested.OnServerInvoke = function()
		return latest
	end
	task.spawn(function()
		task.wait(5)
		while true do
			refresh()
			task.wait(leaderboardConfig.RefreshSeconds)
		end
	end)
	ProfileService.Loaded:Connect(function()
		task.delay(2, refresh)
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">ProfileService</string><ProtectedString name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)
local Signal = require(Shared.Signal)
local SkinCatalog = require(Shared.SkinCatalog)

local STORE_NAME = "PenguinProfile_v1"
local AUTOSAVE_SECONDS = 120
local LOAD_ATTEMPTS = 3

export type Profile = {
	fish: number,
	totalFish: number,
	weekFish: number,
	weekRuns: number,
	week: number,
	ownedSkins: { [string]: boolean },
	equippedSkin: string,
	extraSpins: number,
	lastFreeSpin: number,
	lastGift: number,
	giftStreak: number,
	boostUntil: number,
	finishes: { [string]: number },
	bestTimes: { [string]: number },
}

local profiles: { [Player]: Profile } = {}
local dirty: { [Player]: boolean } = {}
local store: DataStore? = nil

local ProfileService = {}

ProfileService.Changed = Signal.new()
ProfileService.Loaded = Signal.new()

local function currentWeek(): number
	local leaderboard = EconomyConfig.Leaderboard
	return math.floor((os.time() + leaderboard.WeekOffsetSeconds) / leaderboard.WeekSeconds)
end

local function defaultProfile(): Profile
	return {
		fish = EconomyConfig.Currency.StartingAmount,
		totalFish = 0,
		weekFish = 0,
		weekRuns = 0,
		week = currentWeek(),
		ownedSkins = { [SkinCatalog.DefaultSkin] = true },
		equippedSkin = SkinCatalog.DefaultSkin,
		extraSpins = 0,
		lastFreeSpin = 0,
		lastGift = 0,
		giftStreak = 0,
		boostUntil = 0,
		finishes = {},
		bestTimes = {},
	}
end

local function reconcile(saved: any): Profile
	local profile = defaultProfile()
	if typeof(saved) ~= "table" then
		return profile
	end
	for key, value in saved do
		if (profile :: any)[key] ~= nil and typeof(value) == typeof((profile :: any)[key]) then
			(profile :: any)[key] = value
		end
	end
	profile.ownedSkins[SkinCatalog.DefaultSkin] = true
	if not SkinCatalog.isValid(profile.equippedSkin) or not profile.ownedSkins[profile.equippedSkin] then
		profile.equippedSkin = SkinCatalog.DefaultSkin
	end
	if profile.week ~= currentWeek() then
		profile.week = currentWeek()
		profile.weekFish = 0
		profile.weekRuns = 0
	end
	return profile
end

local function storeKey(player: Player): string
	return "player_" .. player.UserId
end

local function load(player: Player): Profile
	local activeStore = store
	if not activeStore then
		return defaultProfile()
	end
	for attempt = 1, LOAD_ATTEMPTS do
		local ok, saved = pcall(function()
			return activeStore:GetAsync(storeKey(player))
		end)
		if ok then
			return reconcile(saved)
		end
		task.wait(attempt)
	end
	return defaultProfile()
end

local function save(player: Player)
	local activeStore = store
	local profile = profiles[player]
	if not (activeStore and profile) then
		return
	end
	dirty[player] = nil
	pcall(function()
		activeStore:SetAsync(storeKey(player), profile)
	end)
end

function ProfileService.snapshot(player: Player): { [string]: any }?
	local profile = profiles[player]
	if not profile then
		return nil
	end
	return {
		fish = profile.fish,
		weekFish = profile.weekFish,
		weekRuns = profile.weekRuns,
		ownedSkins = table.clone(profile.ownedSkins),
		equippedSkin = profile.equippedSkin,
		extraSpins = profile.extraSpins,
		lastFreeSpin = profile.lastFreeSpin,
		lastGift = profile.lastGift,
		giftStreak = profile.giftStreak,
		boostUntil = profile.boostUntil,
		finishes = table.clone(profile.finishes),
		bestTimes = table.clone(profile.bestTimes),
		serverTime = os.time(),
	}
end

local function publish(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local leaderstats = player:FindFirstChild("leaderstats")
	local fishValue = leaderstats and leaderstats:FindFirstChild(EconomyConfig.Currency.Name)
	if fishValue and fishValue:IsA("IntValue") then
		fishValue.Value = profile.fish
	end
	EconomyRemotes.ProfileChanged:FireClient(player, ProfileService.snapshot(player))
	ProfileService.Changed:Fire(player, profile)
end

function ProfileService.currentWeek(): number
	return currentWeek()
end

function ProfileService.get(player: Player): Profile?
	return profiles[player]
end

function ProfileService.update(player: Player, mutate: (Profile) -> ()): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	if profile.week ~= currentWeek() then
		profile.week = currentWeek()
		profile.weekFish = 0
		profile.weekRuns = 0
	end
	mutate(profile)
	dirty[player] = true
	publish(player)
	return true
end

function ProfileService.addFish(player: Player, amount: number): boolean
	return ProfileService.update(player, function(profile)
		profile.fish += amount
		profile.totalFish += amount
		profile.weekFish += amount
	end)
end

function ProfileService.spendFish(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or profile.fish < amount then
		return false
	end
	return ProfileService.update(player, function(current)
		current.fish -= amount
	end)
end

local function createLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local fishValue = Instance.new("IntValue")
	fishValue.Name = EconomyConfig.Currency.Name
	fishValue.Parent = leaderstats
	leaderstats.Parent = player
end

local function onPlayerAdded(player: Player)
	createLeaderstats(player)
	local profile = load(player)
	if not player.Parent then
		return
	end
	profiles[player] = profile
	publish(player)
	ProfileService.Loaded:Fire(player, profile)
end

local function onPlayerRemoving(player: Player)
	save(player)
	profiles[player] = nil
	dirty[player] = nil
end

function ProfileService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	store = if ok then result else nil

	EconomyRemotes.ProfileRequested.OnServerInvoke = function(player: Player)
		return ProfileService.snapshot(player)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player in dirty do
				save(player)
			end
		end
	end)
	game:BindToClose(function()
		for player in profiles do
			save(player)
		end
	end)
end

return ProfileService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyRemotes = require(Shared.EconomyRemotes)
local GameConfig = require(Shared.GameConfig)
local LevelRegistry = require(Shared.LevelRegistry)
local RunState = require(Shared.RunState)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local ProfileService = require(script.Parent.ProfileService)
local ReturnService = require(script.Parent.ReturnService)
local RunStateService = require(script.Parent.RunStateService)

local LAUNCH_PAD_HEIGHT = 3

local travelLimiter = RateLimiter.new(1)

local ProgressService = {}

function ProgressService.isUnlocked(player: Player, levelId: number): boolean
	if levelId == LevelRegistry.DefaultLevel then
		return true
	end
	local profile = ProfileService.get(player)
	return profile ~= nil and (profile.finishes[tostring(levelId - 1)] or 0) > 0
end

local function recordFinish(player: Player, payload: any)
	local seconds = if typeof(payload) == "table" and typeof(payload.seconds) == "number" then payload.seconds else nil
	local levelKey = tostring(LevelRegistry.playerLevel(player))
	ProfileService.update(player, function(profile)
		profile.finishes[levelKey] = (profile.finishes[levelKey] or 0) + 1
		profile.weekRuns += 1
		if seconds then
			local best = profile.bestTimes[levelKey]
			if not best or seconds < best then
				profile.bestTimes[levelKey] = seconds
			end
		end
	end)
end

local function onTravelRequested(player: Player, levelId: any): (boolean, string)
	if typeof(levelId) ~= "number" or not travelLimiter:allow(player) then
		return false, "Espera un momento"
	end
	if not LevelRegistry.arrivalFrame(levelId) then
		return false, "Ese nivel no existe"
	end
	if not ProgressService.isUnlocked(player, levelId) then
		return false, ("Termina el nivel %d primero"):format(levelId - 1)
	end
	local state = RunStateService.get(player)
	if state ~= RunState.Idle and state ~= RunState.Finished then
		return false, "Termina tu carrera primero"
	end
	ReturnService.sendToLevel(player, levelId)
	return true, ""
end

local function onLaunchPadRequested(player: Player): (boolean, string)
	if not travelLimiter:allow(player) then
		return false, "Espera un momento"
	end
	if RunStateService.get(player) ~= RunState.Idle then
		return false, "Ya estás en la resortera"
	end
	local slingshot = LevelRegistry.firstTagged("Slingshot", LevelRegistry.playerLevel(player))
	local dismountPosition = slingshot and slingshot:GetAttribute("DismountPosition")
	if typeof(dismountPosition) ~= "Vector3" then
		return false, "No encontré la resortera"
	end
	local arrival = CFrame.lookAlong(dismountPosition + Vector3.new(0, LAUNCH_PAD_HEIGHT, 0), GameConfig.Race.TrackForward)
	RunStateService.reset(player, { teleportTo = arrival })
	return true, ""
end

function ProgressService.init()
	RunStateService.Changed:Connect(function(player: Player, newState: string, _previousState: string, payload: any)
		if newState == RunState.Finished then
			recordFinish(player, payload)
		end
	end)
	EconomyRemotes.LevelTravelRequested.OnServerInvoke = onTravelRequested
	EconomyRemotes.LaunchPadRequested.OnServerInvoke = onLaunchPadRequested
end

return ProgressService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">RewardService</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local ProfileService = require(script.Parent.ProfileService)

local requestLimiter = RateLimiter.new(3)

local RewardService = {}

local function onBoostPurchaseRequested(player: Player): (boolean, string)
	if not requestLimiter:allow(player) then
		return false, "Espera un momento"
	end
	local boost = EconomyConfig.Boost
	if not ProfileService.spendFish(player, boost.FishPrice) then
		return false, "Te faltan peces"
	end
	ProfileService.update(player, function(profile)
		profile.boostUntil = math.max(profile.boostUntil, os.time()) + boost.Minutes * 60
	end)
	return true, ("x%d peces por %d min"):format(boost.Multiplier, boost.Minutes)
end

local function onDailyGiftClaimRequested(player: Player): (boolean, string)
	if not requestLimiter:allow(player) then
		return false, "Espera un momento"
	end
	local gift = EconomyConfig.DailyGift
	local profile = ProfileService.get(player)
	if not profile then
		return false, "Cargando tus datos"
	end
	local now = os.time()
	if now - profile.lastGift < gift.CooldownSeconds then
		return false, "Tu regalo ya fue abierto hoy"
	end
	local streak = if now - profile.lastGift <= gift.StreakResetSeconds then profile.giftStreak + 1 else 1
	local reward = gift.Rewards[(streak - 1) % #gift.Rewards + 1]
	ProfileService.update(player, function(current)
		current.lastGift = now
		current.giftStreak = streak
	end)
	ProfileService.addFish(player, reward)
	return true, ("Día %d: +%d peces"):format(streak, reward)
end

function RewardService.init()
	EconomyRemotes.BoostPurchaseRequested.OnServerInvoke = onBoostPurchaseRequested
	EconomyRemotes.DailyGiftClaimRequested.OnServerInvoke = onDailyGiftClaimRequested
end

return RewardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">SkinService</string><ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyRemotes = require(Shared.EconomyRemotes)
local SkinAppearance = require(Shared.SkinAppearance)
local SkinCatalog = require(Shared.SkinCatalog)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local ProfileService = require(script.Parent.ProfileService)

local requestLimiter = RateLimiter.new(4)

local SkinService = {}

local function dress(player: Player)
	local character = player.Character
	local profile = ProfileService.get(player)
	if not (character and profile) then
		return
	end
	if character:GetAttribute(SkinAppearance.Attribute) == profile.equippedSkin then
		return
	end
	SkinAppearance.apply(character, profile.equippedSkin)
end

function SkinService.grant(player: Player, skinId: string): boolean
	if not SkinCatalog.isValid(skinId) then
		return false
	end
	return ProfileService.update(player, function(profile)
		profile.ownedSkins[skinId] = true
	end)
end

function SkinService.owns(player: Player, skinId: string): boolean
	local profile = ProfileService.get(player)
	return profile ~= nil and profile.ownedSkins[skinId] == true
end

local function onPurchaseRequested(player: Player, skinId: any): (boolean, string)
	if not requestLimiter:allow(player) then
		return false, "Espera un momento"
	end
	local skin = SkinCatalog.get(if typeof(skinId) == "string" then skinId else "")
	if not skin then
		return false, "Esa skin no existe"
	end
	if SkinService.owns(player, skin.id) then
		return false, "Ya tienes esta skin"
	end
	if not ProfileService.spendFish(player, skin.price) then
		return false, "Te faltan peces"
	end
	SkinService.grant(player, skin.id)
	return true, skin.name
end

local function onEquipRequested(player: Player, skinId: any): (boolean, string)
	if not requestLimiter:allow(player) then
		return false, "Espera un momento"
	end
	if typeof(skinId) ~= "string" or not SkinService.owns(player, skinId) then
		return false, "Aún no tienes esta skin"
	end
	ProfileService.update(player, function(profile)
		profile.equippedSkin = skinId
	end)
	dress(player)
	return true, skinId
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		character:WaitForChild("Body", 10)
		character:WaitForChild("Flipper_L", 10)
		character:WaitForChild("Flipper_R", 10)
		task.defer(dress, player)
	end)
end

function SkinService.init()
	EconomyRemotes.SkinPurchaseRequested.OnServerInvoke = onPurchaseRequested
	EconomyRemotes.SkinEquipRequested.OnServerInvoke = onEquipRequested
	ProfileService.Loaded:Connect(function(player: Player)
		dress(player)
	end)
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
end

return SkinService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">WheelService</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)
local WheelCatalog = require(Shared.WheelCatalog)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local ProfileService = require(script.Parent.ProfileService)
local SkinService = require(script.Parent.SkinService)

local wheelConfig = EconomyConfig.Wheel
local spinLimiter = RateLimiter.new(1)
local purchaseLimiter = RateLimiter.new(3)
local random = Random.new()

local WheelService = {}

local function hasFreeSpin(profile: ProfileService.Profile): boolean
	return os.time() - profile.lastFreeSpin >= wheelConfig.FreeSpinCooldownSeconds
end

local function grant(player: Player, prize: WheelCatalog.Prize): string
	if prize.kind == "fish" then
		ProfileService.addFish(player, prize.amount)
		return prize.title
	elseif prize.kind == "chest" then
		local amount = random:NextInteger(WheelCatalog.ChestRange.min, WheelCatalog.ChestRange.max)
		ProfileService.addFish(player, amount)
		return ("Cofre Épico: %d peces"):format(amount)
	elseif prize.kind == "boost" then
		ProfileService.update(player, function(profile)
			profile.boostUntil = math.max(profile.boostUntil, os.time()) + prize.amount * 60
		end)
		return prize.title
	elseif prize.kind == "spin" then
		ProfileService.update(player, function(profile)
			profile.extraSpins += prize.amount
		end)
		return prize.title
	elseif prize.kind == "skin" then
		if SkinService.owns(player, WheelCatalog.SkinPrize) then
			ProfileService.addFish(player, WheelCatalog.SkinDuplicateFish)
			return ("Ya la tenías: +%d peces"):format(WheelCatalog.SkinDuplicateFish)
		end
		SkinService.grant(player, WheelCatalog.SkinPrize)
		return prize.title
	end
	return prize.title
end

local function onSpinRequested(player: Player): (boolean, any)
	if not spinLimiter:allow(player) then
		return false, "La ruleta sigue girando"
	end
	local profile = ProfileService.get(player)
	if not profile then
		return false, "Cargando tus datos"
	end
	local usedFree = hasFreeSpin(profile)
	if not usedFree and profile.extraSpins <= 0 then
		return false, "Sin giros"
	end
	ProfileService.update(player, function(current)
		if usedFree then
			current.lastFreeSpin = os.time()
		else
			current.extraSpins -= 1
		end
	end)
	local index = WheelCatalog.pick(random:NextNumber())
	local prize = WheelCatalog.list()[index]
	EconomyRemotes.WheelSpun:FireAllClients(player.Name, index, workspace:GetServerTimeNow())
	task.delay(wheelConfig.SpinSeconds, function()
		if player.Parent then
			grant(player, prize)
		end
	end)
	return true, { index = index, title = prize.title }
end

local function onSpinPurchaseRequested(player: Player): (boolean, string)
	if not purchaseLimiter:allow(player) then
		return false, "Espera un momento"
	end
	if not ProfileService.spendFish(player, wheelConfig.FishPricePerSpin) then
		return false, "Te faltan peces"
	end
	ProfileService.update(player, function(profile)
		profile.extraSpins += 1
	end)
	return true, "+1 giro"
end

function WheelService.init()
	EconomyRemotes.WheelSpinRequested.OnServerInvoke = onSpinRequested
	EconomyRemotes.WheelSpinPurchaseRequested.OnServerInvoke = onSpinPurchaseRequested
end

return WheelService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX28"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Feedback</string><ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UiKit = require(script.Parent.UiKit)

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 59, 92),
	Color3.fromRGB(255, 210, 63),
	Color3.fromRGB(63, 208, 255),
	Color3.fromRGB(125, 255, 122),
	Color3.fromRGB(255, 122, 224),
	Color3.fromRGB(255, 255, 255),
}

type Piece = { frame: Frame, velocity: Vector2, spin: number, life: number }

local gui: ScreenGui? = nil
local toastHolder: Frame? = nil
local toastLabel: TextLabel? = nil
local toastToken = 0
local pieces: { Piece } = {}

local Feedback = {}

function Feedback.init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = UiKit.new("ScreenGui", { Name = "LobbyFeedback", ResetOnSpawn = false, DisplayOrder = 50, IgnoreGuiInset = true, Parent = playerGui })
	local button, holder = UiKit.button({
		parent = gui :: ScreenGui,
		size = UDim2.fromOffset(460, 56),
		position = UDim2.new(0.5, 0, 0, 120),
		anchor = Vector2.new(0.5, 0),
		palette = UiKit.Palettes.gold,
		text = "",
		radius = 28,
	})
	button.Active = false
	holder.Visible = false
	toastHolder = holder
	toastLabel = button:FindFirstChild("Label") :: TextLabel
	RunService.RenderStepped:Connect(function(deltaSeconds: number)
		for index = #pieces, 1, -1 do
			local piece = pieces[index]
			piece.life -= deltaSeconds
			piece.velocity += Vector2.new(0, 900 * deltaSeconds)
			piece.frame.Position += UDim2.fromOffset(piece.velocity.X * deltaSeconds, piece.velocity.Y * deltaSeconds)
			piece.frame.Rotation += piece.spin * deltaSeconds
			if piece.life <= 0 then
				piece.frame:Destroy()
				table.remove(pieces, index)
			end
		end
	end)
end

function Feedback.toast(text: string, palette: { Color3 }?)
	local holder = toastHolder
	local label = toastLabel
	if not (holder and label) then
		return
	end
	toastToken += 1
	local token = toastToken
	label.Text = text
	local button = holder:FindFirstChild("Button")
	local gradient = button and button:FindFirstChildOfClass("UIGradient")
	if gradient then
		local colors = palette or UiKit.Palettes.gold
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, colors[1]),
			ColorSequenceKeypoint.new(0.5, colors[2]),
			ColorSequenceKeypoint.new(1, colors[3]),
		})
	end
	holder.Position = UDim2.new(0.5, 0, 0, 90)
	holder.Visible = true
	TweenService:Create(holder, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0, 120) }):Play()
	task.delay(1.9, function()
		if toastToken == token then
			holder.Visible = false
		end
	end)
end

function Feedback.confetti(amount: number?)
	local screen = gui
	if not screen then
		return
	end
	local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	for index = 1, amount or 120 do
		local frame = UiKit.new("Frame", {
			Size = UDim2.fromOffset(math.random(8, 14), math.random(5, 9)),
			Position = UDim2.fromOffset(viewport.X / 2 + math.random(-160, 160), viewport.Y * 0.45),
			BackgroundColor3 = CONFETTI_COLORS[index % #CONFETTI_COLORS + 1],
			BorderSizePixel = 0,
			Rotation = math.random(0, 360),
			Parent = screen,
		})
		table.insert(pieces, {
			frame = frame,
			velocity = Vector2.new(math.random(-650, 650), math.random(-1100, -350)),
			spin = math.random(-540, 540),
			life = 2.2,
		})
	end
end

return Feedback
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">FishPickupController</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)
local RunState = require(Shared.RunState)

local PICKUP_TAG = "FishPickup"
local ANIMATION_RADIUS = 220
local SPIN_RATE = 2.4
local BOB_HEIGHT = 0.6

type Pickup = {
	model: Model,
	id: number,
	rest: CFrame,
	phase: number,
	collected: boolean,
}

local localPlayer = Players.LocalPlayer
local pickupsByModel: { [Model]: Pickup } = {}
local collectRadius = EconomyConfig.Fish.CollectRadius

local FishPickupController = {}

local function setHidden(pickup: Pickup, hidden: boolean)
	for _, descendant in pickup.model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
end

local function track(instance: Instance)
	if not instance:IsA("Model") or pickupsByModel[instance] then
		return
	end
	local id = instance:GetAttribute("PickupId")
	if typeof(id) ~= "number" then
		return
	end
	pickupsByModel[instance] = { model = instance, id = id, rest = instance:GetPivot(), phase = math.random() * 6, collected = false }
end

local function untrack(instance: Instance)
	if instance:IsA("Model") then
		pickupsByModel[instance] = nil
	end
end

local function sparkle(position: Vector3)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.CFrame = CFrame.new(position)
	part.Parent = workspace
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(120, 50)
	billboard.AlwaysOnTop = true
	billboard.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(125, 255, 122)
	label.Text = "+" .. EconomyConfig.Fish.ValuePerPickup .. " 🐟"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = billboard
	TweenService:Create(billboard, TweenInfo.new(0.7), { StudsOffset = Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.7), { TextTransparency = 1 }):Play()
	task.delay(0.8, function()
		part:Destroy()
	end)
end

local function resetAll()
	for _, pickup in pickupsByModel do
		if pickup.collected then
			pickup.collected = false
			setHidden(pickup, false)
		end
	end
end

function FishPickupController.init()
	for _, instance in CollectionService:GetTagged(PICKUP_TAG) do
		track(instance)
	end
	CollectionService:GetInstanceAddedSignal(PICKUP_TAG):Connect(track)
	CollectionService:GetInstanceRemovedSignal(PICKUP_TAG):Connect(untrack)
	localPlayer:GetAttributeChangedSignal("RunState"):Connect(function()
		if localPlayer:GetAttribute("RunState") == RunState.Aiming then
			resetAll()
		end
	end)
	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		local focus = if camera then camera.CFrame.Position else Vector3.zero
		local character = localPlayer.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		local racing = localPlayer:GetAttribute("RunState") == RunState.Racing
		local rootPosition = if rootPart and rootPart:IsA("BasePart") then rootPart.Position else nil
		local now = os.clock()
		for model, pickup in pickupsByModel do
			if not pickup.collected then
				local position = pickup.rest.Position
				if (position - focus).Magnitude < ANIMATION_RADIUS then
					model:PivotTo(CFrame.new(position + Vector3.new(0, math.sin(now * 3 + pickup.phase) * BOB_HEIGHT, 0)) * CFrame.Angles(0, now * SPIN_RATE + pickup.phase, 0))
				end
				if racing and rootPosition and (rootPosition - position).Magnitude < collectRadius then
					pickup.collected = true
					setHidden(pickup, true)
					sparkle(position)
					EconomyRemotes.FishCollectRequested:FireServer(pickup.id)
				end
			end
		end
	end)
end

return FishPickupController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">LeaderboardStore</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyRemotes = require(Shared.EconomyRemotes)
local Signal = require(Shared.Signal)

export type Row = { name: string, value: number, skin: string, userId: number }
export type Category = { key: string, title: string, icon: string, format: (number) -> string }

local current: { [string]: any }? = nil

local function formatTime(milliseconds: number): string
	local seconds = milliseconds / 1000
	return ("%d:%05.2f"):format(math.floor(seconds / 60), seconds % 60)
end

local function formatCount(value: number): string
	local text = tostring(math.floor(value)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return if text:sub(1, 1) == "," then text:sub(2) else text
end

local LeaderboardStore = {}

LeaderboardStore.Changed = Signal.new()

LeaderboardStore.Categories = {
	{ key = "fish", title = "PECES", icon = "🐟", format = formatCount },
	{ key = "runs", title = "CARRERAS", icon = "🏁", format = formatCount },
	{ key = "time", title = "TIEMPO", icon = "⏱️", format = formatTime },
} :: { Category }

function LeaderboardStore.rows(key: string): { Row }
	local data = current
	local categories = data and data.categories
	local rows = categories and categories[key]
	return if typeof(rows) == "table" then rows else {}
end

function LeaderboardStore.secondsUntilReset(): number
	local data = current
	if not data then
		return 0
	end
	return math.max(0, (data.resetsAt or 0) - (data.serverTime or os.time()) - (os.time() - (data.receivedAt or os.time())))
end

local function accept(data: any)
	if typeof(data) ~= "table" then
		return
	end
	data.receivedAt = os.time()
	current = data
	LeaderboardStore.Changed:Fire()
end

function LeaderboardStore.init()
	EconomyRemotes.LeaderboardChanged.OnClientEvent:Connect(accept)
	task.spawn(function()
		local ok, data = pcall(function()
			return EconomyRemotes.LeaderboardRequested:InvokeServer()
		end)
		if ok then
			accept(data)
		end
	end)
end

return LeaderboardStore
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">LobbyHud</string><ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)
local RunState = require(Shared.RunState)

local Client = script.Parent
local Feedback = require(Client.Feedback)
local PanelHost = require(Client.PanelHost)
local ProfileStore = require(Client.ProfileStore)
local UiKit = require(Client.UiKit)
local Panels = Client.Panels
local InfoPanel = require(Panels.InfoPanel)
local LeaderboardPanel = require(Panels.LeaderboardPanel)
local LevelsPanel = require(Panels.LevelsPanel)
local ShopPanel = require(Panels.ShopPanel)
local SkinsPanel = require(Panels.SkinsPanel)
local WheelPanel = require(Panels.WheelPanel)

local rgb = Color3.fromRGB
local OPEN_PANEL_ATTRIBUTE = "OpensPanel"
local VISIBLE_STATES = { [RunState.Idle] = true, [RunState.Finished] = true }

type PanelEntry = { title: string, palette: { Color3 }, build: PanelHost.Builder }

local localPlayer = Players.LocalPlayer
local host: PanelHost.PanelHost? = nil
local hudRoot: Frame? = nil
local panels: { [string]: PanelEntry } = {}
local keyBindings: { [Enum.KeyCode]: () -> () } = {}

local LobbyHud = {}

local function registerPanels()
	panels.skins = { title = "🐧 SKINS", palette = { rgb(123, 92, 255), rgb(90, 140, 255), rgb(63, 208, 255) }, build = SkinsPanel.build }
	panels.shop = { title = "🛒 TIENDA", palette = { rgb(255, 111, 216), rgb(123, 92, 255), rgb(63, 208, 255) }, build = ShopPanel.build }
	panels.wheel = { title = "🎡 RULETA DE LA SUERTE", palette = { rgb(255, 79, 163), rgb(255, 179, 0), rgb(255, 79, 163) }, build = WheelPanel.build }
	panels.levels = { title = "🗺️ NIVELES", palette = UiKit.Palettes.purple, build = LevelsPanel.build }
	panels.leaderboard = { title = "🏆 TABLA DE CAMPEONES", palette = { rgb(123, 92, 255), rgb(63, 208, 255), rgb(123, 92, 255) }, build = LeaderboardPanel.build }
	for name, spec in InfoPanel.Specs do
		panels[name] = { title = spec.title, palette = spec.palette, build = InfoPanel.build(spec) }
	end
end

function LobbyHud.open(name: string)
	local activeHost = host
	local entry = panels[name]
	if not (activeHost and entry) then
		return
	end
	if activeHost.openName == name then
		activeHost:close()
		return
	end
	activeHost:open(name, entry.title, entry.palette, entry.build)
end

local function launch()
	local ok, success, message = pcall(function()
		return EconomyRemotes.LaunchPadRequested:InvokeServer()
	end)
	if ok and success then
		Feedback.toast("🐧💨 ¡Presiona E en la resortera!", UiKit.Palettes.gold)
	else
		Feedback.toast(if ok and typeof(message) == "string" then message else "No se pudo", UiKit.Palettes.red)
	end
end

local function tile(parent: Instance, options: { icon: string, text: string, palette: { Color3 }, key: Enum.KeyCode?, ribbon: string?, order: number, size: number?, action: () -> () }): Frame
	local size = options.size or 104
	local button, holder = UiKit.button({ parent = parent, size = UDim2.fromOffset(size, size), palette = options.palette, radius = 18, layoutOrder = options.order })
	local icon = UiKit.label(button, options.icon, { Size = UDim2.new(1, -16, 0.56, 0), Position = UDim2.new(0, 8, 0, 8), StrokeThickness = 0, MaxTextSize = 64, ZIndex = 4 })
	icon.Name = "Icon"
	UiKit.label(button, options.text, { Name = "Caption", Size = UDim2.new(1, -8, 0.24, 0), Position = UDim2.new(0, 4, 0.7, 0), MaxTextSize = 20, StrokeThickness = 2.5, ZIndex = 4 })
	if options.key then
		UiKit.label(button, "[" .. options.key.Name .. "]", { Size = UDim2.fromOffset(34, 18), Position = UDim2.fromOffset(6, 4), MaxTextSize = 16, StrokeThickness = 2, ZIndex = 5, TextXAlignment = Enum.TextXAlignment.Left })
		keyBindings[options.key] = options.action
	end
	if options.ribbon then
		UiKit.ribbon(holder, options.ribbon)
	end
	button.MouseButton1Click:Connect(options.action)
	return holder
end

local function belowChip(holder: Frame, text: string, palette: { Color3 }?): (Frame, TextLabel, Frame)
	local chip = UiKit.new("Frame", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, 12), BackgroundColor3 = UiKit.Ink, ZIndex = 6, Parent = holder })
	UiKit.cornerScale(chip, 0.5)
	UiKit.border(chip, 2.5)
	local fill = UiKit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = UiKit.White, ZIndex = 6, Parent = chip })
	UiKit.cornerScale(fill, 0.5)
	UiKit.gradient(fill, palette or UiKit.Palettes.orange, 90)
	local label = UiKit.label(chip, text, { Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), MaxTextSize = 16, StrokeThickness = 1.8, ZIndex = 7 })
	return chip, label, fill
end

local function buildHud(screen: ScreenGui): Frame
	local root = UiKit.new("Frame", { Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = screen })
	local scale = UiKit.new("UIScale", { Parent = root })
	local function rescale()
		local camera = workspace.CurrentCamera
		local viewport = if camera then camera.ViewportSize else Vector2.new(1400, 850)
		scale.Scale = math.clamp(math.min(viewport.X / 1400, viewport.Y / 820), 0.55, 1)
		root.Size = UDim2.fromScale(1 / scale.Scale, 1 / scale.Scale)
	end
	rescale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	local eventButton, eventHolder = UiKit.button({ parent = root, size = UDim2.fromOffset(300, 40), position = UDim2.fromOffset(14, 8), palette = { rgb(94, 225, 255), rgb(60, 140, 230), rgb(47, 111, 214) }, text = "❄️ EVENTO AVALANCHA · PRONTO", radius = 20, textSize = 22, shadow = 4 })
	eventButton.MouseButton1Click:Connect(function()
		LobbyHud.open("event")
	end)
	UiKit.pulse(eventHolder, eventHolder:FindFirstChildOfClass("UIScale"), 0.03)

	local left = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(230, 380), Position = UDim2.fromOffset(14, 66), Parent = root })
	UiKit.new("UIGridLayout", { CellSize = UDim2.fromOffset(104, 104), CellPadding = UDim2.fromOffset(16, 22), SortOrder = Enum.SortOrder.LayoutOrder, Parent = left })
	tile(left, { icon = "🛒", text = "TIENDA", palette = { rgb(255, 111, 216), rgb(123, 92, 255), rgb(63, 208, 255) }, key = Enum.KeyCode.G, ribbon = "NUEVO", order = 1, action = function() LobbyHud.open("shop") end })
	tile(left, { icon = "🎨", text = "PERSONALIZAR", palette = UiKit.Palettes.pink, order = 2, action = function() LobbyHud.open("custom") end })
	tile(left, { icon = "🐧", text = "SKINS", palette = UiKit.Palettes.purple, key = Enum.KeyCode.K, ribbon = "NUEVO", order = 3, action = function() LobbyHud.open("skins") end })
	tile(left, { icon = "🚀", text = "IMPULSO", palette = UiKit.Palettes.cyan, order = 4, action = function() LobbyHud.open("boost") end })
	local inviteHolder = tile(left, { icon = "🐧➕", text = "INVITAR", palette = UiKit.Palettes.blue, key = Enum.KeyCode.U, order = 5, action = function() LobbyHud.open("invite") end })
	local inviteChip = belowChip(inviteHolder, "¡JUEGA CON AMIGOS!", UiKit.Palettes.gold)
	inviteChip.Rotation = -4
	tile(left, { icon = "📦", text = "INICIAL", palette = UiKit.Palettes.gold, order = 6, action = function() LobbyHud.open("starter") end })

	local topRight = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(420, 60), Position = UDim2.new(1, -14, 0, 6), AnchorPoint = Vector2.new(1, 0), Parent = root })
	UiKit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = topRight })
	tile(topRight, { icon = "👑", text = "VIP", palette = UiKit.Palettes.gold, key = Enum.KeyCode.X, order = 1, size = 58, action = function() LobbyHud.open("vip") end })
	local giftHolder = tile(topRight, { icon = "🎁", text = "REGALO", palette = UiKit.Palettes.purple, key = Enum.KeyCode.Y, order = 2, size = 58, action = function() LobbyHud.open("gift") end })
	local giftBadge = UiKit.badge(giftHolder, "!")
	local money = UiKit.new("Frame", { Size = UDim2.fromOffset(210, 56), BackgroundColor3 = UiKit.Ink, LayoutOrder = 3, Parent = topRight })
	UiKit.corner(money, 16)
	UiKit.border(money, 3, rgb(10, 13, 24))
	local moneyLabel = UiKit.label(money, "🐟 0", { Size = UDim2.new(1, -20, 1, -12), Position = UDim2.fromOffset(10, 6), MaxTextSize = 38, ZIndex = 3 })
	local boostChip = UiKit.new("Frame", { Size = UDim2.fromOffset(150, 34), Position = UDim2.new(1, -14, 0, 74), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = UiKit.White, Visible = false, Parent = root })
	UiKit.corner(boostChip, 12)
	UiKit.border(boostChip, 3)
	UiKit.gradient(boostChip, UiKit.Palettes.cyan, 90)
	local boostLabel = UiKit.label(boostChip, "", { Size = UDim2.new(1, -10, 1, -8), Position = UDim2.fromOffset(5, 4), MaxTextSize = 20, ZIndex = 3 })

	local right = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(480, 120), Position = UDim2.new(1, -14, 1, -250), AnchorPoint = Vector2.new(1, 1), Parent = root })
	UiKit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Bottom, Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = right })
	tile(right, { icon = "🗺️", text = "NIVELES", palette = UiKit.Palettes.purple, key = Enum.KeyCode.Q, ribbon = "NUEVO", order = 1, action = function() LobbyHud.open("levels") end })
	tile(right, { icon = "🏆", text = "TABLA", palette = UiKit.Palettes.orange, key = Enum.KeyCode.L, order = 2, action = function() LobbyHud.open("leaderboard") end })
	local rebirthHolder = tile(right, { icon = "⭐", text = "RENACER", palette = UiKit.Palettes.pink, key = Enum.KeyCode.Z, order = 3, action = function() LobbyHud.open("rebirth") end })
	belowChip(rebirthHolder, "PRONTO")
	local wheelHolder = tile(right, { icon = "🎡", text = "RULETA", palette = UiKit.Palettes.blue, key = Enum.KeyCode.P, order = 4, action = function() LobbyHud.open("wheel") end })
	local wheelBadge, wheelBadgeLabel = UiKit.badge(wheelHolder, "1")
	local _, wheelChipLabel, wheelChipFill = belowChip(wheelHolder, "¡GIRO GRATIS!", UiKit.Palettes.gold)
	local wheelIcon = (wheelHolder:FindFirstChild("Button") :: Instance):FindFirstChild("Icon") :: TextLabel

	local launchButton, launchHolder = UiKit.button({ parent = root, size = UDim2.fromOffset(420, 106), position = UDim2.new(0.5, 0, 1, -128), anchor = Vector2.new(0.5, 1), palette = UiKit.Palettes.gold, text = "¡LANZAR! [R]", radius = 53, textSize = 60, shadow = 8 })
	UiKit.pulse(launchHolder, launchHolder:FindFirstChildOfClass("UIScale"), 0.03)
	launchButton.MouseButton1Click:Connect(launch)
	keyBindings[Enum.KeyCode.R] = launch
	local friendButton = UiKit.button({ parent = root, size = UDim2.fromOffset(440, 80), position = UDim2.new(0.5, 0, 1, -18), anchor = Vector2.new(0.5, 1), palette = UiKit.Palettes.blue, text = "LANZARSE CON UN AMIGO [F] · x2 PECES", radius = 40, textSize = 28 })
	friendButton.MouseButton1Click:Connect(function()
		LobbyHud.open("friend")
	end)
	keyBindings[Enum.KeyCode.F] = function()
		LobbyHud.open("friend")
	end

	local race = UiKit.new("Frame", { Size = UDim2.fromOffset(330, 124), Position = UDim2.new(1, -14, 1, -14), AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = UiKit.White, Parent = root })
	UiKit.corner(race, 22)
	UiKit.border(race, 4)
	UiKit.gradient(race, UiKit.Palettes.blue, 90)
	UiKit.label(race, "PRÓXIMA CARRERA", { Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 8), MaxTextSize = 28, ZIndex = 3 })
	UiKit.label(race, "Carreras programadas · pronto", { Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 40), MaxTextSize = 18, StrokeThickness = 2, ZIndex = 3 })
	local raceButton = UiKit.button({ parent = race, size = UDim2.new(1, -24, 0, 42), position = UDim2.new(0, 12, 1, -54), palette = UiKit.Palettes.gold, text = "[N] ÚNETE A LA PRÓXIMA CARRERA", radius = 16, textSize = 20, shadow = 4 })
	raceButton.MouseButton1Click:Connect(function()
		LobbyHud.open("race")
	end)
	keyBindings[Enum.KeyCode.N] = function()
		LobbyHud.open("race")
	end

	local shownFish: number? = nil
	local function refresh()
		local snapshot = ProfileStore.get()
		if not snapshot then
			return
		end
		if shownFish and snapshot.fish > shownFish then
			local gain = snapshot.fish - shownFish
			local pop = UiKit.label(root, "+" .. UiKit.formatNumber(gain) .. " 🐟", { Size = UDim2.fromOffset(140, 36), Position = UDim2.new(1, -170, 0, 70), MaxTextSize = 30, TextColor3 = rgb(125, 255, 122), ZIndex = 10 })
			TweenService:Create(pop, TweenInfo.new(0.9), { Position = UDim2.new(1, -170, 0, 40), TextTransparency = 1 }):Play()
			task.delay(1, function()
				pop:Destroy()
			end)
		end
		shownFish = snapshot.fish
		moneyLabel.Text = "🐟 " .. UiKit.formatNumber(snapshot.fish)
		local now = ProfileStore.now()
		local freeRemaining = snapshot.lastFreeSpin + EconomyConfig.Wheel.FreeSpinCooldownSeconds - now
		local spins = snapshot.extraSpins + (if freeRemaining <= 0 then 1 else 0)
		wheelBadge.Visible = spins > 0
		wheelBadgeLabel.Text = tostring(spins)
		wheelChipLabel.Text = if freeRemaining <= 0 then "¡GIRO GRATIS!" else UiKit.formatClock(freeRemaining)
		wheelChipFill.Size = UDim2.fromScale(if freeRemaining <= 0 then 1 else 1 - freeRemaining / EconomyConfig.Wheel.FreeSpinCooldownSeconds, 1)
		giftBadge.Visible = now - snapshot.lastGift >= EconomyConfig.DailyGift.CooldownSeconds
		local boostRemaining = snapshot.boostUntil - now
		boostChip.Visible = boostRemaining > 0
		boostLabel.Text = "⚡ x2 · " .. UiKit.formatClock(boostRemaining)
	end
	ProfileStore.Changed:Connect(refresh)
	task.spawn(function()
		while root.Parent do
			refresh()
			if wheelIcon then
				wheelIcon.Rotation = (wheelIcon.Rotation + 6) % 360
			end
			task.wait(0.1)
		end
	end)
	return root
end

local function applyVisibility()
	local root = hudRoot
	if not root then
		return
	end
	local state = localPlayer:GetAttribute("RunState")
	local visible = state == nil or VISIBLE_STATES[state] == true
	root.Visible = visible
	if not visible and host and host:isOpen() then
		host:close()
	end
end

function LobbyHud.init()
	registerPanels()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local screen = UiKit.new("ScreenGui", { Name = "LobbyHud", ResetOnSpawn = false, DisplayOrder = 10, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui })
	hudRoot = buildHud(screen)
	local panelScreen = UiKit.new("ScreenGui", { Name = "LobbyPanels", ResetOnSpawn = false, DisplayOrder = 20, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui })
	local panelHost = PanelHost.new(panelScreen);
	(panelHost :: any).openNamed = function(_self: any, name: string)
		LobbyHud.open(name)
	end
	host = panelHost
	localPlayer:GetAttributeChangedSignal("RunState"):Connect(applyVisibility)
	applyVisibility()
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		local root = hudRoot
		if input.KeyCode == Enum.KeyCode.Escape and host and host:isOpen() then
			host:close()
			return
		end
		if not (root and root.Visible) then
			return
		end
		local action = keyBindings[input.KeyCode]
		if action then
			action()
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local panelName = prompt:GetAttribute(OPEN_PANEL_ATTRIBUTE)
		if typeof(panelName) == "string" then
			LobbyHud.open(panelName)
		end
	end)
end

return LobbyHud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">PanelHost</string><ProtectedString name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")

local UiKit = require(script.Parent.UiKit)
local ProfileStore = require(script.Parent.ProfileStore)

export type Builder = (body: Frame, host: any) -> (() -> ())?

local PanelHost = {}
PanelHost.__index = PanelHost

export type PanelHost = typeof(setmetatable({} :: {
	_root: Frame,
	_window: Frame,
	_title: TextLabel,
	_header: Frame,
	_headerGradient: UIGradient,
	_body: Frame,
	_fishLabel: TextLabel,
	_cleanup: (() -> ())?,
	_scale: UIScale,
	openName: string?,
}, PanelHost))

function PanelHost.new(screen: ScreenGui): PanelHost
	local root = UiKit.new("Frame", { Name = "PanelRoot", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 20, Parent = screen })
	local dim = UiKit.new("TextButton", { Name = "Dim", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 12, 30), BackgroundTransparency = 0.45, ZIndex = 20, Parent = root })
	local window = UiKit.new("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromScale(0.86, 0.84),
		BackgroundColor3 = UiKit.PanelColor,
		ZIndex = 21,
		Parent = root,
	})
	UiKit.new("UISizeConstraint", { MaxSize = Vector2.new(1180, 720), Parent = window })
	UiKit.corner(window, 22)
	UiKit.border(window, 4)
	local scale = UiKit.new("UIScale", { Parent = window })
	local header = UiKit.new("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 78), BackgroundColor3 = UiKit.White, ZIndex = 22, Parent = window })
	UiKit.corner(header, 20)
	UiKit.new("Frame", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), BackgroundColor3 = UiKit.White, BorderSizePixel = 0, ZIndex = 22, Parent = header })
	local headerGradient = UiKit.gradient(header, UiKit.Palettes.rainbow, 0)
	headerGradient.Name = "HeaderGradient"
	for _, child in header:GetChildren() do
		if child:IsA("Frame") then
			UiKit.gradient(child, UiKit.Palettes.rainbow, 0).Name = "HeaderGradient"
		end
	end
	UiKit.new("Frame", { Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 1, 0), BackgroundColor3 = UiKit.Ink, BorderSizePixel = 0, ZIndex = 23, Parent = header })
	local title = UiKit.label(header, "", { Size = UDim2.new(0.55, 0, 0, 56), Position = UDim2.fromOffset(24, 11), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 52, StrokeThickness = 3.5, ZIndex = 24 })
	local fishChip = UiKit.new("Frame", { Size = UDim2.fromOffset(190, 50), Position = UDim2.new(1, -96, 0, 14), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = UiKit.Ink, ZIndex = 24, Parent = header })
	UiKit.corner(fishChip, 14)
	local fishLabel = UiKit.label(fishChip, "🐟 0", { Size = UDim2.new(1, -16, 1, -10), Position = UDim2.fromOffset(8, 5), ZIndex = 25, MaxTextSize = 34 })
	local closeButton = UiKit.button({ parent = header, size = UDim2.fromOffset(58, 58), position = UDim2.new(1, -14, 0, 9), anchor = Vector2.new(1, 0), palette = UiKit.Palettes.red, text = "X", radius = 14, textSize = 34 })
	local body = UiKit.new("Frame", { Name = "Body", Size = UDim2.new(1, -36, 1, -100), Position = UDim2.fromOffset(18, 92), BackgroundTransparency = 1, ZIndex = 22, ClipsDescendants = false, Parent = window })

	local self = setmetatable({
		_root = root,
		_window = window,
		_title = title,
		_header = header,
		_headerGradient = headerGradient,
		_body = body,
		_fishLabel = fishLabel,
		_cleanup = nil,
		_scale = scale,
		openName = nil,
	}, PanelHost)
	dim.MouseButton1Click:Connect(function()
		self:close()
	end)
	closeButton.MouseButton1Click:Connect(function()
		self:close()
	end)
	local function refreshFish(snapshot: any)
		fishLabel.Text = "🐟 " .. UiKit.formatNumber(if snapshot then snapshot.fish else 0)
	end
	ProfileStore.Changed:Connect(refreshFish)
	refreshFish(ProfileStore.get())
	return self
end

function PanelHost.open(self: PanelHost, name: string, titleText: string, palette: { Color3 }, build: Builder)
	self:close()
	self.openName = name
	self._title.Text = titleText
	for _, gradient in self._header:GetDescendants() do
		if gradient:IsA("UIGradient") and gradient.Name == "HeaderGradient" then
			gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, palette[1]),
				ColorSequenceKeypoint.new(0.5, palette[2]),
				ColorSequenceKeypoint.new(1, palette[3]),
			})
		end
	end
	self._root.Visible = true
	self._scale.Scale = 0.7
	TweenService:Create(self._scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	self._cleanup = build(self._body, self)
end

function PanelHost.close(self: PanelHost)
	local cleanup = self._cleanup
	self._cleanup = nil
	if cleanup then
		cleanup()
	end
	for _, child in self._body:GetChildren() do
		child:Destroy()
	end
	self._root.Visible = false
	self.openName = nil
end

function PanelHost.isOpen(self: PanelHost): boolean
	return self._root.Visible
end

return PanelHost
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">PenguinViewport</string><ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local SkinAppearance = require(ReplicatedStorage.Shared.SkinAppearance)

local PenguinViewport = {}
PenguinViewport.__index = PenguinViewport

export type PenguinViewport = typeof(setmetatable({} :: {
	frame: ViewportFrame,
	_world: WorldModel,
	_model: Model?,
	_yaw: number,
	_camera: Camera,
}, PenguinViewport))

local function template(): Model?
	local starter = StarterPlayer:FindFirstChild("StarterCharacter")
	if starter and starter:IsA("Model") then
		return starter
	end
	local character = Players.LocalPlayer.Character
	return character
end

local function cloneTemplate(): Model?
	local source = template()
	if not source then
		return nil
	end
	local wasArchivable = source.Archivable
	source.Archivable = true
	local copy = source:Clone()
	source.Archivable = wasArchivable
	if not copy then
		return nil
	end
	for _, descendant in copy:GetDescendants() do
		if descendant:IsA("LuaSourceContainer") or descendant:IsA("Humanoid") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end
	local accessories = copy:FindFirstChild("SkinAccessories")
	if accessories then
		accessories:Destroy()
	end
	return copy
end

function PenguinViewport.new(parent: Instance, skinId: string, zoom: number?): PenguinViewport
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.LightColor = Color3.fromRGB(255, 250, 240)
	frame.LightDirection = Vector3.new(-0.4, -1, 0.6)
	frame.Ambient = Color3.fromRGB(170, 175, 200)
	frame.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = frame
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local distance = zoom or 13
	camera.CFrame = CFrame.lookAt(Vector3.new(2.6, 2.4, -distance), Vector3.new(0, 0.9, 0))
	camera.Parent = frame
	frame.CurrentCamera = camera
	local self = setmetatable({ frame = frame, _world = world, _model = nil, _yaw = 0, _camera = camera }, PenguinViewport)
	self:setSkin(skinId)
	return self
end

function PenguinViewport.setSkin(self: PenguinViewport, skinId: string)
	local previous = self._model
	if previous then
		previous:Destroy()
	end
	local model = cloneTemplate()
	if not model then
		return
	end
	model:PivotTo(CFrame.new())
	model.Parent = self._world
	SkinAppearance.apply(model, skinId)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end
	self._model = model
	self:_applyYaw()
end

function PenguinViewport._applyYaw(self: PenguinViewport)
	local model = self._model
	if model then
		model:PivotTo(CFrame.Angles(0, self._yaw, 0))
	end
end

function PenguinViewport.spin(self: PenguinViewport, deltaYaw: number)
	self._yaw += deltaYaw
	self:_applyYaw()
end

function PenguinViewport.destroy(self: PenguinViewport)
	self.frame:Destroy()
end

return PenguinViewport
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">ProfileStore</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyRemotes = require(Shared.EconomyRemotes)
local Signal = require(Shared.Signal)

export type Snapshot = {
	fish: number,
	weekFish: number,
	weekRuns: number,
	ownedSkins: { [string]: boolean },
	equippedSkin: string,
	extraSpins: number,
	lastFreeSpin: number,
	lastGift: number,
	giftStreak: number,
	boostUntil: number,
	finishes: { [string]: number },
	bestTimes: { [string]: number },
	serverTime: number,
}

local current: Snapshot? = nil
local clockOffset = 0

local ProfileStore = {}

ProfileStore.Changed = Signal.new()

local function accept(snapshot: any)
	if typeof(snapshot) ~= "table" then
		return
	end
	current = snapshot
	clockOffset = (snapshot.serverTime or os.time()) - os.time()
	ProfileStore.Changed:Fire(snapshot)
end

function ProfileStore.get(): Snapshot?
	return current
end

function ProfileStore.now(): number
	return os.time() + clockOffset
end

function ProfileStore.init()
	EconomyRemotes.ProfileChanged.OnClientEvent:Connect(accept)
	task.spawn(function()
		local ok, snapshot = pcall(function()
			return EconomyRemotes.ProfileRequested:InvokeServer()
		end)
		if ok and current == nil then
			accept(snapshot)
		end
	end)
end

return ProfileStore
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">StepAssist</string><ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local MAX_STEP_HEIGHT = 1.6
local MIN_STEP_HEIGHT = 0.05
local PROBE_LIFT = 0.12
local PROBE_REACH = 0.9
local STEP_COOLDOWN = 0.12
local WALKING_STATES = { Idle = true, Finished = true }
local STEPPABLE_HUMANOID_STATES = {
	[Enum.HumanoidStateType.Running] = true,
	[Enum.HumanoidStateType.RunningNoPhysics] = true,
	[Enum.HumanoidStateType.Climbing] = true,
}

local player = Players.LocalPlayer
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local lastStepAt = 0

local StepAssist = {}

local function isWalkingPhase(): boolean
	local runState = player:GetAttribute("RunState")
	return runState == nil or WALKING_STATES[runState] == true
end

local function horizontal(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

local function bodyReach(character: Model, root: BasePart, direction: Vector3): number
	local _, size = character:GetBoundingBox()
	local local3 = root.CFrame:VectorToObjectSpace(direction)
	return math.abs(local3.X) * size.X / 2 + math.abs(local3.Z) * size.Z / 2
end

local function findLedgeTop(origin: Vector3, direction: Vector3, footY: number): number?
	local above = Vector3.new(origin.X, footY + MAX_STEP_HEIGHT + 0.2, origin.Z) + direction * 0.35
	local result = Workspace:Raycast(above, Vector3.new(0, -(MAX_STEP_HEIGHT + 0.2), 0), rayParams)
	if not result or result.Normal.Y < 0.7 or not result.Instance.CanCollide then
		return nil
	end
	return result.Position.Y
end

local function headroomIsClear(root: BasePart, lift: number, direction: Vector3): boolean
	local result = Workspace:Raycast(root.Position, Vector3.new(0, lift + 0.2, 0) + direction * 0.5, rayParams)
	return result == nil or not result.Instance.CanCollide
end

local function tryStep(character: Model, humanoid: Humanoid, root: BasePart)
	local direction = horizontal(humanoid.MoveDirection)
	if direction.Magnitude < 0.1 then
		return
	end
	direction = direction.Unit
	local footY = root.Position.Y - root.Size.Y / 2 - humanoid.HipHeight
	local reach = bodyReach(character, root, direction) + PROBE_REACH
	local probeOrigin = Vector3.new(root.Position.X, footY + PROBE_LIFT, root.Position.Z)
	local hit = Workspace:Raycast(probeOrigin, direction * reach, rayParams)
	if not hit or math.abs(hit.Normal.Y) > 0.5 or not hit.Instance.CanCollide then
		return
	end
	local top = findLedgeTop(hit.Position, direction, footY)
	if not top then
		return
	end
	local stepHeight = top - footY
	if stepHeight < MIN_STEP_HEIGHT or stepHeight > MAX_STEP_HEIGHT then
		return
	end
	local lift = stepHeight + 0.08
	if not headroomIsClear(root, lift, direction) then
		return
	end
	root.CFrame = root.CFrame + Vector3.new(0, lift, 0) + direction * 0.25
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(direction.X * humanoid.WalkSpeed, math.max(velocity.Y, 0), direction.Z * humanoid.WalkSpeed)
	lastStepAt = os.clock()
end

local function update()
	if os.clock() - lastStepAt < STEP_COOLDOWN or not isWalkingPhase() then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and root:IsA("BasePart")) then
		return
	end
	if humanoid.Health <= 0 or not STEPPABLE_HUMANOID_STATES[humanoid:GetState()] or root.Anchored then
		return
	end
	rayParams.FilterDescendantsInstances = { character }
	tryStep(character, humanoid, root)
end

function StepAssist.init()
	RunService.Heartbeat:Connect(update)
end

return StepAssist
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">UiKit</string><ProtectedString name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")

local rgb = Color3.fromRGB

local UiKit = {}

UiKit.Font = Enum.Font.FredokaOne
UiKit.BodyFont = Enum.Font.GothamBold
UiKit.Ink = rgb(20, 24, 42)
UiKit.PanelColor = rgb(42, 35, 80)
UiKit.PanelDeep = rgb(29, 22, 80)
UiKit.White = rgb(255, 255, 255)

UiKit.Palettes = {
	gold = { rgb(255, 227, 110), rgb(255, 194, 26), rgb(244, 163, 0) },
	blue = { rgb(94, 225, 255), rgb(34, 167, 240), rgb(22, 128, 214) },
	green = { rgb(125, 255, 122), rgb(47, 211, 90), rgb(31, 168, 69) },
	red = { rgb(255, 122, 122), rgb(255, 59, 59), rgb(216, 27, 60) },
	purple = { rgb(197, 140, 255), rgb(143, 77, 255), rgb(106, 47, 224) },
	pink = { rgb(255, 138, 216), rgb(255, 79, 163), rgb(224, 47, 132) },
	cyan = { rgb(143, 248, 255), rgb(47, 216, 232), rgb(24, 176, 200) },
	orange = { rgb(255, 195, 110), rgb(255, 138, 31), rgb(240, 106, 0) },
	silver = { rgb(242, 246, 250), rgb(200, 210, 222), rgb(169, 184, 200) },
	bronze = { rgb(255, 192, 138), rgb(224, 140, 80), rgb(200, 118, 58) },
	ink = { rgb(58, 49, 112), rgb(42, 35, 88), rgb(29, 22, 80) },
	rainbow = { rgb(255, 111, 216), rgb(123, 92, 255), rgb(63, 208, 255) },
}

export type Props = { [string]: any }

function UiKit.new(className: string, props: Props?, children: { Instance }?): any
	local instance = Instance.new(className)
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UiKit.corner(parent: Instance, radius: number): UICorner
	return UiKit.new("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

function UiKit.cornerScale(parent: Instance, scale: number): UICorner
	return UiKit.new("UICorner", { CornerRadius = UDim.new(scale, 0), Parent = parent })
end

function UiKit.border(parent: Instance, thickness: number, color: Color3?): UIStroke
	return UiKit.new("UIStroke", {
		Thickness = thickness,
		Color = color or UiKit.Ink,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function UiKit.textStroke(parent: Instance, thickness: number, color: Color3?): UIStroke
	return UiKit.new("UIStroke", {
		Thickness = thickness,
		Color = color or UiKit.Ink,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function UiKit.gradient(parent: Instance, colors: { Color3 }, rotation: number): UIGradient
	local keypoints = {}
	for index, color in colors do
		table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / math.max(1, #colors - 1), color))
	end
	return UiKit.new("UIGradient", { Color = ColorSequence.new(keypoints), Rotation = rotation, Parent = parent })
end

function UiKit.padding(parent: Instance, pixels: number): UIPadding
	local amount = UDim.new(0, pixels)
	return UiKit.new("UIPadding", { PaddingTop = amount, PaddingBottom = amount, PaddingLeft = amount, PaddingRight = amount, Parent = parent })
end

function UiKit.label(parent: Instance, text: string, props: Props?): TextLabel
	local label = UiKit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = UiKit.Font,
		Text = text,
		TextColor3 = UiKit.White,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	if props then
		for key, value in props do
			if key ~= "StrokeThickness" and key ~= "MaxTextSize" then
				(label :: any)[key] = value
			end
		end
	end
	UiKit.textStroke(label, if props and props.StrokeThickness then props.StrokeThickness else 2.5)
	UiKit.new("UITextSizeConstraint", { MaxTextSize = if props and props.MaxTextSize then props.MaxTextSize else 60, Parent = label })
	return label
end

local function bounce(button: GuiButton, scaleTarget: UIScale)
	button.MouseEnter:Connect(function()
		TweenService:Create(scaleTarget, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scaleTarget, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scaleTarget, TweenInfo.new(0.06), { Scale = 0.94 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scaleTarget, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1.06 }):Play()
	end)
end

export type ButtonOptions = {
	parent: Instance,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	palette: { Color3 },
	text: string?,
	radius: number?,
	textSize: number?,
	layoutOrder: number?,
	shadow: number?,
}

function UiKit.button(options: ButtonOptions): (TextButton, Frame)
	local holder = UiKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = options.size,
		Position = options.position or UDim2.new(),
		AnchorPoint = options.anchor or Vector2.zero,
		LayoutOrder = options.layoutOrder or 0,
		Parent = options.parent,
	})
	local shadowDepth = options.shadow or 6
	local radius = options.radius or 16
	local shadow = UiKit.new("Frame", {
		BackgroundColor3 = UiKit.Ink,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, shadowDepth),
		Parent = holder,
	})
	UiKit.corner(shadow, radius)
	local button = UiKit.new("TextButton", {
		Name = "Button",
		AutoButtonColor = false,
		BackgroundColor3 = UiKit.White,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Parent = holder,
	})
	UiKit.corner(button, radius)
	UiKit.border(button, 3.5)
	UiKit.gradient(button, options.palette, 90)
	local shine = UiKit.new("Frame", {
		BackgroundColor3 = UiKit.White,
		BackgroundTransparency = 0.72,
		Size = UDim2.new(1, -12, 0.3, 0),
		Position = UDim2.fromOffset(6, 4),
		Parent = button,
	})
	UiKit.corner(shine, radius - 4)
	if options.text then
		UiKit.label(button, options.text, {
			Name = "Label",
			Size = UDim2.new(1, -16, 1, -10),
			Position = UDim2.fromOffset(8, 4),
			MaxTextSize = options.textSize or 40,
			ZIndex = 3,
		})
	end
	local scale = UiKit.new("UIScale", { Parent = holder })
	bounce(button, scale)
	return button, holder
end

function UiKit.ribbon(parent: Instance, text: string, palette: { Color3 }?): Frame
	local ribbon = UiKit.new("Frame", {
		Name = "Ribbon",
		Size = UDim2.fromOffset(66, 22),
		Position = UDim2.new(1, 8, 0, -12),
		AnchorPoint = Vector2.new(1, 0),
		Rotation = 6,
		BackgroundColor3 = UiKit.White,
		ZIndex = 8,
		Parent = parent,
	})
	UiKit.corner(ribbon, 8)
	UiKit.border(ribbon, 2.5)
	UiKit.gradient(ribbon, palette or UiKit.Palettes.red, 90)
	UiKit.label(ribbon, text, { Size = UDim2.new(1, -6, 1, -4), Position = UDim2.fromOffset(3, 2), StrokeThickness = 1.6, ZIndex = 9 })
	task.spawn(function()
		while ribbon.Parent do
			TweenService:Create(ribbon, TweenInfo.new(0.8, Enum.EasingStyle.Sine), { Rotation = -3 }):Play()
			task.wait(0.8)
			TweenService:Create(ribbon, TweenInfo.new(0.8, Enum.EasingStyle.Sine), { Rotation = 6 }):Play()
			task.wait(0.8)
		end
	end)
	return ribbon
end

function UiKit.badge(parent: Instance, text: string): (Frame, TextLabel)
	local badge = UiKit.new("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.new(1, 10, 0, -12),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = rgb(255, 59, 59),
		ZIndex = 8,
		Parent = parent,
	})
	UiKit.cornerScale(badge, 0.5)
	UiKit.border(badge, 2.5)
	local label = UiKit.label(badge, text, { Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), StrokeThickness = 1.5, ZIndex = 9 })
	return badge, label
end

function UiKit.pulse(target: GuiObject, scaleObject: UIScale?, amount: number?)
	local scale = scaleObject or UiKit.new("UIScale", { Parent = target })
	local peak = 1 + (amount or 0.06)
	task.spawn(function()
		while target.Parent do
			TweenService:Create(scale, TweenInfo.new(0.55, Enum.EasingStyle.Sine), { Scale = peak }):Play()
			task.wait(0.55)
			TweenService:Create(scale, TweenInfo.new(0.55, Enum.EasingStyle.Sine), { Scale = 1 }):Play()
			task.wait(0.55)
		end
	end)
end

function UiKit.formatNumber(value: number): string
	local text = tostring(math.floor(value))
	local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

function UiKit.formatClock(seconds: number): string
	local clamped = math.max(0, math.floor(seconds))
	local hours = math.floor(clamped / 3600)
	local minutes = math.floor(clamped % 3600 / 60)
	local remainder = clamped % 60
	if hours > 0 then
		return ("%d:%02d:%02d"):format(hours, minutes, remainder)
	end
	return ("%d:%02d"):format(minutes, remainder)
end

return UiKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">WorldBoardController</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SkinAppearance = require(ReplicatedStorage.Shared.SkinAppearance)

local Client = script.Parent
local LeaderboardStore = require(Client.LeaderboardStore)
local UiKit = require(Client.UiKit)

local BOARD_TAG = "LobbyLeaderboard"
local MANNEQUIN_TAG = "PodiumMannequin"
local CYCLE_SECONDS = 7
local ROW_COUNT = 10

local rgb = Color3.fromRGB
local RANK_COLORS = { rgb(255, 210, 63), rgb(230, 237, 245), rgb(224, 144, 74) }
local ROW_PALETTES = {
	{ rgb(255, 207, 31), rgb(255, 138, 31) },
	{ rgb(232, 238, 246), rgb(159, 176, 196) },
	{ rgb(255, 178, 122), rgb(200, 118, 58) },
}
local TAB_COLORS = { rgb(63, 208, 255), rgb(255, 210, 63), rgb(255, 138, 216) }

type Board = {
	tabs: { Frame },
	rows: { { frame: Frame, rank: TextLabel, name: TextLabel, value: TextLabel, bar: Frame } },
	title: TextLabel,
}

local boards: { Board } = {}
local categoryIndex = 1

local WorldBoardController = {}

local function buildBoard(screen: BasePart): Board
	local gui = UiKit.new("SurfaceGui", { Name = "BoardGui", Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.FixedSize, CanvasSize = Vector2.new(1500, 1000), LightInfluence = 0, Brightness = 1.4, Parent = screen })
	local background = UiKit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UiKit.White, Parent = gui })
	UiKit.gradient(background, { rgb(42, 27, 122), rgb(18, 12, 58) }, 90)
	local header = UiKit.new("Frame", { Size = UDim2.new(1, 0, 0, 130), BackgroundColor3 = UiKit.White, Parent = background })
	UiKit.gradient(header, { rgb(255, 79, 163), rgb(255, 179, 0), rgb(255, 79, 163) }, 0)
	local title = UiKit.label(header, "🏆 TOP SEMANAL", { Size = UDim2.new(0.5, -40, 0, 90), Position = UDim2.fromOffset(40, 20), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 80, StrokeThickness = 6 })
	local tabs: { Frame } = {}
	for index, category in LeaderboardStore.Categories do
		local tab = UiKit.new("Frame", { Size = UDim2.fromOffset(220, 84), Position = UDim2.new(0.52, (index - 1) * 236, 0, 24), BackgroundColor3 = rgb(20, 24, 42), Parent = header })
		UiKit.corner(tab, 22)
		UiKit.border(tab, 6)
		UiKit.label(tab, category.icon .. " " .. category.title, { Size = UDim2.new(1, -20, 1, -24), Position = UDim2.fromOffset(10, 12), MaxTextSize = 34, StrokeThickness = 4 })
		table.insert(tabs, tab)
	end
	local rows = {}
	for index = 1, ROW_COUNT do
		local frame = UiKit.new("Frame", { Size = UDim2.new(1, -48, 0, 62), Position = UDim2.fromOffset(24, 150 + (index - 1) * 72), BackgroundColor3 = UiKit.White, Parent = background })
		UiKit.corner(frame, 20)
		UiKit.border(frame, 5)
		local palette = ROW_PALETTES[index] or { rgb(74, 58, 168), rgb(42, 31, 116) }
		UiKit.gradient(frame, palette, 0)
		local medal = UiKit.new("Frame", { Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(12, 5), BackgroundColor3 = RANK_COLORS[index] or rgb(20, 24, 42), Parent = frame })
		UiKit.cornerScale(medal, 0.5)
		UiKit.border(medal, 4)
		local rank = UiKit.label(medal, tostring(index), { Size = UDim2.new(1, -10, 1, -14), Position = UDim2.fromOffset(5, 7), StrokeThickness = 3 })
		local name = UiKit.label(frame, "—", { Size = UDim2.new(0.5, 0, 0, 46), Position = UDim2.fromOffset(84, 8), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 44, StrokeThickness = 5 })
		local track = UiKit.new("Frame", { Size = UDim2.new(0.2, 0, 0, 18), Position = UDim2.new(0.6, 0, 0.5, -9), BackgroundColor3 = rgb(20, 24, 42), BackgroundTransparency = 0.4, Parent = frame })
		UiKit.cornerScale(track, 0.5)
		local bar = UiKit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = UiKit.White, Parent = track })
		UiKit.cornerScale(bar, 0.5)
		UiKit.gradient(bar, { rgb(94, 225, 255), rgb(255, 138, 216) }, 0)
		local value = UiKit.label(frame, "", { Size = UDim2.new(0.17, 0, 0, 46), Position = UDim2.new(0.82, 0, 0, 8), TextXAlignment = Enum.TextXAlignment.Right, MaxTextSize = 42, StrokeThickness = 5, TextColor3 = rgb(255, 227, 110) })
		table.insert(rows, { frame = frame, rank = rank, name = name, value = value, bar = bar })
	end
	return { tabs = tabs, rows = rows, title = title }
end

local function dressMannequins(rows: { LeaderboardStore.Row })
	for _, mannequin in CollectionService:GetTagged(MANNEQUIN_TAG) do
		if mannequin:IsA("Model") then
			local rank = mannequin:GetAttribute("Rank")
			local row = if typeof(rank) == "number" then rows[rank] else nil
			local skin = if row then row.skin else "classic"
			if mannequin:GetAttribute(SkinAppearance.Attribute) ~= skin then
				SkinAppearance.apply(mannequin, skin)
				for _, descendant in mannequin:GetDescendants() do
					if descendant:IsA("BasePart") then
						descendant.Anchored = true
					end
				end
			end
			local tag = mannequin:FindFirstChild("NameTag", true)
			local label = tag and tag:FindFirstChildOfClass("TextLabel")
			if label then
				label.Text = if row then row.name else "¿Serás tú?"
			end
		end
	end
end

local function render()
	local category = LeaderboardStore.Categories[categoryIndex]
	local rows = LeaderboardStore.rows(category.key)
	local leader = if rows[1] then rows[1].value else 1
	for _, board in boards do
		for index, tab in board.tabs do
			tab.BackgroundColor3 = if index == categoryIndex then TAB_COLORS[index] else rgb(20, 24, 42)
		end
		for index, slot in board.rows do
			local row = rows[index]
			slot.name.Text = if row then (if index == 1 then row.name .. " 👑" else row.name) else "—"
			slot.value.Text = if row then category.format(row.value) else ""
			local fill = if row then (if category.key == "time" then leader / math.max(row.value, 1) else row.value / math.max(leader, 1)) else 0
			slot.bar.Size = UDim2.fromScale(math.clamp(fill, 0, 1), 1)
		end
	end
	dressMannequins(rows)
end

function WorldBoardController.init()
	local function track(instance: Instance)
		if not instance:IsA("Model") then
			return
		end
		local screen = instance:FindFirstChild("Screen")
		if screen and screen:IsA("BasePart") and not screen:FindFirstChild("BoardGui") then
			table.insert(boards, buildBoard(screen))
			render()
		end
	end
	for _, instance in CollectionService:GetTagged(BOARD_TAG) do
		track(instance)
	end
	CollectionService:GetInstanceAddedSignal(BOARD_TAG):Connect(track)
	LeaderboardStore.Changed:Connect(render)
	task.spawn(function()
		while true do
			task.wait(CYCLE_SECONDS)
			categoryIndex = categoryIndex % #LeaderboardStore.Categories + 1
			render()
		end
	end)
end

return WorldBoardController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">WorldWheelController</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)
local WheelCatalog = require(Shared.WheelCatalog)

local WheelPanel = require(script.Parent.Panels.WheelPanel)

local WHEEL_TAG = "LobbyWheel"
local EXTRA_TURNS = 5
local BULB_ON = Color3.fromRGB(255, 251, 224)
local BULB_OFF = Color3.fromRGB(194, 122, 0)

type Wheel = {
	model: Model,
	disc: Model,
	discRest: CFrame,
	pointer: Model?,
	pointerRest: CFrame?,
	bulbs: { BasePart },
	banner: TextLabel?,
	angle: number,
	spin: { from: number, to: number, startedAt: number, duration: number, title: string, name: string }?,
	flashUntil: number,
}

local wheels: { [Model]: Wheel } = {}

local WorldWheelController = {}

local function track(instance: Instance)
	if not instance:IsA("Model") or wheels[instance] then
		return
	end
	local disc = instance:FindFirstChild("Disc")
	if not (disc and disc:IsA("Model")) then
		return
	end
	local pointer = instance:FindFirstChild("Pointer")
	local bulbs: { BasePart } = {}
	local bulbFolder = instance:FindFirstChild("Bulbs")
	if bulbFolder then
		for _, bulb in bulbFolder:GetChildren() do
			if bulb:IsA("BasePart") then
				table.insert(bulbs, bulb)
			end
		end
		table.sort(bulbs, function(a, b)
			return (a:GetAttribute("ChaseIndex") or 0) < (b:GetAttribute("ChaseIndex") or 0)
		end)
	end
	local bannerAnchor = instance:FindFirstChild("BannerAnchor", true)
	local banner: TextLabel? = nil
	if bannerAnchor and bannerAnchor:IsA("BasePart") then
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromOffset(520, 80)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 260
		billboard.Enabled = false
		billboard.Parent = bannerAnchor
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 227, 110)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 4
		stroke.Color = Color3.fromRGB(20, 24, 42)
		stroke.Parent = label
		label.Parent = billboard
		banner = label
	end
	wheels[instance] = {
		model = instance,
		disc = disc,
		discRest = disc:GetPivot(),
		pointer = if pointer and pointer:IsA("Model") then pointer else nil,
		pointerRest = if pointer and pointer:IsA("Model") then pointer:GetPivot() else nil,
		bulbs = bulbs,
		banner = banner,
		angle = 0,
		spin = nil,
		flashUntil = 0,
	}
end

local function onWheelSpun(playerName: string, index: number, startedAt: number)
	local prize = WheelCatalog.list()[index]
	if not prize then
		return
	end
	local segmentDegrees = 360 / WheelCatalog.count()
	local centerDegrees = (index - 0.5) * segmentDegrees
	for _, wheel in wheels do
		local target = -centerDegrees
		while target < wheel.angle + 360 * EXTRA_TURNS do
			target += 360
		end
		wheel.spin = { from = wheel.angle, to = target, startedAt = startedAt, duration = EconomyConfig.Wheel.SpinSeconds, title = prize.title, name = playerName }
	end
end

function WorldWheelController.init()
	for _, instance in CollectionService:GetTagged(WHEEL_TAG) do
		track(instance)
	end
	CollectionService:GetInstanceAddedSignal(WHEEL_TAG):Connect(track)
	CollectionService:GetInstanceRemovedSignal(WHEEL_TAG):Connect(function(instance: Instance)
		if instance:IsA("Model") then
			wheels[instance] = nil
		end
	end)
	EconomyRemotes.WheelSpun.OnClientEvent:Connect(onWheelSpun)
	local segmentDegrees = 360 / WheelCatalog.count()
	RunService.RenderStepped:Connect(function()
		local serverNow = workspace:GetServerTimeNow()
		local clock = os.clock()
		for _, wheel in wheels do
			local spin = wheel.spin
			if spin then
				local progress = math.clamp((serverNow - spin.startedAt) / spin.duration, 0, 1)
				local eased = 1 - (1 - progress) ^ 4
				wheel.angle = spin.from + (spin.to - spin.from) * eased
				if progress >= 1 then
					wheel.spin = nil
					wheel.flashUntil = clock + 3
					WheelPanel.recordWinner(("🎉 %s ganó %s"):format(spin.name, spin.title))
					local banner = wheel.banner
					if banner then
						banner.Text = ("¡%s ganó %s!"):format(spin.name, spin.title)
						local billboard = banner.Parent :: BillboardGui
						billboard.Enabled = true
						task.delay(4, function()
							billboard.Enabled = false
						end)
					end
				end
			end
			wheel.disc:PivotTo(wheel.discRest * CFrame.Angles(0, 0, math.rad(wheel.angle)))
			local pointer = wheel.pointer
			local pointerRest = wheel.pointerRest
			if pointer and pointerRest then
				local offset = (wheel.angle % segmentDegrees) / segmentDegrees
				local flap = if wheel.spin then math.max(0, 1 - math.min(offset, 1 - offset) * 6) else 0
				pointer:PivotTo(pointerRest * CFrame.Angles(0, 0, math.rad(flap * 24)))
			end
			local flashing = clock < wheel.flashUntil
			local chase = math.floor(clock * (if wheel.spin then 22 else 8))
			for index, bulb in wheel.bulbs do
				local lit = if flashing then math.floor(clock * 10) % 2 == 0 else (index + chase) % 4 == 0 or ((index + chase) % 4 == 2 and wheel.spin ~= nil)
				bulb.Color = if lit then BULB_ON else BULB_OFF
			end
		end
	end)
end

return WorldWheelController
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX35"><Properties><string name="Name">Panels</string></Properties><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">InfoPanel</string><ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)

local Client = script.Parent.Parent
local Feedback = require(Client.Feedback)
local ProfileStore = require(Client.ProfileStore)
local UiKit = require(Client.UiKit)

export type Spec = {
	title: string,
	palette: { Color3 },
	icon: string,
	heading: string,
	text: string,
	perks: { { string } },
	action: string,
	actionPalette: { Color3 },
	run: ((host: any) -> ())?,
	status: (() -> string)?,
}

local InfoPanel = {}

local function comingSoon(what: string): (host: any) -> ()
	return function()
		Feedback.toast(what .. ": próximamente", UiKit.Palettes.purple)
	end
end

local function invoke(remote: RemoteFunction): (boolean, string)
	local ok, success, message = pcall(function()
		return remote:InvokeServer()
	end)
	return ok and success == true, if ok and typeof(message) == "string" then message else "No se pudo conectar"
end

InfoPanel.Specs = {
	custom = {
		title = "🎨 PERSONALIZAR", palette = UiKit.Palettes.pink, icon = "🎨", heading = "Personaliza tu pingüino",
		text = "Pronto podrás cambiar el color de tu bufanda, elegir una estela al volar y ponerte sombreros.",
		perks = { { "🧣", "Colores de bufanda" }, { "🌈", "Estelas de vuelo" }, { "🎩", "Sombreros y lentes" } },
		action = "PRÓXIMAMENTE", actionPalette = UiKit.Palettes.purple, run = comingSoon("Personalizar"),
	},
	boost = {
		title = "🚀 IMPULSO", palette = UiKit.Palettes.cyan, icon = "🚀", heading = "Impulso de peces",
		text = ("Durante %d minutos cada pez que recojas en la bajada vale el doble."):format(EconomyConfig.Boost.Minutes),
		perks = { { "🐟", ("x%d peces por %d min"):format(EconomyConfig.Boost.Multiplier, EconomyConfig.Boost.Minutes) }, { "⏱️", "Se acumula si compras otro" }, { "🎡", "También sale en la ruleta" } },
		action = "🐟 " .. UiKit.formatNumber(EconomyConfig.Boost.FishPrice), actionPalette = UiKit.Palettes.green,
		run = function()
			local ok, message = invoke(EconomyRemotes.BoostPurchaseRequested)
			if ok then
				Feedback.confetti(90)
				Feedback.toast("🚀 ¡" .. message .. "!", UiKit.Palettes.cyan)
			else
				Feedback.toast(message, UiKit.Palettes.red)
			end
		end,
		status = function(): string
			local snapshot = ProfileStore.get()
			local remaining = if snapshot then snapshot.boostUntil - ProfileStore.now() else 0
			return if remaining > 0 then "⚡ Impulso activo: " .. UiKit.formatClock(remaining) else "Sin impulso activo"
		end,
	},
	invite = {
		title = "🐧 INVITAR", palette = UiKit.Palettes.blue, icon = "🐧", heading = "¡Invita a tus amigos!",
		text = "Juega con tus amigos y compitan en la tabla de la semana.",
		perks = { { "🏁", "Bajen juntos la montaña" }, { "🏆", "Compitan en la tabla" }, { "🎁", "Premios por invitar: próximamente" } },
		action = "INVITAR AMIGOS", actionPalette = UiKit.Palettes.green,
		run = function()
			local ok, canInvite = pcall(function()
				return SocialService:CanSendGameInviteAsync(Players.LocalPlayer)
			end)
			if ok and canInvite then
				SocialService:PromptGameInvite(Players.LocalPlayer)
			else
				Feedback.toast("Las invitaciones no están disponibles aquí", UiKit.Palettes.red)
			end
		end,
	},
	starter = {
		title = "📦 PACK INICIAL", palette = UiKit.Palettes.gold, icon = "📦", heading = "Pack inicial",
		text = "Un paquete para empezar con todo. Su contenido y precio todavía no están decididos.",
		perks = { { "🐟", "Peces" }, { "🎅", "Una skin" }, { "🚀", "Impulsos" } },
		action = "PRÓXIMAMENTE", actionPalette = UiKit.Palettes.purple, run = comingSoon("Pack inicial"),
	},
	vip = {
		title = "👑 VIP", palette = UiKit.Palettes.orange, icon = "👑", heading = "Pase VIP",
		text = "Corona dorada sobre tu nombre y ventajas para siempre. El precio todavía no está decidido.",
		perks = { { "🐟", "Más peces en cada carrera" }, { "🎡", "Giro extra cada día" }, { "💬", "Nombre dorado" } },
		action = "PRÓXIMAMENTE", actionPalette = UiKit.Palettes.purple, run = comingSoon("VIP"),
	},
	gift = {
		title = "🎁 REGALO DIARIO", palette = UiKit.Palettes.purple, icon = "🎁", heading = "Regalo diario",
		text = "Vuelve cada día: si no faltas, el regalo crece hasta 1,000 peces el día 7.",
		perks = { { "1️⃣", "Día 1: 100 peces" }, { "3️⃣", "Día 3: 200 peces" }, { "7️⃣", "Día 7: 1,000 peces" } },
		action = "¡ABRIR!", actionPalette = UiKit.Palettes.green,
		run = function()
			local ok, message = invoke(EconomyRemotes.DailyGiftClaimRequested)
			if ok then
				Feedback.confetti(160)
				Feedback.toast("🎁 " .. message, UiKit.Palettes.gold)
			else
				Feedback.toast(message, UiKit.Palettes.red)
			end
		end,
		status = function(): string
			local snapshot = ProfileStore.get()
			if not snapshot then
				return ""
			end
			local remaining = snapshot.lastGift + EconomyConfig.DailyGift.CooldownSeconds - ProfileStore.now()
			return if remaining > 0 then "Próximo regalo en " .. UiKit.formatClock(remaining) else ("¡Listo para abrir! Racha: %d días"):format(snapshot.giftStreak)
		end,
	},
	rebirth = {
		title = "⭐ RENACER", palette = UiKit.Palettes.pink, icon = "⭐", heading = "Renacer",
		text = "Reinicia tus peces a cambio de un multiplicador permanente. Las reglas todavía se están diseñando.",
		perks = { { "✖️", "Multiplicador de peces" }, { "⭐", "Estrella junto a tu nombre" }, { "🔓", "Skins de renacimiento" } },
		action = "PRÓXIMAMENTE", actionPalette = UiKit.Palettes.purple, run = comingSoon("Renacer"),
	},
	friend = {
		title = "🤝 LANZARSE CON UN AMIGO", palette = UiKit.Palettes.blue, icon = "🤝", heading = "Lanzarse con un amigo",
		text = "Dos pingüinos en la misma resortera y el doble de peces.",
		perks = { { "🐟", "x2 peces" }, { "🐧", "Resortera doble" }, { "🏁", "Llegan juntos a la meta" } },
		action = "PRÓXIMAMENTE", actionPalette = UiKit.Palettes.purple, run = comingSoon("Lanzarse con un amigo"),
	},
	race = {
		title = "🏁 PRÓXIMA CARRERA", palette = UiKit.Palettes.blue, icon = "🏁", heading = "Carreras programadas",
		text = "Todos se lanzan al mismo tiempo y el más rápido gana un gran premio.",
		perks = { { "🥇", "Premio para el 1.º lugar" }, { "🐟", "Peces por participar" }, { "⏱️", "Cada pocos minutos" } },
		action = "PRÓXIMAMENTE", actionPalette = UiKit.Palettes.purple, run = comingSoon("Carreras programadas"),
	},
	event = {
		title = "❄️ EVENTO AVALANCHA", palette = UiKit.Palettes.blue, icon = "❄️", heading = "Evento Avalancha",
		text = "Sobrevive a la avalancha para ganar el Pingüino Glacial. Mientras llega el evento, el Glacial ya se puede comprar en Skins.",
		perks = { { "🧊", "Premio: Pingüino Glacial" }, { "⏱️", "Evento por tiempo limitado" }, { "🏔️", "Nueva bajada especial" } },
		action = "VER EL GLACIAL", actionPalette = UiKit.Palettes.cyan,
		run = function(host: any)
			host:openNamed("skins")
		end,
	},
} :: { [string]: Spec }

function InfoPanel.build(spec: Spec): (body: Frame, host: any) -> () -> ()
	return function(body: Frame, host: any): () -> ()
		local icon = UiKit.label(body, spec.icon, { Size = UDim2.new(0.32, 0, 0.6, 0), Position = UDim2.fromScale(0.04, 0.16), StrokeThickness = 0, MaxTextSize = 170, ZIndex = 23 })
		UiKit.pulse(icon, nil, 0.06)
		local column = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.58, 0, 1, 0), Position = UDim2.fromScale(0.4, 0), ZIndex = 22, Parent = body })
		UiKit.label(column, spec.heading, { Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, 40), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 46, StrokeThickness = 3.5, ZIndex = 23 })
		UiKit.label(column, spec.text, { Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 98), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Font = UiKit.BodyFont, StrokeThickness = 1, MaxTextSize = 19, ZIndex = 23 })
		for index, perk in spec.perks do
			local row = UiKit.new("Frame", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 168 + (index - 1) * 48), BackgroundColor3 = Color3.fromRGB(58, 49, 112), ZIndex = 23, Parent = column })
			UiKit.corner(row, 12)
			UiKit.label(row, perk[1], { Size = UDim2.fromOffset(40, 30), Position = UDim2.fromOffset(6, 5), StrokeThickness = 0, ZIndex = 24 })
			UiKit.label(row, perk[2], { Size = UDim2.new(1, -60, 0, 24), Position = UDim2.fromOffset(52, 8), TextXAlignment = Enum.TextXAlignment.Left, Font = UiKit.BodyFont, StrokeThickness = 1, MaxTextSize = 18, ZIndex = 24 })
		end
		local status = UiKit.label(column, "", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 168 + #spec.perks * 48 + 4), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, ZIndex = 23, TextColor3 = Color3.fromRGB(255, 227, 110) })
		local actionButton = UiKit.button({ parent = column, size = UDim2.fromOffset(320, 64), position = UDim2.fromOffset(0, 168 + #spec.perks * 48 + 40), palette = spec.actionPalette, text = spec.action, radius = 22, textSize = 32 })
		local run = spec.run
		actionButton.MouseButton1Click:Connect(function()
			if run then
				run(host)
			end
		end)
		local ticking = true
		local readStatus = spec.status
		task.spawn(function()
			while ticking do
				status.Text = if readStatus then readStatus() else ""
				task.wait(1)
			end
		end)
		return function()
			ticking = false
		end
	end
end

return InfoPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">LeaderboardPanel</string><ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Client = script.Parent.Parent
local LeaderboardStore = require(Client.LeaderboardStore)
local PenguinViewport = require(Client.PenguinViewport)
local ProfileStore = require(Client.ProfileStore)
local UiKit = require(Client.UiKit)

local rgb = Color3.fromRGB
local PODIUM_PALETTES = { UiKit.Palettes.gold, UiKit.Palettes.silver, UiKit.Palettes.bronze }
local PODIUM_HEIGHTS = { 150, 110, 80 }
local TAB_PALETTES = { UiKit.Palettes.cyan, UiKit.Palettes.purple, UiKit.Palettes.pink }

local LeaderboardPanel = {}

local function myValue(key: string): number?
	local snapshot = ProfileStore.get()
	if not snapshot then
		return nil
	end
	if key == "fish" then
		return snapshot.weekFish
	elseif key == "runs" then
		return snapshot.weekRuns
	end
	local best = snapshot.bestTimes["1"]
	return if best then math.floor(best * 1000) else nil
end

function LeaderboardPanel.build(body: Frame, _host: any): () -> ()
	local connections: { RBXScriptConnection } = {}
	local viewports: { any } = {}
	local activeIndex = 1

	local tabs = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 54), ZIndex = 22, Parent = body })
	UiKit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), Parent = tabs })
	local resetChip = UiKit.new("Frame", { Size = UDim2.fromOffset(270, 34), Position = UDim2.new(1, 0, 0, -58), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = UiKit.Ink, ZIndex = 26, Parent = body })
	UiKit.corner(resetChip, 12)
	local resetLabel = UiKit.label(resetChip, "", { Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), ZIndex = 27, StrokeThickness = 1.5 })
	resetChip.Visible = false
	local content = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -122), Position = UDim2.fromOffset(0, 64), ZIndex = 22, Parent = body })
	local rewards = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.new(0, 0, 1, -46), ZIndex = 22, Parent = body })
	UiKit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), Parent = rewards })
	for index, reward in { "🥇 Campeón de la semana", "🥈 Subcampeón", "🥉 Tercer lugar", "🏅 Top 10" } do
		local chip = UiKit.new("Frame", { Size = UDim2.new(0.25, -8, 1, -4), BackgroundColor3 = UiKit.White, ZIndex = 23, Parent = rewards })
		UiKit.corner(chip, 12)
		UiKit.border(chip, 3)
		UiKit.gradient(chip, ({ UiKit.Palettes.gold, UiKit.Palettes.silver, UiKit.Palettes.bronze, UiKit.Palettes.purple })[index], 90)
		UiKit.label(chip, reward, { Size = UDim2.new(1, -10, 1, -12), Position = UDim2.fromOffset(5, 6), ZIndex = 24, MaxTextSize = 18, StrokeThickness = 1.8 })
	end

	local function clearContent()
		for _, viewport in viewports do
			viewport:destroy()
		end
		table.clear(viewports)
		for _, child in content:GetChildren() do
			child:Destroy()
		end
	end

	local function render()
		clearContent()
		local category = LeaderboardStore.Categories[activeIndex]
		local rows = LeaderboardStore.rows(category.key)
		local podium = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.42, 0, 1, 0), ZIndex = 22, Parent = content })
		for slot, rank in { 2, 1, 3 } do
			local row = rows[rank]
			local column = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.333, -8, 1, 0), Position = UDim2.new((slot - 1) * 0.333, 4, 0, 0), ZIndex = 22, Parent = podium })
			local step = UiKit.new("Frame", { Size = UDim2.new(1, 0, 0, PODIUM_HEIGHTS[rank]), Position = UDim2.new(0, 0, 1, -PODIUM_HEIGHTS[rank]), BackgroundColor3 = UiKit.White, ZIndex = 23, Parent = column })
			UiKit.corner(step, 14)
			UiKit.border(step, 4)
			UiKit.gradient(step, PODIUM_PALETTES[rank], 90)
			UiKit.label(step, tostring(rank), { Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 10), MaxTextSize = 60, StrokeThickness = 4, ZIndex = 24 })
			if row then
				local holder = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, if rank == 1 then 170 else 140), Position = UDim2.new(0, 0, 1, -PODIUM_HEIGHTS[rank] - (if rank == 1 then 214 else 184)), ZIndex = 24, Parent = column })
				local viewport = PenguinViewport.new(holder, row.skin, if rank == 1 then 10 else 11)
				viewport.frame.ZIndex = 24
				table.insert(viewports, viewport)
				if rank == 1 then
					UiKit.label(holder, "👑", { Size = UDim2.fromOffset(60, 50), Position = UDim2.new(0.5, -30, 0, -38), StrokeThickness = 0, ZIndex = 26 })
				end
				UiKit.label(column, row.name, { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, -PODIUM_HEIGHTS[rank] - 46), MaxTextSize = 22, ZIndex = 25 })
				local valueChip = UiKit.new("Frame", { Size = UDim2.new(0.8, 0, 0, 22), Position = UDim2.new(0.1, 0, 1, -PODIUM_HEIGHTS[rank] - 20), BackgroundColor3 = UiKit.Ink, ZIndex = 25, Parent = column })
				UiKit.corner(valueChip, 8)
				UiKit.label(valueChip, category.format(row.value), { Size = UDim2.new(1, -6, 1, -4), Position = UDim2.fromOffset(3, 2), StrokeThickness = 1, ZIndex = 26 })
			end
		end
		local list = UiKit.new("ScrollingFrame", { BackgroundTransparency = 1, Size = UDim2.new(0.58, -16, 1, 0), Position = UDim2.new(0.42, 16, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 6, BorderSizePixel = 0, ZIndex = 22, Parent = content })
		UiKit.new("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
		UiKit.padding(list, 4)
		local leader = rows[1] and rows[1].value or 1
		local localName = Players.LocalPlayer.Name
		local foundMe = false
		local function addRow(rank: string, name: string, skin: string, valueText: string, fill: number, isMe: boolean, order: number, note: string?)
			local rowFrame = UiKit.new("Frame", { Size = UDim2.new(1, -8, 0, 50), BackgroundColor3 = UiKit.White, LayoutOrder = order, ZIndex = 23, Parent = list })
			UiKit.corner(rowFrame, 14)
			UiKit.border(rowFrame, 3)
			UiKit.gradient(rowFrame, if isMe then UiKit.Palettes.green else { rgb(74, 58, 168), rgb(58, 44, 136), rgb(42, 31, 116) }, 0)
			local rankChip = UiKit.new("Frame", { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(5, 5), BackgroundColor3 = UiKit.Ink, ZIndex = 24, Parent = rowFrame })
			UiKit.corner(rankChip, 12)
			UiKit.label(rankChip, rank, { Size = UDim2.new(1, -8, 1, -10), Position = UDim2.fromOffset(4, 5), ZIndex = 25 })
			local thumbHolder = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(50, 1), ZIndex = 24, Parent = rowFrame })
			local viewport = PenguinViewport.new(thumbHolder, skin, 9)
			viewport.frame.ZIndex = 24
			table.insert(viewports, viewport)
			UiKit.label(rowFrame, name, { Size = UDim2.new(0.5, -110, 0, 26), Position = UDim2.fromOffset(104, if note then 3 else 12), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, ZIndex = 24 })
			if note then
				UiKit.label(rowFrame, note, { Size = UDim2.new(0.7, -110, 0, 16), Position = UDim2.fromOffset(104, 29), TextXAlignment = Enum.TextXAlignment.Left, Font = UiKit.BodyFont, StrokeThickness = 1, MaxTextSize = 13, ZIndex = 24 })
			end
			UiKit.label(rowFrame, valueText, { Size = UDim2.new(0.3, 0, 0, 30), Position = UDim2.new(0.7, -12, 0, 10), TextXAlignment = Enum.TextXAlignment.Right, MaxTextSize = 24, ZIndex = 24 })
			local bar = UiKit.new("Frame", { Size = UDim2.new(math.clamp(fill, 0, 1), -6, 0, 4), Position = UDim2.new(0, 3, 1, -6), BackgroundColor3 = rgb(94, 225, 255), BorderSizePixel = 0, ZIndex = 24, Parent = rowFrame })
			UiKit.gradient(bar, { rgb(94, 225, 255), rgb(255, 138, 216) }, 0)
		end
		for rank, row in rows do
			if rank > 3 then
				local fill = if category.key == "time" then leader / math.max(row.value, 1) else row.value / math.max(leader, 1)
				addRow(tostring(rank), row.name, row.skin, category.format(row.value), fill, row.name == localName, rank)
			end
			if row.name == localName then
				foundMe = true
			end
		end
		if #rows <= 3 then
			addRow("…", "¡Aún hay lugares libres!", "classic", "", 0, false, 50, "Juega carreras y recoge peces para entrar al top")
		end
		local mine = myValue(category.key)
		local snapshot = ProfileStore.get()
		if not foundMe then
			addRow("TÚ", localName .. " (TÚ)", if snapshot then snapshot.equippedSkin else "classic", if mine then category.format(mine) else "—", if mine and leader > 0 then (if category.key == "time" then leader / mine else mine / leader) else 0, true, 100, "¡Sigue jugando para entrar al Top 10!")
		end
	end

	for index, category in LeaderboardStore.Categories do
		local button, holder = UiKit.button({ parent = tabs, size = UDim2.new(0.25, -10, 1, -6), palette = TAB_PALETTES[index], text = category.icon .. " " .. category.title, radius = 16, textSize = 26, layoutOrder = index })
		holder:SetAttribute("TabIndex", index)
		button.MouseButton1Click:Connect(function()
			activeIndex = index
			for _, other in tabs:GetChildren() do
				if other:IsA("Frame") then
					local otherButton = other:FindFirstChild("Button") :: TextButton?
					if otherButton then
						otherButton.BackgroundTransparency = if other:GetAttribute("TabIndex") == index then 0 else 0.55
					end
				end
			end
			render()
		end)
		button.BackgroundTransparency = if index == 1 then 0 else 0.55
	end
	local friendsButton = UiKit.button({ parent = tabs, size = UDim2.new(0.25, -10, 1, -6), palette = UiKit.Palettes.green, text = "👥 AMIGOS", radius = 16, textSize = 26, layoutOrder = 4 })
	friendsButton.BackgroundTransparency = 0.55
	friendsButton.MouseButton1Click:Connect(function()
		require(Client.Feedback).toast("👥 Tabla de amigos: próximamente", UiKit.Palettes.green)
	end)

	table.insert(connections, LeaderboardStore.Changed:Connect(render))
	table.insert(connections, RunService.RenderStepped:Connect(function(deltaSeconds: number)
		for _, viewport in viewports do
			viewport:spin(deltaSeconds * 0.5)
		end
	end))
	local ticking = true
	task.spawn(function()
		while ticking do
			local remaining = LeaderboardStore.secondsUntilReset()
			resetChip.Visible = remaining > 0
			resetLabel.Text = ("⏳ Se reinicia en %dd %dh %dm"):format(math.floor(remaining / 86400), math.floor(remaining % 86400 / 3600), math.floor(remaining % 3600 / 60))
			task.wait(1)
		end
	end)
	render()
	return function()
		ticking = false
		for _, connection in connections do
			connection:Disconnect()
		end
		clearContent()
	end
end

return LeaderboardPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">LevelsPanel</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EconomyRemotes = require(ReplicatedStorage.Shared.EconomyRemotes)

local Client = script.Parent.Parent
local Feedback = require(Client.Feedback)
local ProfileStore = require(Client.ProfileStore)
local UiKit = require(Client.UiKit)

local rgb = Color3.fromRGB

local LEVELS = {
	{ id = 1, icon = "🏔️", name = "PICO PINGÜINO", palette = { rgb(191, 231, 255), rgb(120, 175, 235), rgb(91, 155, 224) } },
	{ id = 2, icon = "🏮", name = "ALDEA NEVADA", palette = { rgb(255, 207, 138), rgb(232, 110, 70), rgb(200, 40, 30) } },
	{ id = 3, icon = "🏙️", name = "CIUDAD NEVADA", palette = { rgb(197, 140, 255), rgb(110, 90, 200), rgb(47, 63, 138) } },
	{ id = 4, icon = "✈️", name = "VALLE DEL AVIÓN", palette = { rgb(159, 216, 160), rgb(90, 150, 95), rgb(59, 106, 61) } },
}

local LevelsPanel = {}

local function isUnlocked(snapshot: ProfileStore.Snapshot?, levelId: number): boolean
	if levelId == 1 then
		return true
	end
	return snapshot ~= nil and (snapshot.finishes[tostring(levelId - 1)] or 0) > 0
end

function LevelsPanel.build(body: Frame, host: any): () -> ()
	local row = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 22, Parent = body })
	UiKit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 16), HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = row })
	local snapshot = ProfileStore.get()
	for _, level in LEVELS do
		local unlocked = isUnlocked(snapshot, level.id)
		local finishes = if snapshot then snapshot.finishes[tostring(level.id)] or 0 else 0
		local best = if snapshot then snapshot.bestTimes[tostring(level.id)] else nil
		local card = UiKit.new("Frame", { Size = UDim2.new(0.25, -12, 1, -6), BackgroundColor3 = UiKit.Ink, LayoutOrder = level.id, ZIndex = 23, Parent = row })
		UiKit.corner(card, 18)
		UiKit.border(card, 4)
		local art = UiKit.new("Frame", { Size = UDim2.new(1, 0, 1, -150), BackgroundColor3 = UiKit.White, ZIndex = 24, Parent = card })
		UiKit.corner(art, 16)
		UiKit.gradient(art, if unlocked then level.palette else { rgb(110, 110, 120), rgb(70, 70, 80), rgb(45, 45, 55) }, 90)
		UiKit.label(art, if unlocked then level.icon else "🔒", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.7, 0.45), StrokeThickness = 0, MaxTextSize = 110, ZIndex = 25 })
		if level.id == 3 and unlocked then
			UiKit.ribbon(card, "NUEVO")
		end
		UiKit.label(card, level.name, { Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -142), MaxTextSize = 28, ZIndex = 24 })
		local detail = if not unlocked then ("Termina el nivel %d para abrir"):format(level.id - 1)
			elseif finishes > 0 and best then ("Nivel %d · %d carreras · mejor %s"):format(level.id, finishes, UiKit.formatClock(best))
			else ("Nivel %d · ¡aún sin terminar!"):format(level.id)
		UiKit.label(card, detail, { Size = UDim2.new(1, -16, 0, 22), Position = UDim2.new(0, 8, 1, -104), Font = UiKit.BodyFont, StrokeThickness = 1, MaxTextSize = 15, TextColor3 = rgb(215, 208, 255), ZIndex = 24 })
		local goButton = UiKit.button({ parent = card, size = UDim2.new(1, -24, 0, 54), position = UDim2.new(0, 12, 1, -70), palette = if unlocked then UiKit.Palettes.green else UiKit.Palettes.red, text = if unlocked then "¡IR!" else "BLOQUEADO", radius = 18, textSize = 30 })
		goButton.MouseButton1Click:Connect(function()
			if not unlocked then
				Feedback.toast(("🔒 Termina el nivel %d primero"):format(level.id - 1), UiKit.Palettes.red)
				return
			end
			local ok, success, message = pcall(function()
				return EconomyRemotes.LevelTravelRequested:InvokeServer(level.id)
			end)
			if ok and success then
				host:close()
				Feedback.toast("¡Viajando a " .. level.name .. "!", UiKit.Palettes.blue)
			else
				Feedback.toast(if ok and typeof(message) == "string" then message else "No se pudo viajar", UiKit.Palettes.red)
			end
		end)
	end
	return function() end
end

return LevelsPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">ShopPanel</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)

local Client = script.Parent.Parent
local Feedback = require(Client.Feedback)
local UiKit = require(Client.UiKit)

type Offer = {
	icon: string,
	title: string,
	price: string,
	palette: { Color3 },
	ribbon: string?,
	run: (host: any) -> (),
}

local ShopPanel = {}

local function buyWith(remote: RemoteFunction, success: string)
	local ok, purchased, message = pcall(function()
		return remote:InvokeServer()
	end)
	if ok and purchased then
		Feedback.confetti(90)
		Feedback.toast(success, UiKit.Palettes.cyan)
	else
		Feedback.toast(if ok and typeof(message) == "string" then message else "No se pudo comprar", UiKit.Palettes.red)
	end
end

local function robuxSoon()
	Feedback.toast("Precios en Robux: próximamente", UiKit.Palettes.purple)
end

local offers: { Offer } = {
	{ icon = "🐧", title = "Skins", price = "VER TODAS", palette = UiKit.Palettes.rainbow, ribbon = "NUEVO", run = function(host)
		host:openNamed("skins")
	end },
	{ icon = "🚀", title = ("Impulso x%d · %d min"):format(EconomyConfig.Boost.Multiplier, EconomyConfig.Boost.Minutes), price = "🐟 " .. UiKit.formatNumber(EconomyConfig.Boost.FishPrice), palette = UiKit.Palettes.green, run = function()
		buyWith(EconomyRemotes.BoostPurchaseRequested, "🚀 ¡Impulso activado!")
	end },
	{ icon = "🎡", title = "Giro de ruleta", price = "🐟 " .. UiKit.formatNumber(EconomyConfig.Wheel.FishPricePerSpin), palette = UiKit.Palettes.pink, run = function()
		buyWith(EconomyRemotes.WheelSpinPurchaseRequested, "🎟️ ¡+1 giro!")
	end },
	{ icon = "🎁", title = "Caja misteriosa", price = "R$ ?", palette = UiKit.Palettes.red, run = robuxSoon },
	{ icon = "🐟", title = "500 peces", price = "R$ ?", palette = UiKit.Palettes.blue, run = robuxSoon },
	{ icon = "🐟🐟", title = "1,500 peces", price = "R$ ?", palette = UiKit.Palettes.cyan, run = robuxSoon },
	{ icon = "🧺", title = "4,000 peces", price = "R$ ?", palette = UiKit.Palettes.purple, ribbon = "POPULAR", run = robuxSoon },
	{ icon = "🚚", title = "12,000 peces", price = "R$ ?", palette = UiKit.Palettes.orange, ribbon = "MEJOR OFERTA", run = robuxSoon },
}

function ShopPanel.build(body: Frame, host: any): () -> ()
	local grid = UiKit.new("ScrollingFrame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 6, BorderSizePixel = 0, ZIndex = 22, Parent = body })
	UiKit.padding(grid, 14)
	UiKit.new("UIGridLayout", { CellSize = UDim2.new(0.25, -14, 0, 250), CellPadding = UDim2.fromOffset(14, 18), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for index, offer in offers do
		local card = UiKit.new("Frame", { BackgroundColor3 = UiKit.White, LayoutOrder = index, ZIndex = 23, Parent = grid })
		UiKit.corner(card, 18)
		UiKit.border(card, 4)
		UiKit.gradient(card, offer.palette, 135)
		if offer.ribbon then
			UiKit.ribbon(card, offer.ribbon)
		end
		local icon = UiKit.label(card, offer.icon, { Size = UDim2.new(1, 0, 0, 92), Position = UDim2.fromOffset(0, 16), StrokeThickness = 0, MaxTextSize = 80, ZIndex = 24 })
		UiKit.pulse(icon, nil, 0.05)
		UiKit.label(card, offer.title, { Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, 118), MaxTextSize = 26, ZIndex = 24 })
		local buy = UiKit.button({ parent = card, size = UDim2.new(1, -28, 0, 54), position = UDim2.new(0, 14, 1, -70), palette = UiKit.Palettes.green, text = offer.price, radius = 18, textSize = 28 })
		buy.MouseButton1Click:Connect(function()
			offer.run(host)
		end)
	end
	return function() end
end

return ShopPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">SkinsPanel</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local EconomyRemotes = require(Shared.EconomyRemotes)
local SkinCatalog = require(Shared.SkinCatalog)

local Client = script.Parent.Parent
local Feedback = require(Client.Feedback)
local PenguinViewport = require(Client.PenguinViewport)
local ProfileStore = require(Client.ProfileStore)
local UiKit = require(Client.UiKit)

local LOCKED = {
	{ icon = "🏴‍☠️", name = "Pingüino Pirata", requirement = "Próximamente" },
	{ icon = "🧑‍🚀", name = "Pingüino Astronauta", requirement = "Próximamente" },
	{ icon = "🥷", name = "Pingüino Ninja", requirement = "Próximamente" },
}

local FILTERS = {
	{ text = "TODAS", ids = nil },
	{ text = "🔥 FUEGO", ids = { fire = true } },
	{ text = "❄️ HIELO", ids = { ice = true } },
	{ text = "🎄 NAVIDAD", ids = { santa = true, reindeer = true } },
}

local SkinsPanel = {}

local function priceText(skin: SkinCatalog.Skin, snapshot: ProfileStore.Snapshot?): (string, { Color3 })
	local owned = snapshot ~= nil and snapshot.ownedSkins[skin.id] == true
	if owned and snapshot and snapshot.equippedSkin == skin.id then
		return "EQUIPADO", UiKit.Palettes.blue
	elseif owned then
		return "TUYA", UiKit.Palettes.cyan
	end
	return "🐟 " .. UiKit.formatNumber(skin.price), UiKit.Palettes.green
end

function SkinsPanel.request(remote: RemoteFunction, skinId: string): (boolean, string)
	local ok, success, message = pcall(function()
		return remote:InvokeServer(skinId)
	end)
	if not ok then
		return false, "No se pudo conectar"
	end
	return success == true, if typeof(message) == "string" then message else ""
end

function SkinsPanel.build(body: Frame, _host: any): () -> ()
	local connections: { RBXScriptConnection } = {}
	local selected = (ProfileStore.get() and (ProfileStore.get() :: any).equippedSkin) or SkinCatalog.DefaultSkin
	local filter: { [string]: boolean }? = nil

	local preview = UiKit.new("Frame", { Name = "Preview", Size = UDim2.new(0.37, 0, 1, 0), BackgroundColor3 = UiKit.White, ZIndex = 22, Parent = body })
	UiKit.corner(preview, 18)
	UiKit.border(preview, 4)
	UiKit.gradient(preview, { Color3.fromRGB(108, 127, 224), Color3.fromRGB(80, 74, 170), Color3.fromRGB(59, 58, 138) }, 90)
	UiKit.label(preview, "Arrastra para girar", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 8), Font = UiKit.BodyFont, StrokeThickness = 1, MaxTextSize = 15, ZIndex = 23 })
	local stage = UiKit.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.62, 0), Position = UDim2.fromOffset(0, 26), ZIndex = 23, Parent = preview })
	local viewport = PenguinViewport.new(stage, selected, 11)
	viewport.frame.ZIndex = 23
	local nameLabel = UiKit.label(preview, "", { Size = UDim2.new(1, -24, 0, 38), Position = UDim2.new(0, 12, 0.62, 30), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 23, MaxTextSize = 34, StrokeThickness = 3 })
	local descriptionLabel = UiKit.label(preview, "", { Size = UDim2.new(1, -24, 0, 44), Position = UDim2.new(0, 12, 0.62, 70), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Font = UiKit.BodyFont, StrokeThickness = 1, MaxTextSize = 15, ZIndex = 23 })
	local actionButton, actionHolder = UiKit.button({ parent = preview, size = UDim2.new(1, -28, 0, 58), position = UDim2.new(0, 14, 1, -72), palette = UiKit.Palettes.green, text = "", radius = 18, textSize = 30 })
	actionHolder.ZIndex = 23

	local right = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.63, -16, 1, 0), Position = UDim2.new(0.37, 16, 0, 0), ZIndex = 22, Parent = body })
	local chips = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), ZIndex = 22, Parent = right })
	UiKit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), Parent = chips })
	local grid = UiKit.new("ScrollingFrame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -48), Position = UDim2.fromOffset(0, 48), ScrollBarThickness = 8, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), BorderSizePixel = 0, ZIndex = 22, Parent = right })
	UiKit.padding(grid, 8)
	UiKit.new("UIGridLayout", { CellSize = UDim2.fromOffset(170, 236), CellPadding = UDim2.fromOffset(14, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })

	local cardViewports: { any } = {}

	local function refreshAction()
		local skin = SkinCatalog.get(selected)
		if not skin then
			return
		end
		nameLabel.Text = skin.name
		descriptionLabel.Text = skin.description
		local snapshot = ProfileStore.get()
		local text, palette = priceText(skin, snapshot)
		local label = actionButton:FindFirstChild("Label") :: TextLabel
		label.Text = if text == "TUYA" then "EQUIPAR" elseif text == "EQUIPADO" then "EQUIPADO ✓" else "COMPRAR " .. text
		local gradient = actionButton:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, palette[1]), ColorSequenceKeypoint.new(0.5, palette[2]), ColorSequenceKeypoint.new(1, palette[3]) })
		end
	end

	local function rebuildGrid()
		for _, item in cardViewports do
			item:destroy()
		end
		table.clear(cardViewports)
		for _, child in grid:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local snapshot = ProfileStore.get()
		for _, skin in SkinCatalog.list() do
			if filter == nil or filter[skin.id] then
				local card = UiKit.new("TextButton", { Text = "", AutoButtonColor = false, LayoutOrder = skin.order, BackgroundColor3 = UiKit.White, ZIndex = 23, Parent = grid })
				UiKit.corner(card, 16)
				UiKit.border(card, if skin.id == selected then 4.5 else 3.5, if skin.id == selected then UiKit.White else UiKit.Ink)
				UiKit.gradient(card, { skin.accent, skin.glow }, 135)
				local rarity = UiKit.new("Frame", { Size = UDim2.fromOffset(92, 20), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = UiKit.Ink, ZIndex = 25, Parent = card })
				UiKit.corner(rarity, 8)
				UiKit.label(rarity, skin.rarity, { Size = UDim2.new(1, -8, 1, -4), Position = UDim2.fromOffset(4, 2), StrokeThickness = 1, ZIndex = 26 })
				local holder = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 140), Position = UDim2.fromOffset(4, 22), ZIndex = 24, Parent = card })
				local thumb = PenguinViewport.new(holder, skin.id, 10)
				thumb.frame.ZIndex = 24
				table.insert(cardViewports, thumb)
				UiKit.label(card, skin.name, { Size = UDim2.new(1, -12, 0, 24), Position = UDim2.fromOffset(6, 160), ZIndex = 25, MaxTextSize = 18, StrokeThickness = 2 })
				local text, palette = priceText(skin, snapshot)
				local price = UiKit.new("Frame", { Size = UDim2.new(1, -16, 0, 36), Position = UDim2.new(0, 8, 1, -44), BackgroundColor3 = UiKit.White, ZIndex = 25, Parent = card })
				UiKit.corner(price, 12)
				UiKit.border(price, 3)
				UiKit.gradient(price, palette, 90)
				UiKit.label(price, text, { Size = UDim2.new(1, -10, 1, -8), Position = UDim2.fromOffset(5, 4), ZIndex = 26, MaxTextSize = 22 })
				card.MouseButton1Click:Connect(function()
					selected = skin.id
					viewport:setSkin(selected)
					refreshAction()
					rebuildGrid()
				end)
			end
		end
		if filter == nil then
			for index, locked in LOCKED do
				local card = UiKit.new("Frame", { LayoutOrder = 100 + index, BackgroundColor3 = Color3.fromRGB(58, 49, 112), ZIndex = 23, Parent = grid })
				UiKit.corner(card, 16)
				UiKit.border(card, 3.5)
				UiKit.label(card, locked.icon, { Size = UDim2.new(1, 0, 0, 100), Position = UDim2.fromOffset(0, 30), TextTransparency = 0.5, ZIndex = 24, MaxTextSize = 70, StrokeThickness = 0 })
				UiKit.label(card, locked.name, { Size = UDim2.new(1, -12, 0, 24), Position = UDim2.fromOffset(6, 150), ZIndex = 24, MaxTextSize = 18 })
				UiKit.label(card, "🔒 " .. locked.requirement, { Size = UDim2.new(1, -12, 0, 30), Position = UDim2.new(0, 6, 1, -42), ZIndex = 24, MaxTextSize = 18, TextColor3 = Color3.fromRGB(255, 160, 160) })
			end
		end
	end

	for index, option in FILTERS do
		local chip = UiKit.new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(if index == 1 then 90 else 120, 34), BackgroundColor3 = if index == 1 then Color3.fromRGB(255, 194, 26) else Color3.fromRGB(58, 49, 112), ZIndex = 23, Parent = chips })
		UiKit.cornerScale(chip, 0.5)
		UiKit.border(chip, 3)
		UiKit.label(chip, option.text, { Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), ZIndex = 24, MaxTextSize = 17, StrokeThickness = 1.5 })
		chip.MouseButton1Click:Connect(function()
			filter = option.ids
			for _, other in chips:GetChildren() do
				if other:IsA("TextButton") then
					other.BackgroundColor3 = Color3.fromRGB(58, 49, 112)
				end
			end
			chip.BackgroundColor3 = Color3.fromRGB(255, 194, 26)
			rebuildGrid()
		end)
	end

	actionButton.MouseButton1Click:Connect(function()
		local skin = SkinCatalog.get(selected)
		local snapshot = ProfileStore.get()
		if not (skin and snapshot) then
			return
		end
		if snapshot.ownedSkins[skin.id] then
			if snapshot.equippedSkin == skin.id then
				return
			end
			local ok, message = SkinsPanel.request(EconomyRemotes.SkinEquipRequested, skin.id)
			Feedback.toast(if ok then "¡" .. skin.name .. " equipado!" else message, if ok then UiKit.Palettes.blue else UiKit.Palettes.red)
		else
			local ok, message = SkinsPanel.request(EconomyRemotes.SkinPurchaseRequested, skin.id)
			if ok then
				Feedback.confetti(200)
				Feedback.toast("¡Desbloqueaste " .. skin.name .. "! 🎉")
			else
				Feedback.toast(message, UiKit.Palettes.red)
			end
		end
	end)

	local dragX: number? = nil
	table.insert(connections, stage.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragX = input.Position.X
		end
	end))
	table.insert(connections, stage.InputChanged:Connect(function(input: InputObject)
		if dragX and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			viewport:spin((input.Position.X - dragX) * 0.012)
			dragX = input.Position.X
		end
	end))
	table.insert(connections, stage.InputEnded:Connect(function()
		dragX = nil
	end))
	table.insert(connections, RunService.RenderStepped:Connect(function(deltaSeconds: number)
		if not dragX then
			viewport:spin(deltaSeconds * 0.6)
		end
		for _, thumb in cardViewports do
			thumb:spin(deltaSeconds * 0.4)
		end
	end))
	table.insert(connections, ProfileStore.Changed:Connect(function()
		refreshAction()
		rebuildGrid()
	end))

	refreshAction()
	rebuildGrid()
	return function()
		for _, connection in connections do
			connection:Disconnect()
		end
		viewport:destroy()
		for _, thumb in cardViewports do
			thumb:destroy()
		end
	end
end

return SkinsPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">WheelPanel</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.EconomyConfig)
local EconomyRemotes = require(Shared.EconomyRemotes)
local WheelCatalog = require(Shared.WheelCatalog)

local Client = script.Parent.Parent
local Feedback = require(Client.Feedback)
local ProfileStore = require(Client.ProfileStore)
local UiKit = require(Client.UiKit)

local SLIVERS_PER_SEGMENT = 9
local BULB_COUNT = 28
local EXTRA_TURNS = 6

local recentWinners: { string } = {
	"🎉 copito77 ganó el Pingüino Inferno",
	"💎 IceKing_RD sacó el JACKPOT",
	"🎁 nievesita abrió un Cofre Épico",
}

local WheelPanel = {}

function WheelPanel.recordWinner(text: string)
	table.insert(recentWinners, 1, text)
	while #recentWinners > 8 do
		table.remove(recentWinners)
	end
end

local function shade(color: Color3, amount: number): Color3
	return if amount >= 0 then color:Lerp(Color3.new(1, 1, 1), amount) else color:Lerp(Color3.new(0, 0, 0), -amount)
end

local function circle(parent: Instance, size: UDim2, position: UDim2, color: Color3, zIndex: number): Frame
	local frame = UiKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = size, Position = position, BackgroundColor3 = color, ZIndex = zIndex, Parent = parent })
	UiKit.cornerScale(frame, 0.5)
	return frame
end

local function spinsAvailable(snapshot: ProfileStore.Snapshot?): (number, number)
	if not snapshot then
		return 0, 0
	end
	local remaining = snapshot.lastFreeSpin + EconomyConfig.Wheel.FreeSpinCooldownSeconds - ProfileStore.now()
	local free = if remaining <= 0 then 1 else 0
	return free + snapshot.extraSpins, math.max(0, remaining)
end

function WheelPanel.build(body: Frame, _host: any): () -> ()
	local connections: { RBXScriptConnection } = {}
	local prizes = WheelCatalog.list()
	local segmentDegrees = 360 / #prizes

	local stageArea = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.5, 0, 1, 0), ZIndex = 22, Parent = body })
	local square = UiKit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromScale(0.96, 0.96), ZIndex = 22, Parent = stageArea })
	UiKit.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = square })

	local rays = UiKit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.3, 1.3), ZIndex = 22, Parent = square })
	local rayGroup = UiKit.new("CanvasGroup", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), GroupTransparency = 0.55, ZIndex = 22, Parent = rays })
	for index = 0, 11 do
		local ray = UiKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.09, 0.5), Rotation = index * 30, BackgroundColor3 = Color3.fromRGB(255, 226, 120), BorderSizePixel = 0, ZIndex = 22, Parent = rayGroup })
		UiKit.new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = ray })
	end

	local rim = circle(square, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), UiKit.White, 23)
	UiKit.border(rim, 5)
	UiKit.gradient(rim, { Color3.fromRGB(255, 243, 160), Color3.fromRGB(255, 194, 26), Color3.fromRGB(244, 163, 0), Color3.fromRGB(255, 227, 110) }, 45)
	circle(rim, UDim2.fromScale(0.86, 0.86), UDim2.fromScale(0.5, 0.5), UiKit.Ink, 24)

	local bulbs: { Frame } = {}
	for index = 0, BULB_COUNT - 1 do
		local angle = index / BULB_COUNT * math.pi * 2
		local bulb = circle(rim, UDim2.fromScale(0.042, 0.042), UDim2.fromScale(0.5 + math.cos(angle) * 0.465, 0.5 + math.sin(angle) * 0.465), Color3.fromRGB(194, 122, 0), 25)
		UiKit.border(bulb, 2)
		table.insert(bulbs, bulb)
	end

	local disc = UiKit.new("CanvasGroup", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.82, 0.82), BackgroundColor3 = UiKit.Ink, ZIndex = 25, Parent = rim })
	UiKit.cornerScale(disc, 0.5)
	local sliverWidth = 2 * math.sin(math.rad(segmentDegrees / SLIVERS_PER_SEGMENT) / 2) * 0.5 * 1.35
	for index, prize in prizes do
		local startDegrees = -90 + (index - 1) * segmentDegrees
		for slice = 0, SLIVERS_PER_SEGMENT - 1 do
			local angle = startDegrees + (slice + 0.5) * segmentDegrees / SLIVERS_PER_SEGMENT
			local arm = UiKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(sliverWidth, 1), Rotation = angle + 90, BackgroundTransparency = 1, ZIndex = 26, Parent = disc })
			local sliver = UiKit.new("Frame", { Size = UDim2.fromScale(1, 0.5), BackgroundColor3 = UiKit.White, BorderSizePixel = 0, ZIndex = 26, Parent = arm })
			UiKit.gradient(sliver, { shade(prize.color, -0.25), prize.color, shade(prize.color, 0.45) }, 90)
		end
		local center = math.rad(startDegrees + segmentDegrees / 2)
		local icon = UiKit.label(disc, prize.icon, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.12, 0.12), Position = UDim2.fromScale(0.5 + math.cos(center) * 0.28, 0.5 + math.sin(center) * 0.28), Rotation = math.deg(center) + 90, StrokeThickness = 0, ZIndex = 28 })
		icon.TextScaled = true
		local text = UiKit.label(disc, prize.label, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.17, 0.075), Position = UDim2.fromScale(0.5 + math.cos(center) * 0.415, 0.5 + math.sin(center) * 0.415), Rotation = math.deg(center) + 90, StrokeThickness = 2.5, ZIndex = 28 })
		text.TextColor3 = if prize.amount >= 10000 then Color3.fromRGB(255, 227, 110) else UiKit.White
		local divider = math.rad(startDegrees)
		local lineArm = UiKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 4, 1, 0), Rotation = startDegrees + 90, BackgroundTransparency = 1, ZIndex = 27, Parent = disc })
		local line = UiKit.new("Frame", { Size = UDim2.fromScale(1, 0.5), BackgroundColor3 = UiKit.Ink, BorderSizePixel = 0, ZIndex = 27, Parent = lineArm })
		UiKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0, 2, 1, 0), BackgroundColor3 = UiKit.White, BorderSizePixel = 0, ZIndex = 27, Parent = line })
		local peg = circle(disc, UDim2.fromScale(0.035, 0.035), UDim2.fromScale(0.5 + math.cos(divider) * 0.475, 0.5 + math.sin(divider) * 0.475), Color3.fromRGB(255, 210, 63), 29)
		UiKit.border(peg, 2)
	end
	local gloss = UiKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.04), Size = UDim2.fromScale(0.76, 0.42), BackgroundColor3 = UiKit.White, BackgroundTransparency = 0.82, ZIndex = 30, Parent = rim })
	UiKit.cornerScale(gloss, 0.5)

	local hub = UiKit.new("TextButton", { Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.2, 0.2), BackgroundColor3 = UiKit.White, ZIndex = 31, Parent = rim })
	UiKit.cornerScale(hub, 0.5)
	UiKit.border(hub, 5)
	UiKit.gradient(hub, { Color3.fromRGB(255, 138, 138), Color3.fromRGB(255, 59, 59), Color3.fromRGB(179, 18, 44) }, 90)
	UiKit.label(hub, "GO!", { Size = UDim2.fromScale(0.7, 0.5), Position = UDim2.fromScale(0.15, 0.25), ZIndex = 32, StrokeThickness = 3 })
	UiKit.pulse(hub, nil, 0.07)

	local pointer = UiKit.label(square, "▼", { AnchorPoint = Vector2.new(0.5, 0.15), Size = UDim2.fromScale(0.16, 0.16), Position = UDim2.fromScale(0.5, -0.04), TextColor3 = Color3.fromRGB(255, 59, 59), StrokeThickness = 4, ZIndex = 33, MaxTextSize = 120 })

	local side = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.5, -18, 1, 0), Position = UDim2.new(0.5, 18, 0, 0), ZIndex = 22, Parent = body })
	local spinButton, spinHolder = UiKit.button({ parent = side, size = UDim2.new(1, 0, 0, 84), palette = UiKit.Palettes.gold, text = "¡GIRAR!", radius = 26, textSize = 48 })
	UiKit.pulse(spinHolder, spinHolder:FindFirstChildOfClass("UIScale"), 0.035)
	local info = UiKit.label(side, "", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 96), Font = UiKit.BodyFont, StrokeThickness = 1.5, MaxTextSize = 20, ZIndex = 23 })
	local buyRow = UiKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 66), Position = UDim2.fromOffset(0, 130), ZIndex = 22, Parent = side })
	UiKit.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), Parent = buyRow })
	local fishBuy = UiKit.button({ parent = buyRow, size = UDim2.new(0.333, -8, 1, -6), palette = UiKit.Palettes.green, text = "+1 GIRO · 🐟1,000", radius = 18, textSize = 22, layoutOrder = 1 })
	local robuxOne = UiKit.button({ parent = buyRow, size = UDim2.new(0.333, -8, 1, -6), palette = UiKit.Palettes.cyan, text = "+1 GIRO · R$ ?", radius = 18, textSize = 22, layoutOrder = 2 })
	local robuxTen, robuxTenHolder = UiKit.button({ parent = buyRow, size = UDim2.new(0.333, -8, 1, -6), palette = UiKit.Palettes.purple, text = "+10 GIROS · R$ ?", radius = 18, textSize = 22, layoutOrder = 3 })
	UiKit.ribbon(robuxTenHolder, "-20%")
	UiKit.label(side, "PREMIOS POSIBLES", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 206), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 24, ZIndex = 23 })
	local prizeGrid = UiKit.new("ScrollingFrame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -290), Position = UDim2.fromOffset(0, 240), AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 6, BorderSizePixel = 0, ZIndex = 22, Parent = side })
	UiKit.padding(prizeGrid, 6)
	UiKit.new("UIGridLayout", { CellSize = UDim2.new(0.333, -10, 0, 86), CellPadding = UDim2.fromOffset(10, 10), Parent = prizeGrid })
	for index, prize in prizes do
		local card = UiKit.new("Frame", { BackgroundColor3 = UiKit.White, ZIndex = 23, Parent = prizeGrid })
		UiKit.corner(card, 14)
		UiKit.border(card, 3)
		UiKit.gradient(card, { shade(prize.color, 0.3), prize.color }, 135)
		UiKit.label(card, prize.icon, { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 4), StrokeThickness = 0, ZIndex = 24 })
		UiKit.label(card, prize.title, { Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 38), MaxTextSize = 15, StrokeThickness = 1.5, ZIndex = 24 })
		local chance = UiKit.new("Frame", { Size = UDim2.fromOffset(52, 18), Position = UDim2.new(0.5, 0, 0, 62), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = UiKit.Ink, ZIndex = 24, Parent = card })
		UiKit.corner(chance, 8)
		UiKit.label(chance, ("%d%%"):format(math.floor(WheelCatalog.chance(index) * 100 + 0.5)), { Size = UDim2.new(1, -6, 1, -4), Position = UDim2.fromOffset(3, 2), StrokeThickness = 1, ZIndex = 25 })
	end
	local ticker = UiKit.new("Frame", { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 1, -38), BackgroundColor3 = UiKit.Ink, ClipsDescendants = true, ZIndex = 23, Parent = side })
	UiKit.corner(ticker, 12)
	local tickerText = UiKit.label(ticker, table.concat(recentWinners, "   ·   "), { Size = UDim2.new(3, 0, 1, -8), Position = UDim2.new(1, 0, 0, 4), TextXAlignment = Enum.TextXAlignment.Left, Font = UiKit.BodyFont, StrokeThickness = 1, MaxTextSize = 16, ZIndex = 24 })

	local win = UiKit.new("Frame", { Visible = false, BackgroundColor3 = Color3.fromRGB(10, 6, 30), BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1), ZIndex = 40, Parent = body })
	local winCard = UiKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(400, 300), BackgroundColor3 = UiKit.White, ZIndex = 41, Parent = win })
	UiKit.corner(winCard, 28)
	UiKit.border(winCard, 5)
	UiKit.gradient(winCard, UiKit.Palettes.gold, 90)
	local winIcon = UiKit.label(winCard, "🐟", { Size = UDim2.new(1, 0, 0, 110), Position = UDim2.fromOffset(0, 10), StrokeThickness = 0, MaxTextSize = 100, ZIndex = 42 })
	UiKit.label(winCard, "¡GANASTE!", { Size = UDim2.new(1, -20, 0, 52), Position = UDim2.fromOffset(10, 118), MaxTextSize = 52, StrokeThickness = 4, ZIndex = 42 })
	local winText = UiKit.label(winCard, "", { Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 170), MaxTextSize = 32, StrokeThickness = 3, ZIndex = 42 })
	local okButton = UiKit.button({ parent = winCard, size = UDim2.new(1, -60, 0, 54), position = UDim2.new(0, 30, 1, -72), palette = UiKit.Palettes.green, text = "¡GENIAL!", radius = 20, textSize = 30 })
	okButton.MouseButton1Click:Connect(function()
		win.Visible = false
	end)

	local rotation = 0
	local spin: { from: number, to: number, elapsed: number, duration: number, index: number, title: string }? = nil
	local flashSeconds = 0
	local clock = 0

	local function refreshInfo()
		local count, remaining = spinsAvailable(ProfileStore.get())
		info.Text = if remaining > 0 then ("Giros: %d · gratis en %s"):format(count, UiKit.formatClock(remaining)) else ("Giros: %d · ¡tienes un giro gratis!"):format(count)
		local label = spinButton:FindFirstChild("Label") :: TextLabel
		label.Text = if count > 0 then ("¡GIRAR! (%d)"):format(count) else "SIN GIROS"
	end

	local function startSpin()
		if spin then
			return
		end
		local ok, success, result = pcall(function()
			return EconomyRemotes.WheelSpinRequested:InvokeServer()
		end)
		if not ok or not success or typeof(result) ~= "table" then
			Feedback.toast(if ok and typeof(result) == "string" then result else "No se pudo girar", UiKit.Palettes.red)
			return
		end
		local index = result.index :: number
		local base = -((index - 1) * segmentDegrees + segmentDegrees / 2)
		local target = base
		while target < rotation + 360 * EXTRA_TURNS do
			target += 360
		end
		spin = { from = rotation, to = target, elapsed = 0, duration = EconomyConfig.Wheel.SpinSeconds, index = index, title = result.title :: string }
	end

	spinButton.MouseButton1Click:Connect(startSpin)
	hub.MouseButton1Click:Connect(startSpin)
	fishBuy.MouseButton1Click:Connect(function()
		local ok, success, message = pcall(function()
			return EconomyRemotes.WheelSpinPurchaseRequested:InvokeServer()
		end)
		if ok and success then
			Feedback.toast("¡+1 giro! 🎟️", UiKit.Palettes.cyan)
			Feedback.confetti(60)
		else
			Feedback.toast(if ok and typeof(message) == "string" then message else "No se pudo comprar", UiKit.Palettes.red)
		end
	end)
	for _, robuxButton in { robuxOne, robuxTen } do
		robuxButton.MouseButton1Click:Connect(function()
			Feedback.toast("Precios en Robux: próximamente", UiKit.Palettes.purple)
		end)
	end

	table.insert(connections, RunService.RenderStepped:Connect(function(deltaSeconds: number)
		clock += deltaSeconds
		rays.Rotation += deltaSeconds * (if spin then 60 else 18)
		local active = spin
		if active then
			active.elapsed += deltaSeconds
			local progress = math.min(1, active.elapsed / active.duration)
			local eased = 1 - (1 - progress) ^ 4
			rotation = active.from + (active.to - active.from) * eased
			if progress >= 1 then
				spin = nil
				flashSeconds = 2.5
				local prize = prizes[active.index]
				winIcon.Text = prize.icon
				winText.Text = active.title
				win.Visible = true
				Feedback.confetti(if prize.weight <= 2 then 320 else 200)
				WheelPanel.recordWinner("🎉 Tú ganaste " .. active.title)
			end
		end
		disc.Rotation = rotation
		local offset = (rotation % segmentDegrees) / segmentDegrees
		local flap = math.max(0, 1 - math.min(offset, 1 - offset) * 6)
		pointer.Rotation = if spin then -flap * 26 else 0
		flashSeconds = math.max(0, flashSeconds - deltaSeconds)
		local chase = math.floor(clock * (if spin then 22 else 9))
		for index, bulb in bulbs do
			local lit = if flashSeconds > 0 then math.floor(clock * 10) % 2 == 0 else (index + chase) % 4 == 0 or (index + chase) % 4 == 2 and spin ~= nil
			bulb.BackgroundColor3 = if lit then Color3.fromRGB(255, 251, 224) else Color3.fromRGB(194, 122, 0)
		end
		local width = tickerText.AbsoluteSize.X
		local position = tickerText.Position.X.Offset - deltaSeconds * 90
		if position < -width * 0.6 then
			position = ticker.AbsoluteSize.X
			tickerText.Text = table.concat(recentWinners, "   ·   ")
		end
		tickerText.Position = UDim2.new(0, position, 0, 4)
	end))
	table.insert(connections, ProfileStore.Changed:Connect(refreshInfo))
	local refreshing = true
	task.spawn(function()
		while refreshing do
			refreshInfo()
			task.wait(1)
		end
	end)
	tickerText.Position = UDim2.new(0, 400, 0, 4)
	TweenService:Create(rim, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Size = UDim2.fromScale(1, 1) }):Play()
	return function()
		refreshing = false
		for _, connection in connections do
			connection:Disconnect()
		end
	end
end

return WheelPanel
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX43"><Properties><string name="Name">Decoration</string></Properties><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">ChaseLights</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")

local CHASE_TAG = "ChaseBulb"
local STEPS_PER_SECOND = 7
local PATTERN_LENGTH = 3
local ACTIVE_RADIUS = 420

type Bulb = { part: BasePart, index: number }

local bulbs: { [BasePart]: Bulb } = {}
local lastStep = -1

local ChaseLights = {}

local function track(instance: Instance)
	if not instance:IsA("BasePart") or bulbs[instance] then
		return
	end
	local index = instance:GetAttribute("ChaseIndex")
	bulbs[instance] = { part = instance, index = if typeof(index) == "number" then index else math.random(1, PATTERN_LENGTH) }
end

local function untrack(instance: Instance)
	if instance:IsA("BasePart") then
		bulbs[instance] = nil
	end
end

function ChaseLights.init()
	for _, instance in CollectionService:GetTagged(CHASE_TAG) do
		track(instance)
	end
	CollectionService:GetInstanceAddedSignal(CHASE_TAG):Connect(track)
	CollectionService:GetInstanceRemovedSignal(CHASE_TAG):Connect(untrack)
end

function ChaseLights.update(now: number, focus: Vector3)
	local step = math.floor(now * STEPS_PER_SECOND)
	if step == lastStep then
		return
	end
	lastStep = step
	for part, bulb in bulbs do
		if not part.Parent then
			bulbs[part] = nil
		elseif (part.Position - focus).Magnitude < ACTIVE_RADIUS then
			local lit = (bulb.index + step) % PATTERN_LENGTH == 0
			part.Material = if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
			part.Transparency = if lit then 0 else 0.25
		end
	end
end

return ChaseLights
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">CheeringCrowd</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")

local CROWD_TAG = "CheeringPenguin"
local ACTIVE_RADIUS = 380
local FLIPPER_SHOULDER = Vector3.new(1.55, 1.1, 0)
local FLIPPER_ARM_OFFSET = Vector3.new(0.15, -1, 0)
local FLIPPER_REST_ANGLE = 0.18

type Fan = {
	body: BasePart,
	restFrame: CFrame,
	phase: number,
	mode: string,
	leftFlipper: Weld?,
	rightFlipper: Weld?,
}

type Motion = { lift: number, left: number, right: number, tilt: number, lean: number }

local fansByModel: { [Model]: Fan } = {}

local CheeringCrowd = {}

local function flipperOffset(side: number, angle: number): CFrame
	return CFrame.new(side * FLIPPER_SHOULDER.X, FLIPPER_SHOULDER.Y, 0)
		* CFrame.Angles(0, 0, side * angle)
		* CFrame.new(side * FLIPPER_ARM_OFFSET.X, FLIPPER_ARM_OFFSET.Y, 0)
end

local function findWeld(body: BasePart, name: string): Weld?
	local weld = body:FindFirstChild(name)
	return if weld and weld:IsA("Weld") then weld else nil
end

local motions: { [string]: (now: number, phase: number) -> Motion } = {
	cheer = function(now, phase)
		local wave = math.sin(now * 10 + phase)
		return { lift = math.abs(math.sin(now * 5 + phase)) * 1.6, left = math.max(0, wave) * 1.6, right = 0.6 + math.max(0, -wave) * 1.6, tilt = 0, lean = 0 }
	end,
	wave = function(now, phase)
		return { lift = math.abs(math.sin(now * 2 + phase)) * 0.3, left = 0.1, right = 2.3 + math.sin(now * 7 + phase) * 0.5, tilt = math.sin(now * 2 + phase) * 0.06, lean = 0 }
	end,
	drum = function(now, phase)
		local beat = math.sin(now * 12 + phase)
		return { lift = math.abs(math.sin(now * 6 + phase)) * 0.8, left = 0.5 + math.max(0, beat) * 1.2, right = 0.5 + math.max(0, -beat) * 1.2, tilt = 0, lean = 0 }
	end,
	shovel = function(now, phase)
		local stroke = math.sin(now * 3.5 + phase)
		return { lift = 0, left = 0.4 + stroke * 0.4, right = 0.4 + stroke * 0.4, tilt = 0, lean = stroke * 0.18 }
	end,
	music = function(now, phase)
		local squeeze = math.sin(now * 4 + phase)
		return { lift = math.abs(math.sin(now * 3 + phase)) * 0.4, left = 0.9 + squeeze * 0.5, right = 0.9 + squeeze * 0.5, tilt = math.sin(now * 2 + phase) * 0.08, lean = 0 }
	end,
	idle = function(now, phase)
		return { lift = math.abs(math.sin(now * 1.5 + phase)) * 0.15, left = 0, right = 0, tilt = 0, lean = 0 }
	end,
}

local function modeOf(instance: Instance): string
	local mode = instance:GetAttribute("CheerMode")
	if typeof(mode) == "string" and motions[mode] then
		return mode
	end
	return if instance:GetAttribute("Cheers") == false then "idle" else "cheer"
end

local function track(instance: Instance)
	if not instance:IsA("Model") or fansByModel[instance] then
		return
	end
	local body = instance.PrimaryPart
	if not body then
		return
	end
	local phase = instance:GetAttribute("CheerPhase")
	fansByModel[instance] = {
		body = body,
		restFrame = body.CFrame,
		phase = if typeof(phase) == "number" then phase else math.random() * 6,
		mode = modeOf(instance),
		leftFlipper = findWeld(body, "FlipperLeftWeld"),
		rightFlipper = findWeld(body, "FlipperRightWeld"),
	}
end

local function untrack(instance: Instance)
	if instance:IsA("Model") then
		fansByModel[instance] = nil
	end
end

function CheeringCrowd.init()
	for _, instance in CollectionService:GetTagged(CROWD_TAG) do
		track(instance)
	end
	CollectionService:GetInstanceAddedSignal(CROWD_TAG):Connect(track)
	CollectionService:GetInstanceRemovedSignal(CROWD_TAG):Connect(untrack)
end

function CheeringCrowd.update(now: number, focus: Vector3)
	for model, fan in fansByModel do
		if not fan.body.Parent then
			fansByModel[model] = nil
		elseif (fan.restFrame.Position - focus).Magnitude <= ACTIVE_RADIUS then
			local motion = motions[fan.mode](now, fan.phase)
			fan.body.CFrame = fan.restFrame * CFrame.new(0, motion.lift, 0) * CFrame.Angles(motion.lean, 0, motion.tilt)
			local leftFlipper = fan.leftFlipper
			if leftFlipper then
				leftFlipper.C0 = flipperOffset(-1, FLIPPER_REST_ANGLE + motion.left)
			end
			local rightFlipper = fan.rightFlipper
			if rightFlipper then
				rightFlipper.C0 = flipperOffset(1, FLIPPER_REST_ANGLE + motion.right)
			end
		end
	end
end

return CheeringCrowd
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">DecorationController</string><ProtectedString name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ChaseLights = require(script.Parent.ChaseLights)
local CheeringCrowd = require(script.Parent.CheeringCrowd)
local FlameFlicker = require(script.Parent.FlameFlicker)
local ParadeMotion = require(script.Parent.ParadeMotion)
local PulseGlow = require(script.Parent.PulseGlow)
local SpinningDecor = require(script.Parent.SpinningDecor)
local SwingingDecor = require(script.Parent.SwingingDecor)

local DecorationController = {}

function DecorationController.init()
	CheeringCrowd.init()
	FlameFlicker.init()
	SpinningDecor.init()
	ChaseLights.init()
	PulseGlow.init()
	SwingingDecor.init()
	ParadeMotion.init()
	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		local camera = Workspace.CurrentCamera
		local focus = if camera then camera.CFrame.Position else Vector3.zero
		CheeringCrowd.update(now, focus)
		FlameFlicker.update()
		SpinningDecor.update(now, focus)
		ChaseLights.update(now, focus)
		PulseGlow.update(now, focus)
		SwingingDecor.update(now, focus)
		ParadeMotion.update(now, focus)
	end)
end

return DecorationController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">ParadeMotion</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")

local CHEVRON_TAG = "ChevronArrow"
local DRAGON_TAG = "DragonParade"
local ACTIVE_RADIUS = 450
local CHEVRON_LIFT = 0.9
local SEGMENT_SPACING = 0.11

type Chevron = { model: Model, rest: CFrame, index: number, faces: { BasePart } }
type Dragon = { model: Model, segments: { Model }, center: Vector3, radiusX: number, radiusZ: number, speed: number }

local chevrons: { [Model]: Chevron } = {}
local dragons: { [Model]: Dragon } = {}

local ParadeMotion = {}

local function trackChevron(instance: Instance)
	if not instance:IsA("Model") or chevrons[instance] then
		return
	end
	local faces: { BasePart } = {}
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name == "Face" then
			table.insert(faces, descendant)
		end
	end
	local index = instance:GetAttribute("ChevronIndex")
	chevrons[instance] = { model = instance, rest = instance:GetPivot(), index = if typeof(index) == "number" then index else 0, faces = faces }
end

local function trackDragon(instance: Instance)
	if not instance:IsA("Model") or dragons[instance] then
		return
	end
	local segments: { Model } = {}
	for _, child in instance:GetChildren() do
		if child:IsA("Model") and typeof(child:GetAttribute("SegmentIndex")) == "number" then
			table.insert(segments, child)
		end
	end
	table.sort(segments, function(a, b)
		return (a:GetAttribute("SegmentIndex") :: number) < (b:GetAttribute("SegmentIndex") :: number)
	end)
	local center = instance:GetAttribute("PathCenter")
	dragons[instance] = {
		model = instance,
		segments = segments,
		center = if typeof(center) == "Vector3" then center else instance:GetPivot().Position,
		radiusX = (instance:GetAttribute("PathRadiusX") or 6) :: number,
		radiusZ = (instance:GetAttribute("PathRadiusZ") or 120) :: number,
		speed = (instance:GetAttribute("PathSpeed") or 0.35) :: number,
	}
end

local function listen(tag: string, onAdded: (Instance) -> (), registry: { [Model]: any })
	for _, instance in CollectionService:GetTagged(tag) do
		onAdded(instance)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(onAdded)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance: Instance)
		if instance:IsA("Model") then
			registry[instance] = nil
		end
	end)
end

local function pathPoint(dragon: Dragon, angle: number): Vector3
	return dragon.center + Vector3.new(math.cos(angle) * dragon.radiusX, 0, math.sin(angle) * dragon.radiusZ)
end

function ParadeMotion.init()
	listen(CHEVRON_TAG, trackChevron, chevrons)
	listen(DRAGON_TAG, trackDragon, dragons)
end

function ParadeMotion.update(now: number, focus: Vector3)
	for model, chevron in chevrons do
		if not model.Parent then
			chevrons[model] = nil
		elseif (chevron.rest.Position - focus).Magnitude < ACTIVE_RADIUS then
			local wave = math.max(0, math.sin(now * 5 - chevron.index * 0.55))
			model:PivotTo(chevron.rest + Vector3.new(0, wave * CHEVRON_LIFT, 0))
			local lit = wave > 0.55
			for _, face in chevron.faces do
				face.Material = if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
			end
		end
	end
	for model, dragon in dragons do
		if not model.Parent then
			dragons[model] = nil
		elseif (dragon.center - focus).Magnitude < ACTIVE_RADIUS + dragon.radiusZ then
			for index, segment in dragon.segments do
				local angle = now * dragon.speed - index * SEGMENT_SPACING
				local position = pathPoint(dragon, angle)
				local behind = pathPoint(dragon, angle - 0.03)
				local bob = math.abs(math.sin(now * 5 - index * 0.6)) * 1.4
				segment:PivotTo(CFrame.lookAt(position + Vector3.new(0, bob, 0), behind + Vector3.new(0, bob, 0)) * CFrame.Angles(0, math.pi, 0))
			end
		end
	end
end

return ParadeMotion
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">PulseGlow</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")

local PULSE_TAG = "PulseGlow"
local ACTIVE_RADIUS = 400

type Glow = { part: BasePart, phase: number, light: PointLight?, baseBrightness: number }

local glows: { [BasePart]: Glow } = {}

local PulseGlow = {}

local function track(instance: Instance)
	if not instance:IsA("BasePart") or glows[instance] then
		return
	end
	local light = instance:FindFirstChildOfClass("PointLight")
	glows[instance] = { part = instance, phase = math.random() * 6, light = light, baseBrightness = if light then light.Brightness else 0 }
end

function PulseGlow.init()
	for _, instance in CollectionService:GetTagged(PULSE_TAG) do
		track(instance)
	end
	CollectionService:GetInstanceAddedSignal(PULSE_TAG):Connect(track)
	CollectionService:GetInstanceRemovedSignal(PULSE_TAG):Connect(function(instance: Instance)
		if instance:IsA("BasePart") then
			glows[instance] = nil
		end
	end)
end

function PulseGlow.update(now: number, focus: Vector3)
	for part, glow in glows do
		if not part.Parent then
			glows[part] = nil
		elseif (part.Position - focus).Magnitude < ACTIVE_RADIUS then
			local wave = 0.5 + 0.5 * math.sin(now * 4 + glow.phase)
			part.Transparency = 0.35 * (1 - wave)
			local light = glow.light
			if light then
				light.Brightness = glow.baseBrightness * (0.4 + wave * 0.9)
			end
		end
	end
end

return PulseGlow
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">SpinningDecor</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")

local SPIN_TAG = "SpinningDecor"
local DEFAULT_SPIN_SPEED = 0.5
local ACTIVE_RADIUS = 600

type Spinner = {
	restPivot: CFrame,
	speed: number,
	axis: string,
}

local spinnersByModel: { [Model]: Spinner } = {}

local SpinningDecor = {}

local function track(instance: Instance)
	if not instance:IsA("Model") or spinnersByModel[instance] then
		return
	end
	local speed = instance:GetAttribute("SpinSpeed")
	local axis = instance:GetAttribute("SpinAxis")
	spinnersByModel[instance] = {
		restPivot = instance:GetPivot(),
		speed = if typeof(speed) == "number" then speed else DEFAULT_SPIN_SPEED,
		axis = if typeof(axis) == "string" then axis else "Y",
	}
end

local function untrack(instance: Instance)
	if instance:IsA("Model") then
		spinnersByModel[instance] = nil
	end
end

local function rotation(axis: string, angle: number): CFrame
	if axis == "Z" then
		return CFrame.Angles(0, 0, angle)
	elseif axis == "X" then
		return CFrame.Angles(angle, 0, 0)
	end
	return CFrame.Angles(0, angle, 0)
end

function SpinningDecor.init()
	for _, instance in CollectionService:GetTagged(SPIN_TAG) do
		track(instance)
	end
	CollectionService:GetInstanceAddedSignal(SPIN_TAG):Connect(track)
	CollectionService:GetInstanceRemovedSignal(SPIN_TAG):Connect(untrack)
end

function SpinningDecor.update(now: number, focus: Vector3?)
	for model, spinner in spinnersByModel do
		if not model.Parent then
			spinnersByModel[model] = nil
		elseif focus == nil or (spinner.restPivot.Position - focus).Magnitude < ACTIVE_RADIUS then
			model:PivotTo(spinner.restPivot * rotation(spinner.axis, now * spinner.speed))
		end
	end
end

return SpinningDecor
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">SwingingDecor</string><ProtectedString name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")

local SWING_TAG = "SwingingDecor"
local SKY_TAG = "SkyLantern"
local ACTIVE_RADIUS = 450
local DEFAULT_AMPLITUDE = 0.12

type Swinger = { model: Model, rest: CFrame, phase: number, amplitude: number }
type SkyLantern = { model: Model, rest: CFrame, phase: number, height: number, speed: number }

local swingers: { [Model]: Swinger } = {}
local lanterns: { [Model]: SkyLantern } = {}

local SwingingDecor = {}

local function trackSwinger(instance: Instance)
	if not instance:IsA("Model") or swingers[instance] then
		return
	end
	local amplitude = instance:GetAttribute("SwingAmplitude")
	swingers[instance] = { model = instance, rest = instance:GetPivot(), phase = math.random() * 6, amplitude = if typeof(amplitude) == "number" then amplitude else DEFAULT_AMPLITUDE }
end

local function trackLantern(instance: Instance)
	if not instance:IsA("Model") or lanterns[instance] then
		return
	end
	local height = instance:GetAttribute("RiseHeight")
	local speed = instance:GetAttribute("RiseSpeed")
	lanterns[instance] = {
		model = instance,
		rest = instance:GetPivot(),
		phase = math.random() * 100,
		height = if typeof(height) == "number" then height else 160,
		speed = if typeof(speed) == "number" then speed else 6,
	}
end

local function listen(tag: string, onAdded: (Instance) -> (), registry: { [Model]: any })
	for _, instance in CollectionService:GetTagged(tag) do
		onAdded(instance)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(onAdded)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance: Instance)
		if instance:IsA("Model") then
			registry[instance] = nil
		end
	end)
end

function SwingingDecor.init()
	listen(SWING_TAG, trackSwinger, swingers)
	listen(SKY_TAG, trackLantern, lanterns)
end

function SwingingDecor.update(now: number, focus: Vector3)
	for model, swinger in swingers do
		if not model.Parent then
			swingers[model] = nil
		elseif (swinger.rest.Position - focus).Magnitude < ACTIVE_RADIUS then
			local swing = math.sin(now * 1.3 + swinger.phase) * swinger.amplitude
			local sway = math.cos(now * 1.1 + swinger.phase) * swinger.amplitude * 0.5
			model:PivotTo(swinger.rest * CFrame.Angles(sway, 0, swing))
		end
	end
	for model, lantern in lanterns do
		if not model.Parent then
			lanterns[model] = nil
		elseif (lantern.rest.Position - focus).Magnitude < ACTIVE_RADIUS + lantern.height then
			local rise = (now * lantern.speed + lantern.phase) % lantern.height
			local drift = Vector3.new(math.sin(now * 0.4 + lantern.phase) * 4, rise, -rise * 0.3)
			model:PivotTo(lantern.rest + drift)
		end
	end
end

return SwingingDecor
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX44"><Properties><string name="Name">Build</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">BuildLobby</string><ProtectedString name="Source"><![CDATA[return function()
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local SkinAppearance = require(ReplicatedStorage.Shared.SkinAppearance)
local WheelCatalog = require(ReplicatedStorage.Shared.WheelCatalog)

local LEVEL_ONE = workspace:FindFirstChild("PenguinSlingshotMap_v01")
local FOLDER_NAME = "Lobby"
local TOP = 600
local V = Vector3.new
local M = Enum.Material
local rgb = Color3.fromRGB
local INK = rgb(20, 24, 42)
local BULBS = { rgb(255, 59, 92), rgb(255, 210, 63), rgb(63, 208, 255), rgb(125, 255, 122), rgb(255, 122, 224) }

local existing = LEVEL_ONE:FindFirstChild(FOLDER_NAME)
if existing then existing:Destroy() end
local root = Instance.new("Folder")
root.Name = FOLDER_NAME
root.Parent = LEVEL_ONE

local function folder(name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = root
	return f
end

local function model(name, parent)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function part(parent, name, size, cframe, color, options)
	options = options or {}
	local p = Instance.new(options.className or "Part")
	p.Name = name
	p.Anchored = true
	if options.shape then p.Shape = options.shape end
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = options.material or M.Plastic
	local smooth = options.material == M.Neon or options.smooth
	p.TopSurface = smooth and Enum.SurfaceType.Smooth or Enum.SurfaceType.Studs
	p.BottomSurface = smooth and Enum.SurfaceType.Smooth or Enum.SurfaceType.Inlet
	if options.transparency then p.Transparency = options.transparency end
	if options.decor then
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
	end
	if options.noShadow then p.CastShadow = false end
	p.Parent = parent
	return p
end

local function neon(parent, name, size, cframe, color, shape)
	return part(parent, name, size, cframe, color, { material = M.Neon, decor = true, noShadow = true, shape = shape })
end

local function sign(parent, name, size, cframe, text, background, textColor, strokeColor, options)
	options = options or {}
	local board = part(parent, name, size, cframe, background, { smooth = true, decor = options.decor })
	for _, face in ipairs(options.bothSides and { Enum.NormalId.Front, Enum.NormalId.Back } or { Enum.NormalId.Front }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 24
		gui.LightInfluence = 0
		gui.Brightness = 1.3
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(0.94, 0.86)
		label.Position = UDim2.fromScale(0.03, 0.07)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = textColor
		label.Text = text
		local stroke = Instance.new("UIStroke")
		stroke.Color = strokeColor or INK
		stroke.Thickness = 4
		stroke.Parent = label
		label.Parent = gui
	end
	return board
end

local function prompt(anchor, panel, actionText, objectText, distance)
	local proximity = Instance.new("ProximityPrompt")
	proximity.ActionText = actionText
	proximity.ObjectText = objectText
	proximity.KeyboardKeyCode = Enum.KeyCode.E
	proximity.MaxActivationDistance = distance or 18
	proximity.RequiresLineOfSight = false
	proximity.HoldDuration = 0
	proximity:SetAttribute("OpensPanel", panel)
	proximity.Parent = anchor
	return proximity
end

local function bulb(parent, position, index, size)
	local b = neon(parent, "Bulb", V(size or 1, size or 1, size or 1), CFrame.new(position), BULBS[index % #BULBS + 1], Enum.PartType.Ball)
	b:SetAttribute("ChaseIndex", index)
	CollectionService:AddTag(b, "ChaseBulb")
	return b
end

local function triangle(parent, a, b, c, color, thickness, material)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab).Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	local w1 = part(parent, "Segment", V(thickness, height, math.abs(ab:Dot(back))), CFrame.fromMatrix((a + b) / 2, right, up, back), color, { className = "WedgePart", material = material, smooth = true, decor = true })
	local w2 = part(parent, "Segment", V(thickness, height, math.abs(ac:Dot(back))), CFrame.fromMatrix((a + c) / 2, -right, up, -back), color, { className = "WedgePart", material = material, smooth = true, decor = true })
	return w1, w2
end

local function mannequin(parent, skinId, cframe, scale, rank)
	local template = StarterPlayer:FindFirstChild("StarterCharacter")
	local copy = template:Clone()
	copy.Name = "Mannequin"
	local humanoid = copy:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid:Destroy() end
	for _, descendant in ipairs(copy:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
		end
	end
	copy.PrimaryPart = copy:FindFirstChild("HumanoidRootPart")
	copy:PivotTo(CFrame.new(0, 1.7, 0))
	copy.Parent = parent
	SkinAppearance.apply(copy, skinId)
	for _, descendant in ipairs(copy:GetDescendants()) do
		if descendant:IsA("BasePart") then descendant.Anchored = true end
	end
	copy:ScaleTo(scale)
	copy:PivotTo(cframe * CFrame.new(0, 1.7 * scale, 0))
	if rank then
		copy:SetAttribute("Rank", rank)
		CollectionService:AddTag(copy, "PodiumMannequin")
	end
	return copy
end

local function nameTag(target, text, color, offset)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "NameTag"
	billboard.Size = UDim2.new(9, 0, 1.8, 0)
	billboard.StudsOffsetWorldSpace = offset or V(0, 6, 0)
	billboard.MaxDistance = 120
	billboard.LightInfluence = 0
	billboard.Parent = target
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = INK
	stroke.Parent = label
	label.Parent = billboard
	return billboard
end

local function wheelLabel(parent, origin, look, d, prize, radius)
	local function surface(name, size, frame)
		local holder = Instance.new("Part")
		holder.Name = name
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.Transparency = 1
		holder.Size = size
		holder.CFrame = frame
		holder.Parent = parent
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0
		gui.Parent = holder
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Parent = gui
		return label
	end
	local icon = surface("LabelIcon", Vector3.new(2.6, 2.6, 0.1), CFrame.fromMatrix(origin + d * radius * 0.8 + look * 0.3, look:Cross(d), d))
	icon.Text = prize.icon
	local reading = if d:Dot(look:Cross(Vector3.yAxis)) < -0.01 then -d else d
	local text = surface("LabelText", Vector3.new(radius * 0.36, radius * 0.13, 0.1), CFrame.fromMatrix(origin + d * radius * 0.5 + look * 0.3, reading, reading:Cross(look)))
	text.Text = prize.label
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.TextColor3 = if prize.amount >= 10000 then Color3.fromRGB(255, 227, 110) else Color3.fromRGB(255, 255, 255)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(20, 24, 42)
	stroke.Parent = text
end

-- Chevron road from the spawn to the slingshot
do
	local road = folder("ChevronRoad")
	local zStart, zEnd = 98, 34
	local length = zStart - zEnd
	part(road, "Road", V(10, 0.4, length + 6), CFrame.new(0, TOP + 0.2, (zStart + zEnd) / 2), rgb(61, 75, 112))
	for _, side in ipairs({ -1, 1 }) do
		part(road, "RoadEdge", V(0.7, 0.5, length + 6), CFrame.new(side * 5.3, TOP + 0.25, (zStart + zEnd) / 2), rgb(255, 210, 31), { smooth = true })
	end
	local index = 0
	for z = zStart - 2, zEnd + 2, -5.5 do
		index += 1
		local chevron = model("ChevronArrow", road)
		local base = CFrame.new(0, TOP + 0.6, z) * CFrame.Angles(0, 0, 0)
		for _, side in ipairs({ -1, 1 }) do
			local arm = base * CFrame.new(side * 1.25, 0, 0.25) * CFrame.Angles(0, -side * 0.785, 0)
			part(chevron, "Back", V(4.4, 0.35, 1.4), arm, INK, { smooth = true, decor = true })
			part(chevron, "Face", V(4.0, 0.45, 1.0), arm * CFrame.new(0, 0.12, 0), rgb(255, 255, 255), { smooth = true, decor = true, noShadow = true })
		end
		chevron:SetAttribute("ChevronIndex", index)
		CollectionService:AddTag(chevron, "ChevronArrow")
	end
	sign(road, "RoadSign", V(16, 4, 0.6), CFrame.new(0, TOP + 9, 100) * CFrame.Angles(0, math.pi, 0), "¡CAMINA A LA RESORTERA!", rgb(255, 210, 31), rgb(255, 255, 255), INK, { bothSides = true })
	for _, side in ipairs({ -1, 1 }) do
		part(road, "SignPost", V(0.8, 9, 0.8), CFrame.new(side * 7.5, TOP + 4.5, 100), rgb(107, 66, 40), { smooth = true })
	end
end

-- Lucky wheel
do
	local wheelFolder = folder("LuckyWheel")
	local wheel = model("LobbyWheel", wheelFolder)
	local center = V(-92, TOP, 72)
	local facing = CFrame.lookAlong(center, V(1, 0, 0))
	local hubHeight = 21
	local radius = 13
	local hubFrame = facing * CFrame.new(0, hubHeight, 0)
	local basePart = part(wheel, "Base", V(2.4, 26, 26), CFrame.new(center + V(0, 1.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), rgb(59, 42, 138), { shape = Enum.PartType.Cylinder, smooth = true })
	part(wheel, "BaseTop", V(2, 20, 20), CFrame.new(center + V(0, 3.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), rgb(90, 63, 208), { shape = Enum.PartType.Cylinder, smooth = true })
	part(wheel, "BaseGold", V(1.6, 15, 15), CFrame.new(center + V(0, 4.8, 0)) * CFrame.Angles(0, 0, math.pi / 2), rgb(255, 194, 26), { shape = Enum.PartType.Cylinder, material = M.Metal, smooth = true })
	local bulbs = Instance.new("Folder")
	bulbs.Name = "Bulbs"
	bulbs.Parent = wheel
	for index = 0, 31 do
		local angle = index / 32 * math.pi * 2
		bulb(wheelFolder, center + V(math.cos(angle) * 12.6, 2.6, math.sin(angle) * 12.6), index, 0.8)
	end
	for _, side in ipairs({ -1, 1 }) do
		local pillarBase = facing * CFrame.new(side * 17, 0, 0.8)
		for segment = 0, 21 do
			part(wheel, "CandyStripe", V(1.6, 1.6, 3.2), pillarBase * CFrame.new(0, 2 + segment * 1.6, 0) * CFrame.Angles(0, 0, math.pi / 2), segment % 2 == 0 and rgb(255, 255, 255) or rgb(232, 32, 46), { shape = Enum.PartType.Cylinder, smooth = true })
		end
		part(wheel, "PillarTop", V(5, 5, 5), pillarBase * CFrame.new(0, 38.4, 0), rgb(255, 210, 63), { shape = Enum.PartType.Ball, material = M.Metal, smooth = true })
		local star = model("PillarStar", wheelFolder)
		neon(star, "Star", V(2.6, 2.6, 2.6), pillarBase * CFrame.new(0, 42.6, 0) * CFrame.Angles(0, 0, math.pi / 4), rgb(255, 227, 110))
		star:SetAttribute("SpinSpeed", 2 * side)
		CollectionService:AddTag(star, "SpinningDecor")
	end
	part(wheel, "BackPost", V(4, hubHeight, 3), facing * CFrame.new(0, hubHeight / 2 + 1, 3), rgb(59, 42, 138))
	part(wheel, "BackPlate", V(1.2, 29, 29), hubFrame * CFrame.new(0, 0, 1.6) * CFrame.Angles(0, math.pi / 2, 0), INK, { shape = Enum.PartType.Cylinder, smooth = true })
	for index = 0, 47 do
		local a0 = index / 48 * math.pi * 2
		local mid = hubFrame * CFrame.Angles(0, 0, a0 + math.pi / 48) * CFrame.new(0, radius + 1.2, 0.2)
		part(wheel, "Rim", V(1.9, 1.6, 1.8), mid, rgb(255, 194, 26), { material = M.Metal, smooth = true, decor = true })
	end
	for index = 0, 39 do
		local angle = index / 40 * math.pi * 2
		local b = neon(bulbs, "RimBulb", V(0.8, 0.8, 0.8), hubFrame * CFrame.new(math.cos(angle) * (radius + 1.2), math.sin(angle) * (radius + 1.2), -0.9), rgb(194, 122, 0), Enum.PartType.Ball)
		b:SetAttribute("ChaseIndex", index)
	end
	local disc = model("Disc", wheel)
	local discCenter = hubFrame * CFrame.new(0, 0, -0.3)
	local prizes = WheelCatalog.list()
	local step = 360 / #prizes
	local function direction(degrees)
		local theta = math.rad(degrees)
		return discCenter.UpVector * math.cos(theta) - discCenter.RightVector * math.sin(theta)
	end
	for index, prize in ipairs(prizes) do
		local startDegrees = (index - 1) * step
		local origin = discCenter.Position
		for half = 0, 1 do
			local a = startDegrees + half * step / 2
			local b = a + step / 2
			triangle(disc, origin, origin + direction(a) * radius, origin + direction(b) * radius, prize.color, 0.4, M.SmoothPlastic)
		end
		local centerDirection = direction(startDegrees + step / 2)
		wheelLabel(disc, origin, discCenter.LookVector, centerDirection, prize, radius)
		local divider = direction(startDegrees)
		part(disc, "Divider", V(0.35, radius, 0.5), CFrame.fromMatrix(origin + divider * radius / 2 + discCenter.LookVector * 0.25, discCenter.LookVector:Cross(divider), divider), rgb(255, 255, 255), { smooth = true, decor = true })
		part(disc, "Peg", V(0.7, 0.7, 1.2), CFrame.new(origin + divider * (radius - 0.6) + discCenter.LookVector * 0.5), rgb(255, 210, 63), { shape = Enum.PartType.Ball, material = M.Metal, decor = true })
	end
	part(disc, "Hub", V(1.4, 5.6, 5.6), discCenter * CFrame.new(0, 0, -0.6) * CFrame.Angles(0, math.pi / 2, 0), rgb(255, 59, 59), { shape = Enum.PartType.Cylinder, smooth = true, decor = true })
	sign(disc, "HubLabel", V(4, 2, 0.1), discCenter * CFrame.new(0, 0, -1.35), "GIRA", rgb(255, 59, 59), rgb(255, 255, 255), INK, { decor = true })
	disc.PrimaryPart = nil
	disc.WorldPivot = discCenter
	local pointer = model("Pointer", wheel)
	local hinge = hubFrame * CFrame.new(0, radius + 3.4, -1.2)
	part(pointer, "PointerBody", V(1, 3.6, 2.4), hinge * CFrame.new(0, -1.4, 0) * CFrame.Angles(0, math.pi / 2, 0), rgb(255, 59, 59), { className = "WedgePart", smooth = true, decor = true })
	part(pointer, "PointerCap", V(1.4, 1.4, 1.4), hinge, rgb(255, 210, 63), { shape = Enum.PartType.Ball, material = M.Metal, decor = true })
	pointer.WorldPivot = hinge
	local topSign = sign(wheel, "WheelSign", V(34, 7, 1), hubFrame * CFrame.new(0, radius + 13, 0.5), "RULETA DE LA SUERTE", rgb(26, 18, 64), rgb(255, 227, 110), rgb(255, 79, 163))
	for index = 0, 23 do
		local x = -16 + index * (32 / 23)
		local b = bulb(wheelFolder, (hubFrame * CFrame.new(x, radius + 17, -0.2)).Position, index, 0.7)
		b.Name = "SignBulb"
	end
	local banner = part(wheel, "BannerAnchor", V(1, 1, 1), hubFrame * CFrame.new(0, radius + 6, -6), rgb(255, 255, 255), { transparency = 1, decor = true })
	local rays = part(wheel, "Glow", V(0.2, 40, 40), hubFrame * CFrame.new(0, 0, 2.4) * CFrame.Angles(0, math.pi / 2, 0), rgb(255, 210, 63), { shape = Enum.PartType.Cylinder, material = M.Neon, decor = true, transparency = 0.7, noShadow = true })
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 214, 120)
	light.Brightness = 2
	light.Range = 40
	light.Parent = rays
	prompt(basePart, "wheel", "Girar", "Ruleta de la suerte", 26)
	wheel:SetAttribute("SegmentCount", #prizes)
	CollectionService:AddTag(wheel, "LobbyWheel")
	local _ = topSign
	local _ = banner
end

-- Hall of fame leaderboard
do
	local hall = folder("HallOfFame")
	local board = model("LobbyLeaderboard", hall)
	local width, height, bottom = 40, 26.7, 14
	local frame = CFrame.lookAlong(V(100, TOP + bottom + height / 2, 62), V(-1, 0, 0))
	part(board, "Frame", V(width + 3, height + 3, 1.6), frame * CFrame.new(0, 0, 1), INK, { smooth = true })
	local screen = part(board, "Screen", V(width, height, 0.4), frame * CFrame.new(0, 0, 0), rgb(18, 12, 58), { smooth = true, decor = true })
	local _ = screen
	for _, edge in ipairs({ { 0, height / 2 + 1.2, width + 2.4, 0.7, rgb(255, 79, 163) }, { 0, -height / 2 - 1.2, width + 2.4, 0.7, rgb(255, 79, 163) }, { -width / 2 - 1.2, 0, 0.7, height + 2.9, rgb(63, 208, 255) }, { width / 2 + 1.2, 0, 0.7, height + 2.9, rgb(63, 208, 255) } }) do
		local n = neon(board, "Neon", V(edge[3], edge[4], 0.7), frame * CFrame.new(edge[1], edge[2], -0.3), edge[5])
		CollectionService:AddTag(n, "PulseGlow")
	end
	for index = 0, 31 do
		local x = -width / 2 + index * (width / 31)
		bulb(hall, (frame * CFrame.new(x, height / 2 + 2.6, -0.3)).Position, index, 0.8)
		bulb(hall, (frame * CFrame.new(x, -height / 2 - 2.6, -0.3)).Position, index + 2, 0.8)
	end
	for _, side in ipairs({ -1, 1 }) do
		part(board, "Leg", V(3.4, bottom, 3.4), frame * CFrame.new(side * (width / 2 - 6), -height / 2 - bottom / 2, 1), rgb(59, 42, 138))
	end
	sign(board, "HallSign", V(28, 6, 1), frame * CFrame.new(0, height / 2 + 7.4, 0.4), "SALÓN DE LA FAMA", INK, rgb(255, 227, 110), rgb(255, 79, 163))
	local crown = model("Crown", hall)
	local crownBase = frame * CFrame.new(0, height / 2 + 15, 0)
	part(crown, "Band", V(6.4, 1.6, 6.4), crownBase, rgb(255, 194, 26), { material = M.Metal, decor = true, smooth = true })
	for index = 0, 4 do
		local angle = index / 5 * math.pi * 2
		part(crown, "Spike", V(1.4, 2.6, 1.4), crownBase * CFrame.new(math.cos(angle) * 2.6, 1.9, math.sin(angle) * 2.6), rgb(255, 194, 26), { material = M.Metal, decor = true, smooth = true })
		neon(crown, "Jewel", V(0.9, 0.9, 0.9), crownBase * CFrame.new(math.cos(angle) * 3.25, 0, math.sin(angle) * 3.25), BULBS[index + 1], Enum.PartType.Ball)
	end
	crown:SetAttribute("SpinSpeed", 0.8)
	CollectionService:AddTag(crown, "SpinningDecor")
	local podium = model("Podium", hall)
	local podiumFrame = frame * CFrame.new(0, -height / 2 - bottom, -14)
	for rank, step in ipairs({ { 0, 6, rgb(255, 194, 26) }, { -10, 4.4, rgb(200, 210, 222) }, { 10, 3, rgb(208, 138, 74) } }) do
		local stepFrame = podiumFrame * CFrame.new(step[1], step[2] / 2, 0)
		local block = part(podium, "Step" .. rank, V(9, step[2], 9), stepFrame, step[3], { material = M.Metal })
		sign(podium, "Number", V(3.4, 3, 0.2), stepFrame * CFrame.new(0, 0, -4.6), tostring(rank), step[3], rgb(255, 255, 255), INK, { decor = true })
		local figure = mannequin(podium, "classic", podiumFrame * CFrame.new(step[1], step[2], 0), rank == 1 and 2.6 or 2.2, rank)
		nameTag(figure, "¿Serás tú?", rank == 1 and rgb(255, 227, 110) or rgb(255, 255, 255), V(0, rank == 1 and 9 or 7.5, 0))
		local _ = block
	end
	local promptAnchor = part(hall, "PromptAnchor", V(2, 2, 2), podiumFrame * CFrame.new(0, 3, -8), rgb(255, 255, 255), { transparency = 1, decor = true })
	prompt(promptAnchor, "leaderboard", "Ver tabla", "Salón de la fama", 22)
	for _, side in ipairs({ -1, 1 }) do
		local beam = part(hall, "LightBeam", V(60, 10, 10), frame * CFrame.new(side * (width / 2 + 4), 10, -6) * CFrame.Angles(0, 0, math.pi / 2 + side * 0.25), side < 0 and rgb(255, 111, 216) or rgb(94, 225, 255), { shape = Enum.PartType.Cylinder, material = M.Neon, decor = true, transparency = 0.85, noShadow = true })
		local _ = beam
	end
	CollectionService:AddTag(board, "LobbyLeaderboard")
end

