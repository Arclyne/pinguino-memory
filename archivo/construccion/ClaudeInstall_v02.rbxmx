local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:WaitForChild("Remotes")

return {
	ProfileChanged = folder:WaitForChild("ProfileChanged") :: RemoteEvent,
	ProfileRequested = folder:WaitForChild("ProfileRequested") :: RemoteFunction,
	SkinPurchaseRequested = folder:WaitForChild("SkinPurchaseRequested") :: RemoteFunction,
	SkinEquipRequested = folder:WaitForChild("SkinEquipRequested") :: RemoteFunction,
	WheelSpinRequested = folder:WaitForChild("WheelSpinRequested") :: RemoteFunction,
	WheelSpinPurchaseRequested = folder:WaitForChild("WheelSpinPurchaseRequested") :: RemoteFunction,
	BoostPurchaseRequested = folder:WaitForChild("BoostPurchaseRequested") :: RemoteFunction,
	DailyGiftClaimRequested = folder:WaitForChild("DailyGiftClaimRequested") :: RemoteFunction,
	LevelTravelRequested = folder:WaitForChild("LevelTravelRequested") :: RemoteFunction,
	LaunchPadRequested = folder:WaitForChild("LaunchPadRequested") :: RemoteFunction,
	FishCollectRequested = folder:WaitForChild("FishCollectRequested") :: RemoteEvent,
	WheelSpun = folder:WaitForChild("WheelSpun") :: RemoteEvent,
	LeaderboardChanged = folder:WaitForChild("LeaderboardChanged") :: RemoteEvent,
	LeaderboardRequested = folder:WaitForChild("LeaderboardRequested") :: RemoteFunction,
}
